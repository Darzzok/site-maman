---
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../data/site';
import { clampText } from '../utils/seo';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  noindex?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  jsonLd?: object;
  /** Image de partage (URL absolue ou chemin), 1200×630 conseillé */
  image?: string;
  /** Type Open Graph : "website" ou "article" */
  ogType?: string;
  /** Barre d'actions en bas d'écran sur mobile (désactivée sur les articles, pour lire tranquillement) */
  mobileBar?: boolean;
  /** Bandeau cookies ouvert automatiquement à la première visite (désactivé sur le diagnostic) */
  cookieAutoShow?: boolean;
}

const { home = false, noindex = false, ogTitle, ogDescription, jsonLd, image, ogType = 'website', mobileBar = true, cookieAutoShow = true } = Astro.props;
// Google affiche environ 60 caractères de titre et 155 de description :
// au-delà, on retire le nom du site du titre et on coupe proprement la description.
const brandSuffix = ` | ${site.name}`;
const title =
  Astro.props.title.length > 65 && Astro.props.title.endsWith(brandSuffix)
    ? Astro.props.title.slice(0, -brandSuffix.length)
    : Astro.props.title;
const description = clampText(Astro.props.description, 158);
const canonical = new URL(Astro.url.pathname === '/index.html' ? '/' : Astro.url.pathname, site.url).href;
const ogImage = new URL(image ?? '/images/og-image.jpg', site.url).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#61193a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.owner} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Polices du site (libres de droits), préchargées pour un affichage immédiat -->
    <link rel="preload" href="/fonts/playfair-display-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.owner}, gestion administrative en Normandie`} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Active les animations uniquement si JavaScript est disponible -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#contenu" class="skip-link">Aller au contenu principal</a>

    <Header home={home} />

    <main id="contenu">
      <slot />
    </main>

    <Footer home={home} />

    <CookieBanner autoShow={cookieAutoShow} />

    <!-- Mobile : actions principales toujours à portée de pouce -->
    {mobileBar && (
    <nav class="mobile-bar" aria-label="Actions rapides" data-mobile-bar>
      <a href={home ? '#devis' : '/#devis'} class="mb-btn mb-btn--ghost">
        <Icon name="file" size={18} /> Devis gratuit
      </a>
      <a href={home ? '#rendez-vous' : '/#rendez-vous'} class="mb-btn">
        <Icon name="calendar" size={18} /> Rendez-vous
      </a>
    </nav>
    )}

    <button type="button" class="to-top" aria-label="Retour en haut de page" data-back-to-top>
      <svg class="to-top-ring" viewBox="0 0 48 48" aria-hidden="true">
        <circle cx="24" cy="24" r="22" pathLength="100"></circle>
        <circle class="progress" cx="24" cy="24" r="22" pathLength="100"></circle>
      </svg>
      <Icon name="arrowUp" size={18} strokeWidth={2.2} />
    </button>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>

<style>
  .to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    color: #fff;
    background: var(--blue-700);
    box-shadow: 0 14px 30px -12px rgb(97 25 58 / 0.7);
    opacity: 0;
    visibility: hidden;
    translate: 0 16px;
    scale: 0.8;
    transition:
      opacity 0.4s,
      translate 0.5s var(--ease-out),
      scale 0.5s var(--ease-spring),
      visibility 0s linear 0.5s,
      background 0.3s;
  }
  .to-top:global(.is-visible) {
    opacity: 1;
    visibility: visible;
    translate: none;
    scale: 1;
    transition-delay: 0s;
  }
  .to-top:hover {
    background: var(--blue-800);
    scale: 1.08;
  }
  .to-top :global(svg:not(.to-top-ring)) {
    transition: translate 0.4s var(--ease-out);
  }
  .to-top:hover :global(svg:not(.to-top-ring)) {
    translate: 0 -2px;
  }
  .to-top-ring {
    position: absolute;
    inset: -3px;
    width: calc(100% + 6px);
    height: calc(100% + 6px);
    rotate: -90deg;
    fill: none;
    stroke-width: 2.5;
  }
  .to-top-ring circle {
    stroke: rgb(255 255 255 / 0);
  }
  .to-top-ring .progress {
    stroke: var(--terra-400);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: calc(100 - var(--progress, 0) * 100);
  }

  /* ============ Barre d'actions mobile ============ */
  .mobile-bar {
    display: none;
  }
  @media (max-width: 760px) {
    .mobile-bar {
      position: fixed;
      left: 0.75rem;
      right: 0.75rem;
      bottom: calc(0.75rem + env(safe-area-inset-bottom));
      z-index: 60;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.4rem;
      padding: 0.4rem;
      border-radius: 999px;
      background: rgb(255 255 255 / 0.92);
      border: 1px solid rgb(97 25 58 / 0.1);
      box-shadow: 0 16px 36px -14px rgb(42 9 22 / 0.45);
      backdrop-filter: blur(14px) saturate(1.4);
      -webkit-backdrop-filter: blur(14px) saturate(1.4);
      opacity: 0;
      visibility: hidden;
      translate: 0 120%;
      transition:
        translate 0.45s var(--ease-out),
        opacity 0.3s,
        visibility 0.45s;
    }
    .mobile-bar:global(.is-visible) {
      opacity: 1;
      visibility: visible;
      translate: none;
    }
    .mb-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      min-height: 46px;
      border-radius: 999px;
      font-size: 0.92rem;
      font-weight: 700;
      color: #fff;
      background: linear-gradient(135deg, var(--blue-600), var(--blue-800));
    }
    .mb-btn--ghost {
      color: var(--blue-700);
      background: var(--blue-50);
    }
    .mb-btn:active {
      scale: 0.97;
    }
    /* Le bouton « retour en haut » remonte au-dessus de la barre */
    .to-top {
      transition:
        opacity 0.4s,
        visibility 0.4s,
        translate 0.45s var(--ease-out),
        bottom 0.45s var(--ease-out),
        background 0.3s,
        scale 0.3s;
    }
    :global(body.has-mobile-bar) .to-top {
      bottom: calc(5.1rem + env(safe-area-inset-bottom));
    }
  }
</style>
