---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;

const base = home ? '' : '/';
const linkFor = (item: { id?: string; href?: string }) => item.href ?? `${base}#${item.id}`;
const isCurrent = (item: { href?: string }) => !!item.href && Astro.url.pathname.replace(/\.html$/, '') === item.href.replace(/\.html$/, '');
---

<header class="site-header" data-header>
  <div class="bar-wrap">
    <div class="bar">
      <a href={home ? '#accueil' : '/'} class="brand" aria-label={`${site.name} — retour à l’accueil`}>
        <img src="/images/logo-mark.png" alt="" width="600" height="205" class="brand-mark" />
        <span class="brand-text">
          <span class="brand-name">{site.shortName}</span>
          <span class="brand-sub">{site.tagline}</span>
        </span>
      </a>

      <nav class="nav" aria-label="Navigation principale">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={linkFor(item)}
                  class:list={['nav-link', { 'is-active': isCurrent(item) }]}
                  data-nav={item.id}
                  aria-current={isCurrent(item) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="bar-actions">
        <a href={`${base}#rendez-vous`} class="btn btn--sm header-cta">
          Prendre rendez-vous
        </a>
        <button
          class="burger"
          type="button"
          aria-label="Ouvrir le menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
        >
          <span></span><span></span>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" data-mobile-menu inert>
    <nav aria-label="Navigation mobile">
      <ul>
        {
          nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={linkFor(item)} data-mobile-link>
                {item.label}
              </a>
            </li>
          ))
        }
        <li style={`--i:${nav.length}`}>
          <a href={`${base}#contact`} data-mobile-link>
            Contact
          </a>
        </li>
      </ul>
    </nav>
    <div class="mobile-foot" style={`--i:${nav.length + 1}`}>
      <a href={`${base}#rendez-vous`} class="btn" data-mobile-link>
        Prendre rendez-vous <Icon name="arrowRight" size={18} class="i-arrow" />
      </a>
      <a href={`mailto:${site.email}`} class="mobile-mail">
        <Icon name="mail" size={18} />
        {site.emailLabel}
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    pointer-events: none;
    transition: translate 0.5s var(--ease-out);
  }
  .site-header.is-hidden {
    translate: 0 -120%;
  }
  .bar-wrap {
    padding: 0.9rem 1rem 0;
    transition: padding 0.5s var(--ease-out);
  }
  .bar {
    pointer-events: auto;
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: min(100%, 1240px);
    margin-inline: auto;
    padding: 0.6rem 0.6rem 0.6rem 1.1rem;
    border-radius: 999px;
    border: 1px solid transparent;
    transition:
      background 0.5s var(--ease-out),
      border-color 0.5s,
      box-shadow 0.5s,
      padding 0.5s var(--ease-out),
      width 0.6s var(--ease-out);
  }
  .site-header.is-scrolled .bar {
    width: min(100%, 1120px);
    background: rgb(255 255 255 / 0.78);
    border-color: rgb(42 9 22 / 0.07);
    box-shadow:
      0 12px 32px -16px rgb(42 9 22 / 0.25),
      inset 0 1px 0 #fff;
    backdrop-filter: blur(18px) saturate(1.5);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
  }

  /* — Marque — */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: none;
  }
  .brand-mark {
    width: auto;
    height: 34px;
    transition:
      transform 0.6s var(--ease-spring),
      height 0.5s var(--ease-out);
  }
  .brand:hover .brand-mark {
    transform: rotate(-4deg) scale(1.05);
  }
  .site-header.is-scrolled .brand-mark {
    height: 30px;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
    padding-left: 0.75rem;
    border-left: 1px solid rgb(97 25 58 / 0.18);
  }
  /* Lockup en minuscules, comme sur le logo */
  .brand-name,
  .brand-sub {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: lowercase;
    color: var(--blue-700);
  }
  .brand-sub {
    margin-top: 0.15rem;
  }

  /* — Navigation — */
  .nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .nav-link {
    position: relative;
    display: block;
    padding: 0.55rem 0.95rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 400;
    white-space: nowrap;
    color: var(--text);
    transition:
      color 0.3s,
      background 0.3s;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.2rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--terra-500);
    translate: -50% 0;
    scale: 0;
    transition: scale 0.45s var(--ease-spring);
  }
  .nav-link:hover {
    color: var(--blue-700);
    background: rgb(97 25 58 / 0.06);
  }
  .nav-link.is-active {
    color: var(--blue-700);
  }
  .nav-link.is-active::after {
    scale: 1;
  }

  .bar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* — Bouton menu (mobile) — */
  .burger {
    display: none;
    position: relative;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--blue-700);
    box-shadow: 0 10px 22px -10px rgb(97 25 58 / 0.7);
  }
  .burger span {
    position: absolute;
    left: 14px;
    right: 14px;
    height: 2px;
    border-radius: 2px;
    background: #fff;
    transition:
      transform 0.5s var(--ease-out),
      top 0.5s var(--ease-out);
  }
  .burger span:first-child {
    top: 18px;
  }
  .burger span:last-child {
    top: 26px;
  }
  .burger[aria-expanded='true'] span:first-child {
    top: 22px;
    transform: rotate(45deg);
  }
  .burger[aria-expanded='true'] span:last-child {
    top: 22px;
    transform: rotate(-45deg);
  }

  /* — Menu plein écran — */
  .mobile-menu {
    pointer-events: auto;
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: 7.5rem 1.75rem 2.25rem;
    overflow-y: auto;
    background:
      radial-gradient(60% 40% at 100% 0%, rgb(229 129 188 / 0.1), transparent 70%),
      radial-gradient(60% 50% at 0% 100%, rgb(123 37 80 / 0.12), transparent 70%), var(--cream);
    clip-path: circle(0 at calc(100% - 2.6rem) 2.6rem);
    visibility: hidden;
    transition:
      clip-path 0.7s var(--ease-in-out),
      visibility 0s linear 0.7s;
  }
  .mobile-menu.is-open {
    clip-path: circle(150% at calc(100% - 2.6rem) 2.6rem);
    visibility: visible;
    transition:
      clip-path 0.8s var(--ease-in-out),
      visibility 0s;
  }
  .mobile-menu li,
  .mobile-foot {
    opacity: 0;
    translate: 0 24px;
    transition:
      opacity 0.5s var(--ease-out),
      translate 0.6s var(--ease-out);
  }
  .mobile-menu.is-open li,
  .mobile-menu.is-open .mobile-foot {
    opacity: 1;
    translate: none;
    transition-delay: calc(0.2s + var(--i) * 0.06s);
  }
  .mobile-menu ul a {
    display: flex;
    justify-content: center;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 8vw, 2.4rem);
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .mobile-menu ul a:active {
    color: var(--blue-700);
  }
  .mobile-foot {
    display: grid;
    gap: 1.1rem;
    justify-items: center;
  }
  .mobile-foot .btn {
    width: 100%;
  }
  .mobile-mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--blue-700);
  }

  @media (max-width: 1023px) {
    .nav {
      display: none;
    }
    .burger {
      display: block;
    }
  }
  @media (max-width: 560px) {
    .header-cta {
      display: none;
    }
    .bar-wrap {
      padding: 0.6rem 0.6rem 0;
    }
    .brand-mark {
      height: 34px;
    }
  }
  @media (min-width: 1024px) {
    .mobile-menu {
      display: none;
    }
  }
</style>
