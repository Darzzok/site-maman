---
import { site, zone } from '../data/site';
import Icon from './Icon.astro';
import { getMetiers, getZones, metierUrl, zoneUrl } from '../utils/landings';

const metiers = await getMetiers();
const zones = await getZones();

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const base = home ? '' : '/';
const year = new Date().getFullYear();

const links = [
  { label: 'Accueil', href: `${base}#accueil` },
  { label: 'Services', href: `${base}#services` },
  { label: 'À propos', href: `${base}#a-propos` },
  { label: 'Cas clients', href: `${base}#cas-clients` },
  { label: 'Conseils', href: '/conseils.html' },
  { label: 'FAQ', href: '/faq.html' },
  { label: 'Contact', href: `${base}#contact` },
];
---

<footer class="footer">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="container">
    <!-- Identité et coordonnées -->
    <div class="footer-brand">
      <a href={home ? '#accueil' : '/'} class="f-logo" aria-label={`${site.name} — accueil`}>
        <img src="/images/logo-full-white.png" alt={site.name} width="1200" height="556" loading="lazy" />
      </a>
      <p class="f-owner">{site.owner} — {site.role} en gestion administrative et financière</p>
      <ul class="f-contact">
        <li>
          <span><Icon name="mapPin" size={16} />{zone.short}</span>
        </li>
        <li>
          <a href={`mailto:${site.email}`}><Icon name="mail" size={16} />{site.emailLabel}</a>
        </li>
        <li>
          <a href={`tel:${site.phone}`}><Icon name="phone" size={16} />{site.phoneLabel}</a>
        </li>
      </ul>
      <a href={`${base}#rendez-vous`} class="btn btn--soft btn--sm">
        Prendre rendez-vous <Icon name="arrowRight" size={16} class="i-arrow" />
      </a>
    </div>

    <!-- Liens (volets dépliables sur mobile) -->
    <div class="footer-grid">
      <details class="f-col" open data-f-col>
        <summary class="f-title">Navigation <Icon name="chevronDown" size={18} class="f-chev" /></summary>
        <ul class="f-links">
          {
            links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </details>

      <details class="f-col" open data-f-col>
        <summary class="f-title">Métiers <Icon name="chevronDown" size={18} class="f-chev" /></summary>
        <ul class="f-links">
          {
            metiers.map((m) => (
              <li>
                <a href={metierUrl(m.id)}>{m.data.name}</a>
              </li>
            ))
          }
          <li><a href="/metiers.html" class="f-all">Tous les métiers</a></li>
        </ul>
      </details>

      <details class="f-col" open data-f-col>
        <summary class="f-title">Zones <Icon name="chevronDown" size={18} class="f-chev" /></summary>
        <ul class="f-links">
          {
            zones.map((z) => (
              <li>
                <a href={zoneUrl(z.id)}>{z.data.name}</a>
              </li>
            ))
          }
          <li><a href="/zone-intervention.html" class="f-all">Toute la zone d’intervention</a></li>
        </ul>
      </details>

      <details class="f-col" open data-f-col>
        <summary class="f-title">Informations <Icon name="chevronDown" size={18} class="f-chev" /></summary>
        <ul class="f-links">
          <li><a href="/mentions-legales.html">Mentions légales</a></li>
          <li><a href="/confidentialite.html">Confidentialité</a></li>
          <li>
            <button type="button" data-manage-cookies>Gérer les cookies</button>
          </li>
        </ul>
      </details>
    </div>

    <div class="footer-bottom">
      <p>© <span data-year>{year}</span> {site.name} — {site.owner}. Tous droits réservés.</p>
    </div>
  </div>
</footer>

<script>
  const mq = window.matchMedia('(max-width: 760px)');
  const cols = document.querySelectorAll<HTMLDetailsElement>('[data-f-col]');
  const sync = () => cols.forEach((c) => (c.open = !mq.matches));
  mq.addEventListener('change', sync);
  sync();
</script>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    padding-top: clamp(3.5rem, 7vw, 5rem);
    color: #fff;
    text-align: center;
    background: linear-gradient(180deg, var(--blue-900), var(--blue-950));
  }
  .footer-glow {
    position: absolute;
    inset: -40% -10% auto auto;
    width: 60vw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(246 181 91 / 0.1), transparent 60%);
    pointer-events: none;
  }
  .container {
    position: relative;
  }

  /* ============ Identité ============ */
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: clamp(2.2rem, 4vw, 3rem);
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }
  .f-logo img {
    width: 210px;
    height: auto;
  }
  .f-owner {
    max-width: 34rem;
    margin-top: 1.1rem;
    font-size: 0.92rem;
    color: #fff;
  }
  .f-contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0.6rem;
    margin: 1.3rem 0 1.6rem;
  }
  .f-contact li > * {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    font-size: 0.88rem;
    color: #fff;
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.12);
    transition:
      background 0.3s,
      border-color 0.3s;
  }
  .f-contact a:hover {
    background: rgb(255 255 255 / 0.12);
    border-color: rgb(255 255 255 / 0.3);
  }
  .f-contact :global(svg) {
    flex: none;
    color: var(--terra-300);
  }

  /* ============ Liens ============ */
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    padding-block: clamp(2.2rem, 4vw, 3rem);
  }
  .f-title {
    margin-bottom: 1rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terra-300);
  }
  .f-title a {
    color: inherit;
  }
  .f-title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .f-links {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
  }
  .f-links a,
  .f-links button {
    position: relative;
    font-size: 0.93rem;
    color: #fff;
  }
  /* Survol : soulignement qui se déploie depuis le centre */
  .f-links a::before,
  .f-links button::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -3px;
    width: 0;
    height: 1.5px;
    translate: -50% 0;
    background: var(--terra-300);
    transition: width 0.4s var(--ease-out);
  }
  .f-links a:hover::before,
  .f-links button:hover::before {
    width: 100%;
  }

  .footer-bottom {
    padding-block: 1.5rem 2rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.82rem;
    color: #fff;
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.4rem;
    }
    /* Pastilles sur deux lignes : coins moins arrondis */
    .f-contact li > * {
      border-radius: 16px;
      text-align: center;
    }
    /* Laisse la place au bouton « retour en haut » */
    .footer-bottom {
      padding-bottom: 5.5rem;
    }
  }

  /* ============ Colonnes : volets dépliables sur mobile ============ */
  .f-col summary {
    list-style: none;
  }
  .f-col summary::-webkit-details-marker {
    display: none;
  }
  .f-col :global(.f-chev) {
    display: none;
  }
  .f-all {
    font-weight: 700;
    color: var(--terra-300) !important;
  }
  @media (min-width: 761px) {
    .f-col summary {
      pointer-events: none;
    }
  }
  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
      row-gap: 0;
      padding-block: 1rem 1.5rem;
    }
    .f-col {
      border-bottom: 1px solid rgb(255 255 255 / 0.1);
    }
    .f-col summary {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 52px;
      margin: 0;
      cursor: pointer;
    }
    .f-col :global(.f-chev) {
      display: block;
      transition: rotate 0.35s var(--ease-out);
    }
    .f-col[open] :global(.f-chev) {
      rotate: 180deg;
    }
    .f-col .f-links {
      padding-bottom: 1.2rem;
    }
    .f-col[open] .f-links {
      animation: f-open 0.4s var(--ease-out);
    }
    @keyframes f-open {
      from {
        opacity: 0;
        translate: 0 -6px;
      }
    }
    .f-links a,
    .f-links button {
      display: inline-block;
      padding-block: 0.3rem;
    }
  }
</style>
