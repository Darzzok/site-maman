      background 0.3s,
      color 0.3s,
      rotate 0.5s var(--ease-spring);
  }
  .ans input:checked + .ans-box .ans-key {
    color: #fff;
    background: var(--blue-700);
    border-color: var(--blue-700);
    rotate: -8deg;
  }
  .ans-label {
    flex: 1;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
  }
  .ans--na .ans-label {
    font-style: italic;
    color: var(--muted);
  }
  .ans-check {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    color: #fff;
    background: var(--terra-500);
    scale: 0;
    transition: scale 0.45s var(--ease-spring);
  }
  .ans input:checked + .ans-box .ans-check {
    scale: 1;
  }

  /* Profil : activité et effectif */
  .act-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 1.6rem;
  }
  .act-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    height: 100%;
    padding: 1rem 0.5rem;
    border-radius: 18px;
    text-align: center;
    background: var(--cream);
    border: 1.5px solid var(--line);
    transition:
      border-color 0.3s,
      background 0.3s,
      box-shadow 0.3s,
      transform 0.45s var(--ease-spring);
  }
  .act:hover .act-box {
    border-color: var(--blue-200);
    transform: translateY(-3px);
  }
  .act input:checked + .act-box {
    background: #fff;
    border-color: var(--blue-700);
    box-shadow: 0 0 0 4px rgb(97 25 58 / 0.08);
    animation: ans-pop 0.45s var(--ease-spring);
  }
  .act input:focus-visible + .act-box,
  .pill input:focus-visible + span,
  .check input:focus-visible + .check-box {
    outline: 2.5px solid var(--blue-700);
    outline-offset: 3px;
  }
  .act-ic {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    color: var(--blue-700);
    background: #fff;
    border: 1px solid var(--blue-100);
    transition:
      color 0.3s,
      background 0.3s,
      rotate 0.5s var(--ease-spring);
  }
  .act input:checked + .act-box .act-ic {
    color: #fff;
    background: var(--blue-700);
    rotate: -6deg;
  }
  .act-label {
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--ink);
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .pill span {
    display: inline-flex;
    padding: 0.6rem 1.15rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    background: var(--cream);
    border: 1.5px solid var(--line);
    transition:
      color 0.3s,
      background 0.3s,
      border-color 0.3s;
  }
  .pill:hover span {
    border-color: var(--blue-200);
  }
  .pill input:checked + span {
    color: #fff;
    background: var(--blue-700);
    border-color: var(--blue-700);
    animation: ans-pop 0.4s var(--ease-spring);
  }

  /* Bon à savoir */
  .tip {
    display: none;
    align-items: flex-end;
    gap: 0.7rem;
    max-width: 40rem;
    margin: 1.3rem auto 0;
  }
  .tip.is-typing,
  .tip.is-shown {
    display: flex;
    animation: tip-in 0.45s var(--ease-out) both;
  }
  @keyframes tip-in {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }
  .tip-avatar {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 51% 28%;
    border: 2px solid #fff;
    box-shadow: 0 0 0 2px var(--apricot);
  }
  .tip-bubble {
    position: relative;
    padding: 0.85rem 1.1rem;
    border-radius: 18px 18px 18px 6px;
    text-align: left;
    background: var(--rose-100);
    border: 1px solid var(--rose-200);
  }
  .tip-typing {
    display: none;
    gap: 5px;
    padding: 0.35rem 0.2rem;
  }
  .tip.is-typing .tip-typing {
    display: inline-flex;
  }
  .tip.is-typing .tip-text {
    display: none;
  }
  .tip-typing i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--terra-500);
    animation: tip-dot 1s ease-in-out infinite;
  }
  .tip-typing i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .tip-typing i:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes tip-dot {
    0%,
    60%,
    100% {
      translate: 0 0;
      opacity: 0.45;
    }
    30% {
      translate: 0 -5px;
      opacity: 1;
    }
  }
  .tip-text {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text);
    animation: tip-in 0.4s var(--ease-out) both;
  }
  .tip-text strong {
    display: block;
    margin-bottom: 0.15rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--terra-700);
  }

  .quiz-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line-soft);
  }
  .quiz-keys {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .diag[data-step='profil'] .quiz-keys {
    visibility: hidden;
  }
  .quiz-keys kbd {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    border-radius: 6px;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--blue-700);
    background: var(--blue-50);
    border: 1px solid var(--blue-100);
  }
  .quiz-keys kbd:last-of-type {
    margin-right: 0.3rem;
  }
  .quiz-nav .btn {
    margin-left: auto;
  }
  .quiz-nav .btn[disabled] {
    opacity: 0.4;
    box-shadow: none;
    cursor: not-allowed;
  }
  .quiz-nav .btn.is-ready {
    animation: diag-glow 1.6s ease-in-out 2;
  }

  /* ================================================================
     3. Analyse
     ================================================================ */
  .s-analysis {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 640px;
    margin-inline: auto;
    padding-block: 1rem;
    text-align: center;
  }
  .an-orb {
    position: relative;
    display: grid;
    place-items: center;
    width: 220px;
    height: 220px;
  }
  .an-wave {
    position: absolute;
    inset: 22%;
    border-radius: 50%;
    border: 2px solid rgb(246 181 91 / 0.7);
    animation: an-wave 2.4s var(--ease-out) infinite;
  }
  .an-wave:nth-child(2) {
    animation-delay: 0.8s;
  }
  .an-wave:nth-child(3) {
    animation-delay: 1.6s;
  }
  @keyframes an-wave {
    from {
      scale: 0.9;
      opacity: 1;
    }
    to {
      scale: 2.1;
      opacity: 0;
    }
  }
  .an-spin {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 0 35%, rgb(246 181 91 / 0.9) 65%, var(--terra-500) 82%, var(--blue-700) 100%);
    mask: radial-gradient(farthest-side, transparent calc(100% - 7px), #000 calc(100% - 6px));
    animation: an-rotate 1.4s linear infinite;
  }
  .an-dash {
    position: absolute;
    inset: 3%;
    border-radius: 50%;
    border: 1.5px dashed rgb(97 25 58 / 0.25);
    animation: an-rotate 14s linear infinite reverse;
  }
  @keyframes an-rotate {
    to {
      rotate: 360deg;
    }
  }
  .an-orbit {
    position: absolute;
    inset: 0;
    animation: an-rotate 3.2s linear infinite;
  }
  .an-orbit i {
    position: absolute;
    top: 3%;
    left: 50%;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    border-radius: 50%;
    background: var(--terra-500);
    box-shadow: 0 0 12px var(--terra-400);
  }
  .an-orbit.o2 {
    inset: 10%;
    animation-duration: 4.6s;
    animation-direction: reverse;
  }
  .an-orbit.o2 i {
    background: var(--apricot);
    width: 8px;
    height: 8px;
  }
  .an-orbit.o3 {
    inset: -4%;
    animation-duration: 7s;
  }
  .an-orbit.o3 i {
    background: var(--rose);
    width: 7px;
    height: 7px;
    box-shadow: none;
  }
  .an-core {
    position: relative;
    display: grid;
    place-items: center;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    color: #fff;
    background: radial-gradient(circle at 30% 25%, #8a2d57, var(--blue-700) 45%, var(--blue-950));
    box-shadow:
      0 20px 40px -14px rgb(97 25 58 / 0.7),
      inset 0 0 0 4px rgb(255 255 255 / 0.08);
    animation: an-pulse 1.8s ease-in-out infinite;
  }
  @keyframes an-pulse {
    50% {
      scale: 1.06;
    }
  }
  .an-ic {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    scale: 0.5;
    rotate: -30deg;
    transition:
      opacity 0.35s,
      scale 0.5s var(--ease-spring),
      rotate 0.5s var(--ease-spring);
  }
  .an-ic.is-on {
    opacity: 1;
    scale: 1;
    rotate: 0deg;
  }
  .an-ic--done svg path {
    stroke-dasharray: 30;
    stroke-dashoffset: 30;
  }
  .an-ic--done.is-on svg path {
    animation: an-draw 0.5s var(--ease-out) 0.15s forwards;
  }
  @keyframes an-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .an-burst i {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 9px;
    height: 9px;
    margin: -4.5px;
    border-radius: 50%;
    background: var(--apricot);
    opacity: 0;
  }
  .an-burst i:nth-child(3n) {
    background: var(--terra-500);
  }
  .an-burst i:nth-child(4n) {
    background: var(--rose);
    width: 6px;
    height: 6px;
  }
  .s-analysis.is-done .an-burst i {
    animation: an-burst 1s var(--ease-out) forwards;
  }
  @keyframes an-burst {
    from {
      opacity: 1;
      transform: rotate(var(--a)) translateY(-40px);
    }
    to {
      opacity: 0;
      transform: rotate(var(--a)) translateY(-120px) scale(0.4);
    }
  }
  .s-analysis.is-done .an-spin,
  .s-analysis.is-done .an-orbit,
  .s-analysis.is-done .an-wave,
  .s-analysis.is-done .an-dash {
    opacity: 0;
    transition: opacity 0.5s;
  }
  .s-analysis.is-done .an-core {
    animation: an-done 0.7s var(--ease-spring);
  }
  @keyframes an-done {
    40% {
      scale: 1.18;
    }
  }
  .an-kicker {
    margin-top: 1.6rem;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--terra-700);
  }
  .an-title {
    margin-top: 0.5rem;
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    outline: none;
  }
  .an-thought {
    min-height: 3em;
    max-width: 30rem;
    margin-top: 0.8rem;
    font-size: 1rem;
    font-style: italic;
    color: var(--muted);
  }
  .an-thought .caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--terra-500);
    animation: caret 0.9s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
  .an-progress {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: min(100%, 420px);
    margin-top: 1rem;
  }
  .an-track {
    position: relative;
    flex: 1;
    height: 8px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--blue-100);
  }
  .an-track span {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--terra-500), var(--apricot), var(--blue-700));
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.9s var(--ease-out);
  }
  .an-track span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.6), transparent);
    animation: an-shine 1.2s linear infinite;
  }
  @keyframes an-shine {
    from {
      translate: -100% 0;
    }
    to {
      translate: 100% 0;
    }
  }
  .an-pct {
    min-width: 3.2rem;
    font-size: 0.95rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--blue-700);
  }
  .an-steps {
    display: grid;
    gap: 0.4rem;
    width: min(100%, 520px);
    margin-top: 1.6rem;
    text-align: left;
  }
  .an-step {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.85rem;
    border-radius: 14px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--muted);
    opacity: 0.45;
    transition:
      opacity 0.4s,
      background 0.4s,
      color 0.4s;
  }
  .an-step.is-active,
  .an-step.is-done {
    opacity: 1;
    color: var(--ink);
  }
  .an-step.is-active {
    background: #fff;
    box-shadow: var(--shadow-sm);
  }
  .st-ic {
    position: relative;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid var(--blue-100);
    transition:
      background 0.3s,
      border-color 0.3s;
  }
  .st-spin {
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid transparent;
    border-top-color: var(--terra-500);
    opacity: 0;
  }
  .an-step.is-active .st-spin {
    opacity: 1;
    animation: an-rotate 0.7s linear infinite;
  }
  .st-check {
    position: absolute;
    inset: 2px;
    fill: none;
    stroke: #fff;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .st-check path {
    stroke-dasharray: 22;
    stroke-dashoffset: 22;
  }
  .an-step.is-done .st-ic {
    background: var(--blue-700);
    border-color: var(--blue-700);
    animation: ans-pop 0.4s var(--ease-spring);
  }
  .an-step.is-done .st-check path {
    animation: an-draw 0.35s var(--ease-out) forwards;
  }
  .st-label {
    flex: 1;
  }
  .st-note {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--terra-700);
    white-space: nowrap;
  }
  .st-note:not(:empty) {
    animation: tip-in 0.4s var(--ease-out) both;
  }

  /* ================================================================
     4. Résultats
     ================================================================ */
  .s-results {
    max-width: 1060px;
    margin-inline: auto;
  }
  .r-head {
    text-align: center;
  }
  .r-title {
    outline: none;
  }
  .r-hint {
    max-width: 40rem;
    margin: 0.9rem auto 0;
    color: var(--muted);
  }
  .r-hint:empty {
    display: none;
  }
  .r-top {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 1.25rem;
    margin-top: 2.2rem;
  }
  .r-gauge {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 1.5rem;
    text-align: center;
  }
  .g-wrap {
    position: relative;
    width: min(100%, 290px);
    aspect-ratio: 1;
  }
  .g-tick {
    stroke: var(--blue-200);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .g-tick.big {
    stroke: var(--blue-300);
    stroke-width: 2;
  }
  .g-value {
    stroke-dasharray: 0 100;
  }
  .g-dot {
    fill: #fff;
    stroke: var(--blue-700);
    stroke-width: 3.5;
  }
  .g-dot-glow {
    fill: var(--apricot);
    opacity: 0.9;
  }
  .g-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .g-num {
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 8vw, 4.8rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--blue-700);
  }
  .g-num small {
    font-family: var(--font-body);
    font-size: 0.3em;
    font-weight: 700;
    color: var(--muted);
  }
  .g-caption {
    margin-top: 0.4rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .g-burst i {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 9px;
    height: 9px;
    margin: -4.5px;
    border-radius: 50%;
    background: var(--apricot);
    opacity: 0;
  }
  .g-burst i:nth-child(odd) {
    background: var(--terra-500);
    width: 7px;
    height: 7px;
  }
  .g-burst i:nth-child(5n) {
    background: var(--rose);
  }
  .s-results.gauge-done .g-burst i {
    animation: g-burst 1.1s var(--ease-out) forwards;
  }
  @keyframes g-burst {
    from {
      opacity: 1;
      transform: rotate(var(--a)) translateY(-100px);
    }
    to {
      opacity: 0;
      transform: rotate(var(--a)) translateY(-160px) scale(0.3);
    }
  }
  .g-level {
    display: inline-flex;
    margin-top: 0.4rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 800;
    color: #fff;
    background: var(--blue-700);
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 0.4s,
      scale 0.6s var(--ease-spring);
  }
  .g-level[data-level='mid'] {
    color: var(--ink);
    background: var(--apricot);
  }
  .g-level[data-level='low'] {
    color: var(--terra-700);
    background: var(--terra-100);
    border: 1.5px solid var(--terra-500);
  }
  .s-results.gauge-done .g-level {
    opacity: 1;
    scale: 1;
  }
  .g-text {
    max-width: 24rem;
    margin-top: 0.8rem;
    color: var(--text);
    opacity: 0;
    transition: opacity 0.6s 0.2s;
  }
  .s-results.gauge-done .g-text {
    opacity: 1;
  }

  /* Radar */
  .r-radar {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.6rem 1rem 1rem;
    text-align: center;
  }
  .radar {
    width: 100%;
    max-width: 480px;
    margin-top: 0.4rem;
    overflow: visible;
  }
  .rd-wedge {
    fill: var(--cream);
  }
  .rd-wedge.w1,
  .rd-wedge.w3 {
    fill: var(--rose-100);
  }
  .rd-ring {
    fill: none;
    stroke: var(--blue-100);
    stroke-width: 1;
  }
  .rd-spoke {
    stroke: var(--blue-100);
    stroke-width: 1;
  }
  .rd-shape {
    fill: rgb(97 25 58 / 0.16);
    stroke: var(--blue-700);
    stroke-width: 2.5;
    stroke-linejoin: round;
    transform-box: view-box;
    transform-origin: 50% 50%;
    transform: scale(0.01);
    transition: transform 1.3s var(--ease-spring) 0.5s;
  }
  .rd-pt {
    fill: var(--blue-700);
    stroke: #fff;
    stroke-width: 2;
    opacity: 0;
    transition: opacity 0.4s calc(1.2s + var(--i, 0) * 0.05s);
  }
  .rd-pt[data-level='mid'] {
    fill: var(--apricot);
    stroke: var(--blue-700);
    stroke-width: 1.5;
  }
  .rd-pt[data-level='low'] {
    fill: var(--terra-500);
  }
  .rd-pt[data-level='na'] {
    fill: #fff;
    stroke: var(--blue-300);
  }
  .s-results.is-animated .rd-shape {
    transform: none;
  }
  .s-results.is-animated .rd-pt {
    opacity: 1;
  }
  .rd-label {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 800;
    fill: var(--ink);
  }
  .rd-pct {
    font-size: 13px;
    font-weight: 700;
    fill: var(--terra-700);
  }

  /* Chiffres clés */
  .r-kpis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .kpi {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.3rem 1rem;
    border-radius: var(--radius-lg);
    text-align: center;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }
  .kpi-ic {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 13px;
    color: var(--terra-700);
    background: var(--rose-100);
  }
  .kpi-num {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.1;
    color: var(--blue-700);
  }
  .kpi-label {
    margin-top: 0.15rem;
    font-size: 0.86rem;
    color: var(--muted);
  }

  /* Domaines */
  .r-domains {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .dom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    padding: 1.5rem 1.4rem 1.3rem;
    border-radius: var(--radius-lg);
    text-align: center;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    opacity: 0;
    translate: 0 16px;
    transition:
      opacity 0.6s calc(0.6s + var(--i) * 0.12s),
      translate 0.6s var(--ease-out) calc(0.6s + var(--i) * 0.12s);
  }
  .s-results.is-animated .dom {
    opacity: 1;
    translate: none;
  }
  .dom-ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 15px;
    color: #fff;
    background: linear-gradient(135deg, var(--blue-700), var(--blue-900));
  }
  .dom-body {
    width: 100%;
    min-width: 0;
  }
  .dom-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 0.6rem;
  }
  .dom-head h3 {
    font-size: 1.2rem;
  }
  .dom-badge {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    background: var(--blue-700);
  }
  .dom[data-level='mid'] .dom-badge {
    color: var(--ink);
    background: var(--apricot);
  }
  .dom[data-level='low'] .dom-badge {
    color: var(--terra-700);
    background: var(--terra-100);
    box-shadow: inset 0 0 0 1.5px var(--terra-500);
  }
  .dom-pct {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--blue-700);
  }
  .dom-bar {
    position: relative;
    display: block;
    height: 9px;
    margin-top: 0.7rem;
    border-radius: 9px;
    overflow: hidden;
    background: var(--blue-50);
  }
  .dom-bar span {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    border-radius: inherit;
    background: var(--blue-700);
    transition: width 1.4s var(--ease-out) calc(0.9s + var(--i) * 0.12s);
  }
  .dom[data-level='mid'] .dom-bar span {
    background: linear-gradient(90deg, var(--terra-400), var(--apricot));
  }
  .dom[data-level='low'] .dom-bar span {
    background: var(--terra-500);
  }
  .s-results.is-animated .dom-bar span {
    width: var(--pct);
  }
  .dom-text {
    max-width: 30rem;
    margin: 0.7rem auto 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Points forts */
  .r-strengths {
    margin-top: 1.6rem;
    text-align: center;
  }
  .r-strengths ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }
  .r-strengths li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.95rem 0.45rem 0.45rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--blue-700);
    background: #fff;
    border: 1px solid var(--line);
  }
  .sf-ic {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    color: #fff;
    background: var(--blue-700);
  }

  /* Plan d'action */
  .plan {
    margin-top: 2.6rem;
    padding: clamp(1.4rem, 3.5vw, 2.4rem);
    border-radius: var(--radius-xl);
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
  }
  .plan-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    text-align: center;
    scroll-margin-top: calc(var(--header-h) + 20px);
  }
  .plan-head-ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    color: var(--ink);
    background: var(--apricot);
  }
  .plan-head h3 {
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    scroll-margin-top: calc(var(--header-h) + 20px);
  }
  .plan-head p {
    font-size: 0.92rem;
    color: var(--muted);
  }
  .plan-list {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.8rem;
    counter-reset: plan;
  }
  .plan-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.4rem 1.3rem 1.2rem;
    border-radius: 22px;
    text-align: center;
    background: var(--cream);
    border: 1px solid var(--line);
    transition:
      filter 0.8s var(--ease-out),
      opacity 0.8s,
      transform 0.8s var(--ease-out);
    transition-delay: calc(var(--i, 0) * 0.08s);
  }
  .plan-item {
    grid-column: span 3;
  }
  /* Actions suivantes : cartes compactes en 3 colonnes */
  .plan-item.is-compact {
    grid-column: span 2;
    padding: 1.2rem 1rem 1rem;
    background: #fff;
  }
  .plan-item.is-compact:not(.is-open) .pi-answer,
  .plan-item.is-compact:not(.is-open) .pi-text,
  .plan-item.is-compact:not(.is-open) .pi-help {
    display: none;
  }
  .plan-item.is-compact.is-open .pi-answer,
  .plan-item.is-compact.is-open .pi-text,
  .plan-item.is-compact.is-open .pi-help {
    animation: tip-in 0.4s var(--ease-out) both;
  }
  .plan-item.is-compact h4 {
    font-size: 1.08rem;
  }
  .plan-item.is-compact .pi-rank {
    margin-bottom: 0.6rem;
  }
  .pi-more {
    margin-top: auto;
    padding: 0.8rem 0.4rem 0;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--blue-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .plan-item.is-open .pi-more {
    margin-top: 0.3rem;
  }
  .plan-item:first-child {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, #fff, var(--rose-100));
    border-color: var(--rose-200);
  }
  .plan-item--great {
    grid-column: 1 / -1;
  }
  .plan-item.is-blurred {
    filter: blur(6px);
    opacity: 0.55;
    user-select: none;
    pointer-events: none;
  }
  .pi-rank {
    margin-bottom: 0.8rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: var(--blue-700);
  }
  .plan-item:nth-child(n + 4) .pi-rank {
    color: var(--blue-700);
    background: var(--blue-50);
  }
  .pi-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }
  .pi-ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 13px;
    color: var(--blue-700);
    background: #fff;
    border: 1px solid var(--blue-100);
  }
  .plan-item[data-level='low'] .pi-ic {
    color: #fff;
    background: var(--terra-500);
    border-color: var(--terra-500);
  }
  .pi-domain {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--terra-700);
  }
  .plan-item h4 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--blue-700);
  }
  .pi-answer {
    margin-top: 0.8rem;
    font-size: 0.82rem;
    font-style: italic;
    color: var(--muted);
  }
  .pi-text {
    margin-top: 0.5rem;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--text);
  }
  .pi-help {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.9rem;
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--blue-700);
  }
  .pi-help-ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    color: var(--ink);
    background: var(--apricot);
  }
  .pi-text + .pi-help {
    margin-top: 0.9rem;
    border-top: 1px dashed var(--line);
  }

  /* Verrou */
  .diag.is-locked .plan-list {
    position: relative;
    max-height: 34rem;
    overflow: hidden;
    mask-image: linear-gradient(180deg, #000 55%, transparent);
  }
  .lock {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 42rem;
    margin: -5rem auto 0;
    padding: clamp(1.6rem, 4vw, 2.4rem);
    border-radius: var(--radius-lg);
    text-align: center;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 30px 70px -30px rgb(97 25 58 / 0.45);
  }
  .lock[hidden] {
    display: none;
  }
  .lock-ic {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-top: -3.6rem;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(135deg, var(--blue-700), var(--blue-950));
    box-shadow:
      0 0 0 6px #fff,
      0 16px 30px -12px rgb(97 25 58 / 0.7);
  }
  .lock-svg {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lock-shackle {
    transition: transform 0.5s var(--ease-spring);
  }
  .lock.is-opening .lock-shackle {
    transform: translate(5px, -3px) rotate(20deg);
    transform-origin: 16px 11px;
  }
  .lock.is-opening {
    animation: lock-out 0.7s var(--ease-out) 0.25s forwards;
  }
  @keyframes lock-out {
    to {
      opacity: 0;
      scale: 0.94;
      filter: blur(4px);
    }
  }
  .lock-title {
    margin-top: 1.1rem;
    font-size: clamp(1.35rem, 2.6vw, 1.7rem);
  }
  .lock-text {
    max-width: 32rem;
    margin-top: 0.6rem;
    color: var(--muted);
  }
  .lock-text strong {
    color: var(--blue-700);
  }
  .lead {
    width: 100%;
    margin-top: 1.4rem;
  }
  .lead-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
  }
  .lf {
    position: relative;
  }
  .lf input {
    width: 100%;
    padding: 1.4rem 1rem 0.5rem 2.8rem;
    border-radius: 14px;
    border: 1.5px solid var(--line);
    background: var(--cream);
    font-size: 1rem;
    color: var(--ink);
    outline: none;
    transition:
      border-color 0.3s,
      background 0.3s,
      box-shadow 0.3s;
  }
  .lf input:focus {
    border-color: var(--blue-700);
    background: #fff;
    box-shadow: 0 0 0 4px rgb(97 25 58 / 0.1);
  }
  .lead.was-validated .lf input:invalid {
    border-color: var(--danger);
    background: var(--danger-bg);
  }
  .lf label {
    position: absolute;
    left: 2.8rem;
    top: 0.98rem;
    max-width: calc(100% - 3.4rem);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.95rem;
    color: var(--muted);
    pointer-events: none;
    transform-origin: left top;
    transition:
      transform 0.3s var(--ease-out),
      color 0.3s;
  }
  .lf input:focus + label,
  .lf input:not(:placeholder-shown) + label {
    transform: translateY(-0.6rem) scale(0.78);
    font-weight: 600;
    color: var(--blue-700);
  }
  .lf .lf-ic {
    position: absolute;
    left: 0.95rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--muted);
  }
  .lf:focus-within .lf-ic {
    color: var(--blue-700);
  }
  .check {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    max-width: 36rem;
    margin: 0.9rem auto 0;
    font-size: 0.86rem;
    line-height: 1.5;
    text-align: left;
    color: var(--text);
  }
  .check input {
    width: 22px;
    height: 22px;
  }
  .check-box {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 0.05rem;
    border-radius: 7px;
    color: transparent;
    background: #fff;
    border: 1.5px solid var(--sand-300);
    transition:
      background 0.3s,
      border-color 0.3s,
      color 0.3s,
      transform 0.4s var(--ease-spring);
  }
  .check input:checked + .check-box {
    color: #fff;
    background: var(--blue-700);
    border-color: var(--blue-700);
    transform: scale(1.08);
  }
  .lead.was-validated .check input:invalid + .check-box {
    border-color: var(--danger);
    background: var(--danger-bg);
  }
  .check a {
    position: relative;
    z-index: 1;
    font-weight: 700;
    color: var(--blue-700);
    text-decoration: underline;
  }
  .check strong {
    color: var(--blue-700);
  }
  .lead-first {
    margin-top: 1.1rem;
  }
  .lead-error {
    display: none;
    margin-top: 0.9rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--danger);
  }
  .lead-error.is-visible {
    display: block;
  }
  .lead-btn {
    width: 100%;
    margin-top: 1.2rem;
    justify-content: center;
  }
  .lead-btn .spinner {
    display: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid rgb(255 255 255 / 0.35);
    border-top-color: #fff;
    animation: an-rotate 0.8s linear infinite;
  }
  .lead-btn.is-loading .spinner {
    display: inline-block;
  }
  .lead-btn.is-loading .i-arrow {
    display: none;
  }
  .lead-safe {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.9rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Après déblocage */
  .diag.just-unlocked .plan-item {
    animation: plan-reveal 0.9s var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 0.1s);
  }
  @keyframes plan-reveal {
    from {
      filter: blur(6px);
      opacity: 0.4;
      transform: translateY(10px);
    }
  }
  .next {
    margin-top: 1.6rem;
  }
  .next[hidden] {
    display: none;
  }
  .next-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(2rem, 5vw, 3.2rem) clamp(1.4rem, 4vw, 3rem);
    border-radius: var(--radius-xl);
    text-align: center;
    color: #fff;
    background: linear-gradient(140deg, var(--blue-700), var(--blue-950));
    animation: diag-screen 0.8s var(--ease-out) both;
  }
  .next-glow {
    position: absolute;
    inset: auto -20% -60% auto;
    z-index: -1;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(246 181 91 / 0.28);
    filter: blur(70px);
  }
  .next-photo {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 51% 28%;
    border: 3px solid var(--apricot);
  }
  .next-kicker {
    margin-top: 1rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--apricot);
  }
  .next-card h3 {
    margin-top: 0.4rem;
    font-size: clamp(1.7rem, 3.4vw, 2.3rem);
    color: #fff;
  }
  .next-card h3 em {
    font-style: italic;
    font-synthesis: style;
    text-transform: uppercase;
    font-size: 0.86em;
    color: var(--apricot);
  }
  .next-card p {
    max-width: 34rem;
    margin-top: 0.8rem;
    color: rgb(255 255 255 / 0.92);
  }
  .next-card p strong {
    color: #fff;
  }
  .next-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }

  .r-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1rem;
    margin-top: 1.8rem;
  }

  /* ================================================================
     Responsive
     ================================================================ */
  @media (max-width: 1023px) {
    .s-intro {
      grid-template-columns: 1fr;
    }
    .intro-visual {
      max-width: 380px;
    }
    .s-quiz {
      grid-template-columns: 1fr;
    }
    /* Progression en bandeau horizontal */
    .side {
      position: static;
      padding: 0.6rem;
      border-radius: 22px;
    }
    .side-title,
    .side-meta {
      display: none;
    }
    .side-list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.2rem;
    }
    .side-item {
      flex-direction: column;
      gap: 0.3rem;
      padding: 0.4rem 0.2rem;
      text-align: center;
    }
    .side-txt {
      font-size: 0.72rem;
    }
    .side-txt small {
      display: none;
    }
    .act-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .r-top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .diag-stage {
      padding-top: calc(var(--header-h) + 1.2rem);
    }
    .diag {
      min-height: 0;
    }
    .intro-visual {
      max-width: 270px;
    }
    .iv-chip {
      font-size: 0.76rem;
      padding: 0.35rem 0.7rem 0.35rem 0.35rem;
    }
    .iv-chip-ic {
      width: 24px;
      height: 24px;
    }
    .iv-chip-ic svg {
      width: 13px;
      height: 13px;
    }
    .iv-plan {
      display: none;
    }
    .s-intro h1 {
      font-size: clamp(2rem, 8.4vw, 2.6rem);
    }
    .intro-facts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }
    .intro-facts li {
      justify-content: center;
    }
    .intro-actions,
    .intro-actions .btn {
      width: 100%;
    }
    .side-txt {
      display: none;
    }
    .side {
      padding: 0.4rem;
    }
    .quiz {
      padding: 1.2rem 1rem 1.1rem;
      border-radius: 26px;
    }
    .quiz-form {
      margin-top: 1.3rem;
    }
    .q-title {
      font-size: 1.35rem;
    }
    .answers {
      margin-top: 1.2rem;
      gap: 0.5rem;
    }
    .ans-box {
      padding: 0.75rem 0.8rem;
      gap: 0.7rem;
    }
    .ans-key {
      width: 30px;
      height: 30px;
    }
    .ans-label {
      font-size: 0.94rem;
    }
    .act-grid {
      grid-template-columns: 1fr;
      gap: 0.45rem;
      margin-top: 1.2rem;
    }
    .act-box {
      flex-direction: row;
      gap: 0.75rem;
      padding: 0.6rem 0.8rem;
      text-align: left;
    }
    .act-ic {
      width: 38px;
      height: 38px;
      border-radius: 12px;
    }
    .act-label {
      font-size: 0.94rem;
    }
    .q-sub {
      margin-top: 1.2rem;
    }
