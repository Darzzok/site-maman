---
/**
 * Diagnostic de gestion interactif : accueil → questions → analyse animée → résultats.
 * Le score s'affiche librement ; le plan d'action complet se débloque en laissant ses coordonnées
 * (envoi via Formspree : Nadège reçoit les réponses, les scores et les priorités).
 * Contenu (questions, recommandations, niveaux) : src/data/diagnostic.ts
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import nadege from '../assets/images/nadege.jpg';
import { site } from '../data/site';
import { activites, domains, effectifs, questions } from '../data/diagnostic';

const keys = ['A', 'B', 'C', 'D', 'E'];
const domainOf = (id: string) => domains.find((d) => d.id === id)!;
const total = questions.length;

/* Radar : 12 rayons (un par question), regroupés en 4 secteurs (un par domaine) */
const R = 115;
const rad = (i: number) => ((i * 30 - 90) * Math.PI) / 180;
const pt = (i: number, r: number) => [Math.cos(rad(i)) * r, Math.sin(rad(i)) * r].map((v) => +v.toFixed(2));
const ring = (f: number) => questions.map((_, i) => pt(i, R * f).join(',')).join(' ');
const wedge = (d: number) => {
  const a1 = ((d * 90 - 105) * Math.PI) / 180;
  const a2 = ((d * 90 - 15) * Math.PI) / 180;
  const p1 = [Math.cos(a1) * R, Math.sin(a1) * R].map((v) => v.toFixed(2));
  const p2 = [Math.cos(a2) * R, Math.sin(a2) * R].map((v) => v.toFixed(2));
  return `M0 0 L${p1.join(' ')} A${R} ${R} 0 0 1 ${p2.join(' ')} Z`;
};
const labelPos = (d: number) => pt(d * 3 + 1, R * 1.2);

const analysisSteps = [
  { label: 'Lecture de vos réponses', icon: 'search' },
  ...domains.map((d) => ({ label: `Analyse : ${d.label.toLowerCase()}`, icon: d.icon })),
  { label: 'Calcul de votre score', icon: 'target' },
  { label: 'Préparation de votre plan d’action', icon: 'sparkles' },
];
---

<section class="diag-stage" id="diagnostic">
  <div class="diag-bg" aria-hidden="true">
    <span class="orb o1"></span><span class="orb o2"></span><span class="grid"></span>
  </div>

  <div class="container diag" data-diag>
    <!-- ============ 1. Accueil ============ -->
    <div class="screen s-intro is-active" data-screen="intro">
      <div class="intro-copy">
        <nav class="crumbs" aria-label="Fil d’Ariane">
          <a href="/"><Icon name="arrowLeft" size={15} strokeWidth={2} /> Accueil</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Diagnostic de gestion</span>
        </nav>
        <p class="eyebrow">Diagnostic gratuit · 3 minutes</p>
        <h1>Votre gestion est-elle vraiment <em>sous contrôle</em> ?</h1>
        <p class="intro-lead">
          12 questions simples sur votre <strong>trésorerie</strong>, votre <strong>facturation</strong>,
          votre <strong>organisation</strong> et votre <strong>pilotage</strong>. Obtenez immédiatement votre score de gestion
          et un plan d’action personnalisé.
        </p>
        <ul class="intro-facts">
          <li><Icon name="clock" size={17} /> 3 minutes</li>
          <li><Icon name="list" size={17} /> 12 questions</li>
          <li><Icon name="zap" size={17} /> Résultat immédiat</li>
          <li><Icon name="lock" size={17} /> Confidentiel</li>
        </ul>
        <div class="intro-actions">
          <button type="button" class="btn btn--lg" data-start>
            <span data-start-label>Commencer mon diagnostic</span>
            <Icon name="arrowRight" size={19} class="i-arrow" />
          </button>
          <button type="button" class="btn btn--ghost" data-restart-intro hidden>Recommencer à zéro</button>
        </div>
        <p class="intro-note">Gratuit et sans inscription pour découvrir votre score.</p>
        <noscript>
          <p class="intro-noscript">
            Le diagnostic nécessite JavaScript. Vous pouvez aussi
            <a href="/#rendez-vous">réserver directement un échange gratuit</a>.
          </p>
        </noscript>
      </div>

      <div class="intro-visual" aria-hidden="true">
        <div class="iv-dial">
          <svg viewBox="0 0 200 200">
            <defs>
              <linearGradient id="iv-grad" gradientUnits="userSpaceOnUse" x1="16" y1="0" x2="184" y2="0" gradientTransform="rotate(-135 100 100)">
                <stop offset="0" stop-color="#e97e0d"></stop>
                <stop offset="0.5" stop-color="#f6b55b"></stop>
                <stop offset="1" stop-color="#61193a"></stop>
              </linearGradient>
            </defs>
            <circle class="g-track" cx="100" cy="100" r="84" pathLength="100"></circle>
            <circle class="iv-value" cx="100" cy="100" r="84" pathLength="100" stroke="url(#iv-grad)"></circle>
          </svg>
          <div class="iv-center">
            <span class="iv-num"></span>
            <span class="iv-label">Score de gestion</span>
          </div>
        </div>
        {
          domains.map((d, i) => (
            <span class={`iv-chip c${i}`}>
              <span class="iv-chip-ic">
                <Icon name={d.icon} size={16} />
              </span>
              {d.short}
            </span>
          ))
        }
        <span class="iv-plan">
          <Icon name="sparkles" size={16} /> Plan d’action personnalisé
        </span>
      </div>
    </div>

    <!-- ============ 2. Questions ============ -->
    <div class="screen s-quiz" data-screen="quiz" hidden>
      <aside class="side" aria-label="Progression du diagnostic">
        <p class="side-title">Votre diagnostic</p>
        <ol class="side-list">
          <li class="side-item" data-side="profil">
            <span class="side-ring">
              <svg viewBox="0 0 44 44" class="sr"><circle cx="22" cy="22" r="19" pathLength="100"></circle><circle class="sr-fill" cx="22" cy="22" r="19" pathLength="100"></circle></svg>
              <Icon name="building" size={17} />
              <span class="side-done"><Icon name="check" size={12} strokeWidth={3.2} /></span>
            </span>
            <span class="side-txt">Votre entreprise<small data-side-count>0 / 1</small></span>
          </li>
          {
            domains.map((d) => (
              <li class="side-item" data-side={d.id}>
                <span class="side-ring">
                  <svg viewBox="0 0 44 44" class="sr">
                    <circle cx="22" cy="22" r="19" pathLength="100" />
                    <circle class="sr-fill" cx="22" cy="22" r="19" pathLength="100" />
                  </svg>
                  <Icon name={d.icon} size={17} />
                  <span class="side-done">
                    <Icon name="check" size={12} strokeWidth={3.2} />
                  </span>
                </span>
                <span class="side-txt">
                  {d.label}
                  <small data-side-count>0 / 3</small>
                </span>
              </li>
            ))
          }
        </ol>
        <p class="side-meta"><Icon name="clock" size={15} /><span data-remaining>Environ 3 minutes</span></p>
        <p class="side-meta"><Icon name="lock" size={15} /><span>Réponses confidentielles</span></p>
      </aside>

      <div class="quiz">
        <div class="quiz-top">
          <button type="button" class="link-btn" data-prev><Icon name="arrowLeft" size={16} /> Retour</button>
          <span class="quiz-count" data-count></span>
        </div>
        <div class="quiz-bar" aria-hidden="true"><span data-bar></span></div>

        <form class="quiz-form" data-quiz-form novalidate>
          <!-- Profil -->
          <fieldset class="q-step" data-qstep="profil">
            <legend class="q-title" tabindex="-1">
              <span class="q-domain"><Icon name="building" size={15} /> Pour commencer</span>
              Quelle est votre activité ?
            </legend>
            <div class="act-grid">
              {
                activites.map((a) => (
                  <label class="act">
                    <input type="radio" name="activite" value={a.value} />
                    <span class="act-box">
                      <span class="act-ic">
                        <Icon name={a.icon} size={22} />
                      </span>
                      <span class="act-label">{a.label}</span>
                    </span>
                  </label>
                ))
              }
            </div>
            <p class="q-sub">Combien de personnes travaillent dans l’entreprise ?</p>
            <div class="pills">
              {
                effectifs.map((e) => (
                  <label class="pill">
                    <input type="radio" name="effectif" value={e} />
                    <span>{e}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          {
            questions.map((q, i) => {
              const d = domainOf(q.domain);
              return (
                <fieldset class="q-step" data-qstep={q.id} data-domain={q.domain}>
                  <legend class="q-title" tabindex="-1">
                    <span class="q-domain">
                      <Icon name={d.icon} size={15} /> {d.label}
                    </span>
                    {q.text}
                  </legend>
                  <div class="answers">
                    {q.options.map((o, j) => (
                      <label class:list={['ans', { 'ans--na': o.score === null }]} style={`--j:${j}`}>
                        <input type="radio" name={q.id} value={j} />
                        <span class="ans-box">
                          <span class="ans-key">{keys[j]}</span>
                          <span class="ans-label">{o.label}</span>
                          <span class="ans-check">
                            <Icon name="check" size={13} strokeWidth={3.2} />
                          </span>
                        </span>
                      </label>
                    ))}
                  </div>
                  <div class="tip" data-tip>
                    <Image src={nadege} alt="" width={88} height={88} class="tip-avatar" loading="lazy" />
                    <div class="tip-bubble">
                      <span class="tip-typing" aria-hidden="true">
                        <i />
                        <i />
                        <i />
                      </span>
                      <p class="tip-text">
                        <strong>Bon à savoir</strong>
                        {q.tip}
                      </p>
                    </div>
                  </div>
                  <span class="sr-only">Question {i + 1} sur {total}</span>
                </fieldset>
              );
            })
          }

          <div class="quiz-nav">
            <span class="quiz-keys"><kbd>A</kbd><kbd>B</kbd><kbd>C</kbd><kbd>D</kbd> pour répondre au clavier</span>
            <button type="submit" class="btn" data-next disabled>
              <span data-next-label>Question suivante</span>
              <Icon name="arrowRight" size={18} class="i-arrow" />
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ============ 3. Analyse ============ -->
    <div class="screen s-analysis" data-screen="analysis" hidden>
      <div class="an-orb" aria-hidden="true">
        <span class="an-wave"></span><span class="an-wave"></span><span class="an-wave"></span>
        <span class="an-spin"></span>
        <span class="an-dash"></span>
        <span class="an-orbit o1"><i></i></span><span class="an-orbit o2"><i></i></span><span class="an-orbit o3"><i></i></span>
        <span class="an-core">
          {
            analysisSteps.map((s, i) => (
              <span class="an-ic" data-an-ic={i}>
                <Icon name={s.icon} size={34} />
              </span>
            ))
          }
          <span class="an-ic an-ic--done" data-an-ic="done">
            <Icon name="check" size={40} strokeWidth={2.6} />
          </span>
        </span>
        <span class="an-burst">{Array.from({ length: 12 }, (_, i) => <i style={`--a:${i * 30}deg`} />)}</span>
      </div>

      <p class="an-kicker" data-an-kicker>Analyse en cours</p>
      <h2 class="an-title" tabindex="-1">Je passe votre gestion <em>au crible</em></h2>
      <p class="an-thought" aria-hidden="true"><span data-thought></span><span class="caret"></span></p>

      <div class="an-progress" aria-hidden="true">
        <span class="an-track"><span data-an-bar></span></span>
        <span class="an-pct" data-an-pct>0 %</span>
      </div>

      <ol class="an-steps" aria-live="polite">
        {
          analysisSteps.map((s) => (
            <li class="an-step" data-an-step>
              <span class="st-ic">
                <span class="st-spin" />
                <svg viewBox="0 0 24 24" class="st-check">
                  <path d="M5 12.5l4.5 4.5L19 7.5" />
                </svg>
              </span>
              <span class="st-label">{s.label}</span>
              <span class="st-note" data-an-note />
            </li>
          ))
        }
      </ol>
    </div>

    <!-- ============ 4. Résultats ============ -->
    <div class="screen s-results" data-screen="results" hidden>
      <header class="r-head">
        <p class="eyebrow">Votre résultat</p>
        <h2 class="h2 r-title" tabindex="-1">Votre score de <em>gestion</em></h2>
        <p class="r-hint" data-activity-hint></p>
      </header>

      <div class="r-top">
        <!-- Jauge -->
        <div class="card r-gauge">
          <div class="g-wrap">
            <svg viewBox="0 0 200 200" class="g-svg" aria-hidden="true">
              <defs>
                <linearGradient id="g-grad" gradientUnits="userSpaceOnUse" x1="16" y1="0" x2="184" y2="0" gradientTransform="rotate(-135 100 100)">
                  <stop offset="0" stop-color="#e97e0d"></stop>
                  <stop offset="0.5" stop-color="#f6b55b"></stop>
                  <stop offset="1" stop-color="#61193a"></stop>
                </linearGradient>
                <filter id="g-glow" x="-50%" y="-50%" width="200%" height="200%">
                  <feGaussianBlur stdDeviation="3"></feGaussianBlur>
                </filter>
              </defs>
              {
                Array.from({ length: 31 }, (_, i) => {
                  const a = ((135 + i * 9) * Math.PI) / 180;
                  const big = i % 5 === 0;
                  const r1 = big ? 68 : 70;
                  return (
                    <line
                      class:list={['g-tick', { big }]}
                      x1={(100 + Math.cos(a) * r1).toFixed(2)}
                      y1={(100 + Math.sin(a) * r1).toFixed(2)}
                      x2={(100 + Math.cos(a) * 73).toFixed(2)}
                      y2={(100 + Math.sin(a) * 73).toFixed(2)}
                    />
                  );
                })
              }
              <circle class="g-track" cx="100" cy="100" r="84" pathLength="100"></circle>
              <circle class="g-value" cx="100" cy="100" r="84" pathLength="100" stroke="url(#g-grad)" data-g-value></circle>
              <circle class="g-dot-glow" r="9" cx="100" cy="100" filter="url(#g-glow)" data-g-glow></circle>
              <circle class="g-dot" r="6.5" cx="100" cy="100" data-g-dot></circle>
            </svg>
            <div class="g-center">
              <span class="g-num"><span data-score>0</span><small>/100</small></span>
              <span class="g-caption">Score global</span>
            </div>
            <span class="g-burst" aria-hidden="true">{Array.from({ length: 14 }, (_, i) => <i style={`--a:${i * (360 / 14)}deg`} />)}</span>
          </div>
          <p class="g-level" data-level></p>
          <p class="g-text" data-level-text></p>
        </div>

        <!-- Radar -->
        <div class="card r-radar">
          <p class="card-kicker">Vos 12 réponses en un coup d’œil</p>
          <svg viewBox="-210 -160 420 320" class="radar" role="img" aria-label="Radar des 4 domaines de gestion" data-radar>
            {domains.map((_, d) => <path d={wedge(d)} class={`rd-wedge w${d}`} />)}
            {[0.25, 0.5, 0.75, 1].map((f) => <polygon points={ring(f)} class="rd-ring" />)}
            {questions.map((_, i) => <line x1="0" y1="0" x2={pt(i, R)[0]} y2={pt(i, R)[1]} class="rd-spoke" />)}
            <polygon class="rd-shape" points={ring(0.01)} data-radar-shape></polygon>
            {questions.map(() => <circle r="4.5" class="rd-pt" data-radar-pt />)}
            {
              domains.map((d, i) => {
                const [x, y] = labelPos(i);
                const anchor = x > 0 ? 'start' : 'end';
                return (
                  <text x={x} y={y} text-anchor={anchor} class="rd-label">
                    <tspan x={x} dy="0">
                      {d.short}
                    </tspan>
                    <tspan x={x} dy="17" class="rd-pct" data-radar-pct={d.id}>
                      –
                    </tspan>
                  </text>
                );
              })
            }
          </svg>
        </div>
      </div>

      <!-- Chiffres clés -->
      <ul class="r-kpis">
        <li class="kpi">
          <span class="kpi-ic"><Icon name="clock" size={20} /></span>
          <span class="kpi-num" data-kpi="hours">–</span>
          <span class="kpi-label">par mois consacrées à l’administratif</span>
        </li>
        <li class="kpi">
          <span class="kpi-ic"><Icon name="checkCircle" size={20} /></span>
          <span class="kpi-num" data-kpi="strengths">–</span>
          <span class="kpi-label" data-kpi-label="strengths">points forts</span>
        </li>
        <li class="kpi">
          <span class="kpi-ic"><Icon name="target" size={20} /></span>
          <span class="kpi-num" data-kpi="todo">–</span>
          <span class="kpi-label" data-kpi-label="todo">axes d’amélioration</span>
        </li>
      </ul>

      <!-- Domaines -->
      <div class="r-domains">
        {
          domains.map((d, i) => (
            <div class="dom" data-dom={d.id} style={`--i:${i}`}>
              <span class="dom-ic">
                <Icon name={d.icon} size={22} />
              </span>
              <div class="dom-body">
                <div class="dom-head">
                  <h3>{d.label}</h3>
                  <span class="dom-badge" data-dom-badge />
                  <span class="dom-pct" data-dom-pct>
                    0 %
                  </span>
                </div>
                <span class="dom-bar">
                  <span data-dom-bar />
                </span>
                <p class="dom-text" data-dom-text />
              </div>
            </div>
          ))
        }
      </div>

      <div class="r-strengths" data-strengths-wrap hidden>
        <p class="card-kicker">Vos points forts</p>
        <ul data-strengths></ul>
      </div>

      <!-- Plan d'action -->
      <div class="plan" data-plan-wrap>
        <header class="plan-head">
          <span class="plan-head-ic"><Icon name="flag" size={22} /></span>
          <div>
            <h3>Votre plan d’action personnalisé</h3>
            <p data-plan-sub></p>
          </div>
        </header>
        <ol class="plan-list" data-plan></ol>

        <!-- Déblocage -->
        <div class="lock" data-lock>
          <div class="lock-ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="lock-svg">
              <rect x="4" y="11" width="16" height="10" rx="2.5"></rect>
              <path class="lock-shackle" d="M8 11V7a4 4 0 0 1 8 0v4"></path>
            </svg>
          </div>
          <h3 class="lock-title" data-lock-title>Débloquez votre plan d’action complet</h3>
          <p class="lock-text">
            Recevez toutes vos recommandations, classées par priorité, et la possibilité d’en parler lors d’un <strong>bilan offert de 30 minutes</strong>.
          </p>
          <form action={site.formspree} method="POST" class="lead" novalidate data-lead-form>
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
            <div class="lead-fields">
              <div class="lf">
                <input type="text" id="d-nom" name="nom" required autocomplete="name" placeholder=" " />
                <label for="d-nom">Prénom et nom *</label>
                <Icon name="user" size={18} class="lf-ic" />
              </div>
              <div class="lf">
                <input type="email" id="d-email" name="email" required autocomplete="email" placeholder=" " />
                <label for="d-email">Adresse e-mail *</label>
                <Icon name="mail" size={18} class="lf-ic" />
              </div>
              <div class="lf">
                <input type="tel" id="d-tel" name="telephone" autocomplete="tel" inputmode="tel" pattern="[0-9+().\s-]{10,}" placeholder=" " />
                <label for="d-tel">Téléphone (facultatif)</label>
                <Icon name="phone" size={18} class="lf-ic" />
              </div>
              <div class="lf">
                <input type="text" id="d-entreprise" name="entreprise" autocomplete="organization" placeholder=" " />
                <label for="d-entreprise">Entreprise (facultatif)</label>
                <Icon name="building" size={18} class="lf-ic" />
              </div>
            </div>
            <label class="check">
              <input type="checkbox" name="bilan_offert" value="Oui" />
              <span class="check-box"><Icon name="check" size={13} strokeWidth={3.2} /></span>
              <span>Je souhaite être recontacté(e) pour un <strong>bilan offert de 30 minutes</strong>.</span>
            </label>
            <label class="check">
              <input type="checkbox" name="consentement" value="Oui" required />
              <span class="check-box"><Icon name="check" size={13} strokeWidth={3.2} /></span>
              <span>
                J’accepte que mes réponses et mes coordonnées soient transmises à {site.name} pour recevoir mon plan
                d’action et être recontacté(e) à ce sujet, conformément à la <a href="/confidentialite.html">politique de confidentialité</a>. *
              </span>
            </label>
            <p class="lead-error" data-lead-error></p>
            <button type="submit" class="btn btn--lg lead-btn" data-lead-btn>
              <span class="spinner" aria-hidden="true"></span>
              <span data-lead-label>Débloquer mon plan d’action</span>
              <Icon name="lock" size={18} class="i-arrow" />
            </button>
            <p class="lead-safe"><Icon name="shield" size={15} /> Aucune publicité, aucune revente : vos données restent entre nous.</p>
          </form>
        </div>
      </div>

      <!-- Après déblocage -->
      <div class="next" data-next-block hidden>
        <div class="next-card">
          <span class="next-glow" aria-hidden="true"></span>
          <Image src={nadege} alt={site.owner} width={160} height={160} class="next-photo" loading="lazy" />
          <p class="next-kicker" data-thanks>Merci !</p>
          <h3>Passons de l’analyse à l’<em>action</em></h3>
          <p>
            J’ai bien reçu votre diagnostic. Lors d’un <strong>bilan offert de 30 minutes</strong>, nous passons votre
            résultat en revue ensemble et nous fixons vos 3 premières actions. Sans engagement.
          </p>
          <div class="next-actions">
            <a href="/#rendez-vous" class="btn btn--soft">
              Réserver mon bilan offert <Icon name="calendar" size={18} />
            </a>
            <button type="button" class="btn btn--outline-light" data-print>
              <Icon name="printer" size={18} /> Imprimer / PDF
            </button>
          </div>
        </div>
      </div>

      <div class="r-foot">
        <a href="/#rendez-vous" class="link-btn" data-direct-cta>
          <Icon name="calendar" size={16} /> Vous préférez en parler directement ? Réservez un échange gratuit
        </a>
        <button type="button" class="link-btn" data-redo><Icon name="arrowLeft" size={16} /> Refaire le diagnostic</button>
      </div>
    </div>

    <!-- Icônes réutilisées par le plan d'action (copiées par le script) -->
    <div hidden data-icon-bank>
      {
        domains.map((d) => (
          <span data-icon={d.id}>
            <Icon name={d.icon} size={20} />
          </span>
        ))
      }
      <span data-icon="help"><Icon name="lightbulb" size={17} /></span>
      <span data-icon="check"><Icon name="check" size={13} strokeWidth={3.2} /></span>
    </div>
  </div>
</section>

<script>
  import { activites, domains, hoursPerWeek, levels, questions, type DomainId } from '../data/diagnostic';
  import { site } from '../data/site';

  const root = document.querySelector<HTMLElement>('[data-diag]');
  if (root) initDiagnostic(root);

  type State = {
    answers: Record<string, number>;
    activite?: string;
    effectif?: string;
    index: number;
    done?: boolean;
    unlocked?: boolean;
    name?: string;
  };
  type Level = 'high' | 'mid' | 'low';

  function initDiagnostic(root: HTMLElement) {
    const $ = <T extends Element = HTMLElement>(sel: string, el: ParentNode = root) => el.querySelector<T>(sel)!;
    const $$ = <T extends Element = HTMLElement>(sel: string, el: ParentNode = root) => [...el.querySelectorAll<T>(sel)];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise<void>((r) => window.setTimeout(r, ms));
    const KEY = 'sgc_diagnostic';

    const screens = $$('[data-screen]');
    const quizForm = $<HTMLFormElement>('[data-quiz-form]');
    const steps = $$<HTMLFieldSetElement>('[data-qstep]');
    const next = $<HTMLButtonElement>('[data-next]');
    const total = questions.length;
    const iconBank = $('[data-icon-bank]');
    const icon = (name: string) => iconBank.querySelector(`[data-icon="${name}"]`)?.innerHTML ?? '';

    let state: State = load() ?? { answers: {}, index: 0 };
    let run = 0; // identifie l'analyse en cours (annulée si l'on recommence)

    root.classList.add('is-ready');

    /* ================= Mémoire de la visite ================= */
    function load(): State | null {
      try {
        const s = JSON.parse(sessionStorage.getItem(KEY) ?? 'null');
        return s && typeof s === 'object' && s.answers ? (s as State) : null;
      } catch {
        return null;
      }
    }
    function save() {
      try {
        sessionStorage.setItem(KEY, JSON.stringify(state));
      } catch {
        /* stockage indisponible : sans conséquence */
      }
    }

    /* ================= Écrans ================= */
    function go(name: string) {
      screens.forEach((s) => {
        const on = s.dataset.screen === name;
        s.hidden = !on;
        s.classList.toggle('is-active', on);
      });
      root.dataset.view = name;
      const top = root.getBoundingClientRect().top + window.scrollY - 110;
      if (Math.abs(window.scrollY - top) > 40 && window.scrollY > top - 400) {
        window.scrollTo({ top: Math.max(0, top), behavior: reduce ? 'auto' : 'smooth' });
      }
    }

    /* ================= Accueil ================= */
    const startBtn = $<HTMLButtonElement>('[data-start]');
    const restartIntro = $<HTMLButtonElement>('[data-restart-intro]');
    const answeredCount = () => questions.filter((q) => state.answers[q.id] !== undefined).length;

    function refreshIntro() {
      const label = $('[data-start-label]');
      const started = state.index > 0 || answeredCount() > 0;
      restartIntro.hidden = !started;
      if (state.done) label.textContent = 'Voir mes résultats';
      else if (started) label.textContent = `Reprendre (question ${Math.max(1, state.index)} sur ${total})`;
      else label.textContent = 'Commencer mon diagnostic';
    }
    startBtn.addEventListener('click', () => {
      if (state.done) return showResults(false);
      go('quiz');
      showStep(state.index, 'next');
    });
    restartIntro.addEventListener('click', () => reset(true));

    function reset(start: boolean) {
      run++;
      const { unlocked, name } = state;
      state = { answers: {}, index: 0, unlocked, name };
      quizForm.reset();
      steps.forEach((s) => s.querySelector('[data-tip]')?.classList.remove('is-typing', 'is-shown'));
      save();
      refreshIntro();
      if (start) {
        go('quiz');
        showStep(0, 'next');
      } else go('intro');
    }

    /* ================= Questions ================= */
    const bar = $('[data-bar]');
    const count = $('[data-count]');
    const prev = $<HTMLButtonElement>('[data-prev]');
    const remaining = $('[data-remaining]');
    const sideItems = $$('[data-side]');

    function isAnswered(i: number) {
      if (i === 0) return !!state.activite && !!state.effectif;
      return state.answers[questions[i - 1].id] !== undefined;
    }

    function showStep(i: number, dir: 'next' | 'prev') {
      state.index = i;
      save();
      steps.forEach((s, k) => {
        s.classList.toggle('is-current', k === i);
        s.classList.remove('enter-next', 'enter-prev');
      });
      const step = steps[i];
      if (!reduce) {
        void step.offsetWidth;
        step.classList.add(`enter-${dir}`);
      }
      // Le conseil déjà lu reste affiché quand on revient sur une question
      const tip = step.querySelector('[data-tip]');
      if (tip && isAnswered(i)) tip.classList.add('is-shown');

      root.dataset.step = i === 0 ? 'profil' : 'question';
      count.innerHTML = i === 0 ? 'Pour commencer' : `Question <b>${i}</b> sur ${total}`;
      bar.style.transform = `scaleX(${i / total})`;
      next.disabled = !isAnswered(i);
      next.classList.remove('is-ready');
      $('[data-next-label]').textContent = i === total ? 'Découvrir mon résultat' : i === 0 ? 'Commencer' : 'Question suivante';
      const left = Math.round(((total - i + 1) * 13) / 60);
      remaining.textContent = left <= 1 ? 'Moins d’une minute' : `Encore environ ${left} minutes`;
      updateSide(i);
      step.querySelector<HTMLElement>('.q-title')?.focus({ preventScroll: true });
    }

    function updateSide(i: number) {
      const current = i === 0 ? 'profil' : questions[i - 1].domain;
      sideItems.forEach((item) => {
        const id = item.dataset.side!;
        let done = 0;
        let max = 1;
        if (id === 'profil') done = state.activite && state.effectif ? 1 : 0;
        else {
          const qs = questions.filter((q) => q.domain === id);
          max = qs.length;
          done = qs.filter((q) => state.answers[q.id] !== undefined).length;
        }
        item.style.setProperty('--p', String((done / max) * 100));
        item.classList.toggle('is-current', id === current);
        item.classList.toggle('is-complete', done === max);
        item.classList.toggle('has-progress', done > 0);
        item.querySelector('[data-side-count]')!.textContent = `${done} / ${max}`;
      });
    }

    quizForm.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      const i = state.index;
      if (input.name === 'activite') state.activite = input.value;
      else if (input.name === 'effectif') state.effectif = input.value;
      else {
        const first = state.answers[input.name] === undefined;
        state.answers[input.name] = Number(input.value);
        const tip = steps[i].querySelector('[data-tip]');
        if (tip && first && !reduce) {
          tip.classList.add('is-typing');
          window.setTimeout(() => {
            tip.classList.remove('is-typing');
            tip.classList.add('is-shown');
          }, 750);
        } else tip?.classList.add('is-shown');
      }
      save();
      updateSide(i);
      if (isAnswered(i) && next.disabled) {
        next.disabled = false;
        next.classList.add('is-ready');
      }
    });

    quizForm.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!isAnswered(state.index)) return;
      if (state.index < total) showStep(state.index + 1, 'next');
      else startAnalysis();
    });
    prev.addEventListener('click', () => {
      if (state.index === 0) {
        refreshIntro();
        go('intro');
      } else showStep(state.index - 1, 'prev');
    });

    // Clavier : A-E ou 1-5 pour répondre, Entrée pour continuer
    document.addEventListener('keydown', (e) => {
      if (root.dataset.view !== 'quiz' || e.ctrlKey || e.metaKey || e.altKey) return;
      const t = e.target as HTMLElement;
      if (t.matches('input[type="text"], input[type="email"], input[type="tel"], textarea')) return;
      const k = e.key.toLowerCase();
      const idx = 'abcde'.indexOf(k) >= 0 ? 'abcde'.indexOf(k) : '12345'.indexOf(k);
      if (idx < 0 || state.index === 0) return;
      const input = steps[state.index].querySelectorAll<HTMLInputElement>('input[type="radio"]')[idx];
      if (input) {
        e.preventDefault();
        input.click();
        input.focus({ preventScroll: true });
      }
    });

    function restoreInputs() {
      if (state.activite) quizForm.querySelector<HTMLInputElement>(`input[name="activite"][value="${state.activite}"]`)!.checked = true;
      if (state.effectif)
        quizForm.querySelectorAll<HTMLInputElement>('input[name="effectif"]').forEach((r) => (r.checked = r.value === state.effectif));
      Object.entries(state.answers).forEach(([id, v]) => {
        const input = quizForm.querySelector<HTMLInputElement>(`input[name="${id}"][value="${v}"]`);
        if (input) input.checked = true;
      });
    }

    /* ================= Calcul ================= */
    function levelOf(pct: number): Level {
      return pct >= 75 ? 'high' : pct >= 45 ? 'mid' : 'low';
    }
    function compute() {
      const items = questions.map((q) => {
        const opt = q.options[state.answers[q.id]];
        return { q, score: opt ? opt.score : null, answer: opt?.label ?? '—' };
      });
      const dom = domains.map((d) => {
        const own = items.filter((x) => x.q.domain === d.id && x.score !== null);
        const sum = own.reduce((a, x) => a + (x.score ?? 0), 0);
        const pct = own.length ? Math.round((sum / (own.length * 3)) * 100) : 100;
        return { d, pct, level: levelOf(pct), todo: own.filter((x) => (x.score ?? 3) < 3).length };
      });
      const pctOf = (id: DomainId) => dom.find((x) => x.d.id === id)!.pct;
      const global = Math.round(dom.reduce((a, x) => a + x.pct, 0) / dom.length);
      const level = levels.find((l) => global >= l.min)!;
      const todo = items
        .filter((x) => x.score !== null && x.score < 3)
        .sort((a, b) => a.score! - b.score! || pctOf(a.q.domain) - pctOf(b.q.domain));
      const strengths = items.filter((x) => x.score === 3);
      const t = state.answers.temps;
      const hours = t === undefined ? null : Math.round(hoursPerWeek[t] * 4.33);
      return { items, dom, global, level, todo, strengths, hours, pctOf };
    }
    type Result = ReturnType<typeof compute>;

    /* ================= Analyse animée ================= */
    const anSteps = $$('[data-an-step]');
    const anIcons = $$('[data-an-ic]');
    const anBar = $('[data-an-bar]');
    const anPct = $('[data-an-pct]');
    const thought = $('[data-thought]');
    const analysis = $('[data-screen="analysis"]');

    function thoughtsFor(r: Result) {
      const s = (id: string) => r.items.find((x) => x.q.id === id)?.score ?? 3;
      const list = ['Je relis vos réponses une à une…'];
      if (s('previsionnel') <= 1) list.push('Peu de visibilité sur la trésorerie : je prépare des repères simples…');
      if (s('delai') <= 1) list.push('Des délais de paiement longs : j’en mesure l’effet sur votre trésorerie…');
      if (s('impayes') <= 1) list.push('Des impayés anciens : je regarde comment les récupérer…');
      if (s('temps') <= 1) list.push('Beaucoup d’heures d’administratif : je repère ce qui peut être délégué…');
      if (s('efacture') <= 1) list.push('Facturation électronique : l’échéance de septembre 2027 approche…');
      if (s('tableau') <= 1) list.push('Je sélectionne les indicateurs les plus utiles pour votre activité…');
      return [
        ...list.slice(0, 3),
        'Je croise votre trésorerie avec vos habitudes de facturation…',
        'Je classe les actions selon leur impact et leur facilité…',
        'Je rédige votre plan d’action personnalisé…',
      ];
    }

    async function typeThoughts(lines: string[], id: number) {
      for (const line of lines) {
        if (id !== run) return;
        thought.textContent = '';
        for (let c = 1; c <= line.length; c++) {
          if (id !== run) return;
          thought.textContent = line.slice(0, c);
          await wait(18);
        }
        await wait(900);
      }
    }

    function setPct(to: number, ms: number) {
      const from = Number(anPct.dataset.v ?? 0);
      const t0 = performance.now();
      anBar.style.transform = `scaleX(${to / 100})`;
      const tick = (now: number) => {
        const k = Math.min(1, (now - t0) / ms);
        const v = Math.round(from + (to - from) * k);
        anPct.textContent = `${v} %`;
        anPct.dataset.v = String(v);
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }

    async function startAnalysis() {
      const id = ++run;
      const r = compute();
      go('analysis');
      analysis.classList.remove('is-done');
      $('[data-an-kicker]').textContent = 'Analyse en cours';
      anPct.dataset.v = '0';
      anBar.style.transform = 'scaleX(0)';
      anPct.textContent = '0 %';
      anSteps.forEach((s) => {
        s.classList.remove('is-active', 'is-done');
        s.querySelector('[data-an-note]')!.textContent = '';
      });
      $('.an-title', analysis).focus({ preventScroll: true });

      const notes = [
        `${answeredCount()} réponses`,
        ...r.dom.map((x) => (x.todo === 0 ? 'Point fort' : `${x.todo} point${x.todo > 1 ? 's' : ''} à améliorer`)),
        'Score calculé',
        r.todo.length ? `${r.todo.length} recommandation${r.todo.length > 1 ? 's' : ''}` : 'Aucune urgence',
      ];
      const dur = reduce ? 160 : 900;
      if (!reduce) typeThoughts(thoughtsFor(r), id);
      else thought.textContent = 'Je prépare votre résultat…';

      for (let k = 0; k < anSteps.length; k++) {
        if (id !== run) return;
        anSteps[k].classList.add('is-active');
        anIcons.forEach((ic) => ic.classList.toggle('is-on', ic.dataset.anIc === String(k)));
        setPct(Math.round(((k + 0.6) / anSteps.length) * 100), dur);
        await wait(dur);
        if (id !== run) return;
        anSteps[k].classList.remove('is-active');
        anSteps[k].classList.add('is-done');
        anSteps[k].querySelector('[data-an-note]')!.textContent = notes[k];
      }
      setPct(100, reduce ? 100 : 400);
      await wait(reduce ? 100 : 450);
      if (id !== run) return;
      anIcons.forEach((ic) => ic.classList.toggle('is-on', ic.dataset.anIc === 'done'));
      analysis.classList.add('is-done');
      $('[data-an-kicker]').textContent = 'Analyse terminée';
      thought.textContent = 'Votre résultat est prêt.';
      await wait(reduce ? 200 : 1300);
      if (id !== run) return;
      state.done = true;
      save();
      showResults(true);
    }

    /* ================= Résultats ================= */
    const results = $('[data-screen="results"]');
    const gValue = $<SVGCircleElement>('[data-g-value]');
    const gDot = $<SVGCircleElement>('[data-g-dot]');
    const gGlow = $<SVGCircleElement>('[data-g-glow]');
    const scoreEl = $('[data-score]');
    const levelLabel: Record<Level, string> = { high: 'Point fort', mid: 'À consolider', low: 'Prioritaire' };

    function setGauge(v: number) {
      gValue.style.strokeDasharray = `${(v * 0.75).toFixed(2)} 100`;
      const a = ((135 + v * 2.7) * Math.PI) / 180;
      const x = (100 + Math.cos(a) * 84).toFixed(2);
      const y = (100 + Math.sin(a) * 84).toFixed(2);
      [gDot, gGlow].forEach((c) => {
        c.setAttribute('cx', x);
        c.setAttribute('cy', y);
      });
      scoreEl.textContent = String(Math.round(v));
    }

    function animateGauge(to: number) {
      const t0 = performance.now();
      const ms = 1900;
      const ease = (k: number) => 1 - Math.pow(1 - k, 4);
      const tick = (now: number) => {
        const k = Math.min(1, (now - t0) / ms);
        setGauge(to * ease(k));
        if (k < 1) requestAnimationFrame(tick);
        else results.classList.add('gauge-done');
      };
      requestAnimationFrame(tick);
    }

    function showResults(animate: boolean) {
      const r = compute();
      go('results');
      results.classList.remove('is-animated', 'gauge-done');

      // Score global et niveau
      $('[data-level]').textContent = r.level.label;
      $('[data-level]').dataset.level = levelOf(r.global);
      $('[data-level-text]').textContent = r.level.text;
      const act = activites.find((a) => a.value === state.activite);
      $('[data-activity-hint]').textContent = act?.hint ?? '';

      // Chiffres clés
      $('[data-kpi="hours"]').textContent = r.hours === null ? '–' : `≈ ${r.hours} h`;
      $('[data-kpi="strengths"]').textContent = String(r.strengths.length);
      $('[data-kpi-label="strengths"]').textContent = r.strengths.length > 1 ? 'points forts' : 'point fort';
      $('[data-kpi="todo"]').textContent = String(r.todo.length);
      $('[data-kpi-label="todo"]').textContent = r.todo.length > 1 ? 'axes d’amélioration' : 'axe d’amélioration';

      // Domaines
      r.dom.forEach((x) => {
        const row = $(`[data-dom="${x.d.id}"]`);
        row.dataset.level = x.level;
        row.style.setProperty('--pct', `${x.pct}%`);
        $('[data-dom-badge]', row).textContent = levelLabel[x.level];
        $('[data-dom-pct]', row).textContent = `${x.pct} %`;
        $('[data-dom-text]', row).textContent = x.d.comments[x.level];
        $(`[data-radar-pct="${x.d.id}"]`).textContent = `${x.pct} %`;
      });

      // Radar (une branche par question ; « non concerné » = moyenne du domaine)
      const R = 115;
      const coords = r.items.map((x, i) => {
        const s = x.score ?? (r.pctOf(x.q.domain) / 100) * 3;
        const rr = R * (0.12 + 0.88 * (s / 3));
        const a = ((i * 30 - 90) * Math.PI) / 180;
        return [Math.cos(a) * rr, Math.sin(a) * rr];
      });
      $('[data-radar-shape]').setAttribute('points', coords.map((c) => c.map((v) => v.toFixed(1)).join(',')).join(' '));
      $$<SVGCircleElement>('[data-radar-pt]').forEach((c, i) => {
        c.setAttribute('cx', coords[i][0].toFixed(1));
        c.setAttribute('cy', coords[i][1].toFixed(1));
        c.style.setProperty('--i', String(i));
        const sc = r.items[i].score;
        c.dataset.level = sc === null ? 'na' : sc === 3 ? 'high' : sc === 2 ? 'mid' : 'low';
      });

      // Points forts
      const strengths = $('[data-strengths]');
      strengths.replaceChildren(
        ...r.strengths.map((x) => {
          const li = document.createElement('li');
          li.innerHTML = `<span class="sf-ic">${icon('check')}</span>`;
          li.append(x.q.strength);
          return li;
        }),
      );
      $('[data-strengths-wrap]').hidden = r.strengths.length === 0;

      buildPlan(r);
      applyLock(false);

      $('.r-title', results).focus({ preventScroll: true });
      if (animate && !reduce) {
        setGauge(0);
        requestAnimationFrame(() => {
          results.classList.add('is-animated');
          window.setTimeout(() => animateGauge(r.global), 350);
        });
      } else {
        setGauge(r.global);
        results.classList.add('is-animated', 'gauge-done');
      }
    }

    /* ================= Plan d'action ================= */
    const plan = $('[data-plan]');
    const lock = $('[data-lock]');
    const nextBlock = $('[data-next-block]');

    function buildPlan(r: Result) {
      const sub = $('[data-plan-sub]');
      if (!r.todo.length) {
        sub.textContent = 'Aucun point faible majeur : bravo !';
        const li = document.createElement('li');
        li.className = 'plan-item plan-item--great';
        li.innerHTML = `<div class="pi-head"><span class="pi-ic">${icon('help')}</span><div><p class="pi-domain">Pour aller plus loin</p><h4>Gagner encore du temps</h4></div></div><p class="pi-text">Votre gestion est bien tenue. Déléguer une partie de l’administratif peut vous libérer du temps pour développer votre activité, sans rien perdre en rigueur.</p>`;
        plan.replaceChildren(li);
        return;
      }
      sub.textContent = `${r.todo.length} action${r.todo.length > 1 ? 's' : ''} classée${r.todo.length > 1 ? 's' : ''} par ordre de priorité`;
      plan.replaceChildren(
        ...r.todo.map((x, k) => {
          const d = domains.find((dd) => dd.id === x.q.domain)!;
          const li = document.createElement('li');
          li.className = 'plan-item';
          li.dataset.level = x.score! <= 1 ? 'low' : 'mid';
          li.style.setProperty('--i', String(k));
          const rank = k < 3 ? `Priorité ${k + 1}` : 'À consolider';
          // Au-delà des 3 priorités : carte compacte, le conseil s'ouvre au clic
          if (k >= 3) li.classList.add('is-compact');
          li.innerHTML = `
            <span class="pi-rank">${rank}</span>
            <div class="pi-head"><span class="pi-ic">${icon(d.id)}</span><div><p class="pi-domain"></p><h4></h4></div></div>
            <p class="pi-answer"></p>
            <p class="pi-text"></p>
            <p class="pi-help"><span class="pi-help-ic">${icon('help')}</span><span></span></p>
            ${k >= 3 ? '<button type="button" class="pi-more" aria-expanded="false">Voir le conseil</button>' : ''}`;
          li.querySelector('.pi-domain')!.textContent = d.label;
          li.querySelector('h4')!.textContent = x.q.reco.title;
          li.querySelector('.pi-answer')!.textContent = `Votre réponse : « ${x.answer} »`;
          li.querySelector('.pi-text')!.textContent = x.q.reco.text;
          li.querySelector('.pi-help span:last-child')!.textContent = x.q.reco.help;
          li.querySelector('.pi-more')?.addEventListener('click', (ev) => {
            const btn = ev.currentTarget as HTMLButtonElement;
            const open = li.classList.toggle('is-open');
            btn.setAttribute('aria-expanded', String(open));
            btn.textContent = open ? 'Masquer le conseil' : 'Voir le conseil';
          });
          return li;
        }),
      );
    }

    function applyLock(animated: boolean) {
      const items = $$('.plan-item', plan);
      const locked = !state.unlocked;
      const hidden = Math.max(0, items.length - 1);
      root.classList.toggle('is-locked', locked);
      items.forEach((li, k) => {
        const off = locked && k > 0;
        li.classList.toggle('is-blurred', off);
        li.toggleAttribute('inert', off);
        if (off) li.setAttribute('aria-hidden', 'true');
        else li.removeAttribute('aria-hidden');
      });
      $('[data-lock-title]').textContent =
        hidden > 0
          ? `Débloquez ${hidden > 1 ? `les ${hidden} autres recommandations` : 'la seconde recommandation'} de votre plan`
          : 'Recevez votre plan d’action et un bilan offert';
      lock.hidden = !locked;
      nextBlock.hidden = locked;
      $('[data-direct-cta]').hidden = !locked;
      if (!locked) $('[data-thanks]').textContent = state.name ? `Merci ${state.name} !` : 'Merci !';
      if (animated) {
        root.classList.add('just-unlocked');
        window.setTimeout(() => root.classList.remove('just-unlocked'), 2400);
      }
    }

    /* ================= Envoi des coordonnées ================= */
    const lead = $<HTMLFormElement>('[data-lead-form]');
    const leadBtn = $<HTMLButtonElement>('[data-lead-btn]');
    const leadError = $('[data-lead-error]');

    lead.addEventListener('submit', async (e) => {
      e.preventDefault();
      lead.classList.add('was-validated');
      if (!lead.checkValidity()) {
        leadError.textContent = 'Merci d’indiquer votre nom, une adresse e-mail valide et d’accepter la transmission de vos réponses.';
        leadError.classList.add('is-visible');
        lead.querySelector<HTMLElement>('input:invalid')?.focus();
        return;
      }
      leadError.classList.remove('is-visible');
      const r = compute();
      const data = new FormData(lead);
      const nom = String(data.get('nom') ?? '').trim();
      const act = activites.find((a) => a.value === state.activite);
      data.set('_subject', `Diagnostic — ${nom} — ${r.global}/100 (${r.level.label})`);
      data.set('origine', 'Diagnostic de gestion en ligne');
      data.set('activite', act?.label ?? '');
      data.set('effectif', state.effectif ?? '');
      data.set('score_global', `${r.global}/100 — ${r.level.label}`);
      r.dom.forEach((x) => data.set(`score_${x.d.id}`, `${x.pct} % (${levelLabel[x.level]})`));
      data.set('heures_admin_par_mois', r.hours === null ? '' : `≈ ${r.hours} h`);
      data.set('priorites', r.todo.slice(0, 3).map((x, k) => `${k + 1}. ${x.q.reco.title}`).join(' · ') || 'Aucune');
      data.set('reponses', r.items.map((x) => `• ${x.q.text}\n   → ${x.answer}`).join('\n'));
      if (!data.get('bilan_offert')) data.set('bilan_offert', 'Non');

      leadBtn.disabled = true;
      leadBtn.classList.add('is-loading');
      $('[data-lead-label]').textContent = 'Envoi en cours…';
      try {
        const res = await fetch(lead.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error('Envoi refusé');
        state.unlocked = true;
        state.name = nom.split(/\s+/)[0];
        save();
        lock.classList.add('is-opening');
        await wait(reduce ? 0 : 700);
        lock.classList.remove('is-opening');
        applyLock(true);
        $('.plan-head h3').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      } catch {
        leadError.textContent = `L’envoi n’a pas abouti. Merci de réessayer, ou écrivez-moi à ${site.emailLabel}.`;
        leadError.classList.add('is-visible');
      } finally {
        leadBtn.disabled = false;
        leadBtn.classList.remove('is-loading');
        $('[data-lead-label]').textContent = 'Débloquer mon plan d’action';
      }
    });

    $('[data-print]').addEventListener('click', () => window.print());
    $('[data-redo]').addEventListener('click', () => reset(true));

    /* ================= Démarrage ================= */
    restoreInputs();
    refreshIntro();
    root.dataset.view = 'intro';
  }
</script>

