---
import Icon from './Icon.astro';
import { formulas } from '../data/site';
---

<section id="formules" class="section formulas">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">Modes d’intervention</p>
      <h2 class="h2">Un accompagnement <em>sur&nbsp;mesure</em>, à votre rythme</h2>
      <p set:html={formulas.intro} />
    </header>

    <div class="f-grid" data-carousel>
      {
        formulas.items.map((f, i) => (
          <article class="card formula" data-reveal style={`--d:${i}`}>
            <span class="icon-tile">
              <Icon name={f.icon} />
            </span>
            <p class="f-for">{f.for}</p>
            <h3>{f.title}</h3>
            <p class="f-text" set:html={f.text} />
            <p class="f-billing">
              <Icon name="file" size={15} />
              {f.billing}
            </p>
          </article>
        ))
      }
    </div>

    <ul class="terms" data-reveal>
      {
        formulas.terms.map((t) => (
          <li>
            <Icon name="checkCircle" size={18} />
            {t}
          </li>
        ))
      }
    </ul>

    <div class="f-cta" data-reveal>
      <a href="#devis" class="btn">
        Demander un devis personnalisé <Icon name="arrowRight" size={18} class="i-arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .formulas {
    background:
      radial-gradient(45% 40% at 100% 0%, rgb(229 129 188 / 0.07), transparent 70%),
      linear-gradient(180deg, var(--white), var(--cream));
  }
  .f-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .formula {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .f-for {
    margin-top: 1.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--blue-700);
  }
  .formula h3 {
    margin: 0.35rem 0 0.8rem;
    font-size: 1.55rem;
  }
  .f-text {
    flex: 1;
    font-size: 0.97rem;
    color: var(--muted);
  }
  .f-billing {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--blue-700);
    background: var(--blue-50);
    border: 1px solid var(--blue-100);
  }
  .terms {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 2rem;
    margin-top: 2.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
  }
  .terms li {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
  }
  .terms :global(svg) {
    color: var(--success);
  }
  .f-cta {
    display: flex;
    justify-content: center;
    margin-top: 2.25rem;
  }
  @media (max-width: 960px) {
    .f-grid {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin-inline: auto;
    }
  }
</style>
