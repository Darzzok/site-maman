---
/** Couverture graphique d'un article, aux couleurs de son thème */
import Icon from './Icon.astro';
import { categories, type Category } from '../utils/conseils';

interface Props {
  category: Category;
  size?: 'sm' | 'lg';
  class?: string;
}
const { category, size = 'sm', class: className } = Astro.props;
const meta = categories[category];
---

<div class:list={['cover', `tone-${meta.tone}`, `cover--${size}`, className]} aria-hidden="true">
  <svg class="cover-lines" viewBox="0 0 400 200" preserveAspectRatio="none">
    <path d="M0 160 C 70 150, 110 110, 170 118 S 270 70, 330 60 S 380 36, 400 30"></path>
    <path d="M0 185 C 80 180, 140 160, 200 162 S 300 130, 360 122 S 390 110, 400 108"></path>
  </svg>
  <span class="cover-icon"><Icon name={meta.icon} size={size === 'lg' ? 150 : 96} strokeWidth={0.9} /></span>
  <span class="cover-chip"><Icon name={meta.icon} size={size === 'lg' ? 26 : 20} strokeWidth={1.8} /></span>
</div>

<style>
  .cover {
    --c1: var(--blue-600);
    --c2: var(--blue-900);
    --glow: rgb(246 181 91 / 0.25);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(90% 120% at 100% 0%, var(--glow), transparent 60%),
      linear-gradient(140deg, var(--c1), var(--c2));
  }
  .tone-terra {
    --c1: var(--terra-400);
    --c2: var(--terra-700);
    --glow: rgb(255 255 255 / 0.28);
  }
  .tone-navy {
    --c1: var(--blue-800);
    --c2: var(--blue-950);
    --glow: rgb(246 181 91 / 0.6);
  }
  .tone-sage {
    --c1: var(--terra-300);
    --c2: var(--blue-700);
    --glow: rgb(251 217 168 / 0.35);
  }
  /* Quadrillage discret */
  .cover::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgb(255 255 255 / 0.22) 1px, transparent 1.3px);
    background-size: 16px 16px;
    mask-image: linear-gradient(110deg, transparent 20%, #000 90%);
  }
  .cover-lines {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    height: 70%;
  }
  .cover-lines path {
    fill: none;
    stroke: rgb(255 255 255 / 0.28);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .cover-lines path:last-child {
    stroke: rgb(255 255 255 / 0.16);
  }
  .cover-icon {
    position: absolute;
    right: -0.75rem;
    bottom: -1.25rem;
    color: rgb(255 255 255 / 0.22);
    transition:
      transform 1s var(--ease-out),
      color 0.5s;
  }
  .cover-chip {
    position: absolute;
    left: 1.1rem;
    top: 1.1rem;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    color: #fff;
    background: rgb(255 255 255 / 0.16);
    border: 1px solid rgb(255 255 255 / 0.28);
    backdrop-filter: blur(6px);
  }
  .cover--lg .cover-chip {
    width: 56px;
    height: 56px;
    border-radius: 18px;
    left: 1.6rem;
    top: 1.6rem;
  }
  .cover--lg .cover-icon {
    right: 0.5rem;
    bottom: -1.5rem;
  }
  /* Animation au survol de la carte parente */
  :global(.card:hover) .cover-icon {
    transform: rotate(-8deg) scale(1.08) translate(-6px, -6px);
    color: rgb(255 255 255 / 0.32);
  }
</style>
