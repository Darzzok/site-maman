---
import Icon from './Icon.astro';
import CollapseToggle from './CollapseToggle.astro';
import { cases } from '../data/site';
---

<section id="cas-clients" class="section cases">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">Cas clients</p>
      <h2 class="h2">Des résultats <em>concrets</em>, au service de mes clients</h2>
    </header>

    <div class="case-grid" id="cases-list" data-collapsible>
      {
        cases.map((c, i) => (
          <article class="card case" data-reveal style={`--d:${i % 3}`}>
            <div class="case-head">
              <span class="tag">
                <Icon name={c.icon} size={14} strokeWidth={2} />
                {c.tag}
              </span>
            </div>
            <h3>{c.title}</h3>
            <div class="case-block">
              <p class="label">La situation</p>
              <p class="problem">{c.problem}</p>
            </div>
            <div class="result">
              <span class="result-ic">
                <Icon name="check" size={16} strokeWidth={2.6} />
              </span>
              <div>
                <p class="label">Résultat</p>
                <p class="result-text">{c.result}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <CollapseToggle controls="cases-list" total={cases.length} more="Voir tous les cas clients" />

    <div class="cases-cta" data-reveal>
      <a href="#rendez-vous" class="btn">
        Prendre rendez-vous <Icon name="arrowRight" size={18} class="i-arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .cases {
    background:
      radial-gradient(45% 40% at 100% 0%, rgb(246 181 91 / 0.12), transparent 70%),
      var(--sand);
  }
  .case-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .case {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    text-align: center;
  }
  .case-head {
    display: flex;
    justify-content: center;
  }
  .case h3 {
    font-size: 1.32rem;
  }
  .label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .problem {
    margin-top: 0.35rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .case-block {
    flex: 1;
  }
  .result {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--success-bg), #f3faf6);
    border: 1px solid rgb(35 133 90 / 0.15);
    transition:
      transform 0.5s var(--ease-out),
      box-shadow 0.5s;
  }
  .case:hover .result {
    transform: scale(1.02);
    box-shadow: 0 12px 26px -14px rgb(35 133 90 / 0.55);
  }
  .result .label {
    color: var(--success);
  }
  .result-ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    color: #fff;
    background: var(--success);
    box-shadow: 0 6px 14px -6px rgb(35 133 90 / 0.8);
  }
  .result-text {
    margin-top: 0.15rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--ink);
  }
  .cases-cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (max-width: 1023px) {
    .case-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .case-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
