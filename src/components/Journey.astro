---
import Icon from './Icon.astro';
import { steps } from '../data/site';
---

<section id="parcours" class="section journey">
  <div class="journey-bg" aria-hidden="true">
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
  </div>

  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow eyebrow--dark">Votre parcours</p>
      <h2 class="h2">Du premier contact à la <em>réalisation</em> de votre demande</h2>
      <p>Un parcours simple, cadré et transparent, à chaque étape de notre collaboration.</p>
    </header>

    <div class="timeline" data-timeline data-orientation="horizontal">
      <div class="tl-track" aria-hidden="true">
        <div class="tl-fill"></div>
        <span class="tl-comet"></span>
      </div>

      <ol class="tl-steps">
        {
          steps.map((s, i) => (
            <li class="tl-step" data-step>
              <button type="button" class="tl-node" data-node aria-label={`Afficher l’étape ${i + 1} : ${s.title}`}>
                <span class="tl-node-ring" />
                <Icon name={s.icon} size={24} />
                <span class="tl-num">{String(i + 1).padStart(2, '0')}</span>
              </button>
              <div class="tl-card">
                <h3>{s.title}</h3>
                <p class="tl-text">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="tl-controls" data-reveal>
      <button type="button" class="tl-ctrl" data-tl-prev aria-label="Étape précédente">
        <Icon name="arrowLeft" size={18} />
      </button>
      <p class="tl-counter" aria-live="polite">
        Étape <strong data-tl-current>1</strong> sur {steps.length}
      </p>
      <button type="button" class="tl-ctrl" data-tl-next aria-label="Étape suivante">
        <Icon name="arrowRight" size={18} />
      </button>
      <button type="button" class="tl-ctrl tl-play" data-tl-play aria-pressed="false" aria-label="Mettre en pause le défilement automatique">
        <Icon name="pause" size={18} class="i-pause" />
        <Icon name="play" size={18} class="i-play" />
      </button>
    </div>
    <div class="tl-timer" aria-hidden="true"><span data-tl-timer></span></div>

    <div class="journey-cta" data-reveal>
      <a href="#rendez-vous" class="btn btn--soft">
        Commencer par l’étape 01 <Icon name="arrowRight" size={18} class="i-arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .journey {
    isolation: isolate;
    overflow: hidden;
    color: #fff;
    background: linear-gradient(180deg, var(--blue-950), var(--blue-900) 55%, var(--blue-950));
  }
  .journey-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(80% 70% at 50% 50%, #000 30%, transparent 85%);
  }
  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    animation: glow-drift 18s ease-in-out infinite alternate;
  }
  .glow-1 {
    width: 520px;
    height: 520px;
    top: -180px;
    left: -120px;
    background: rgb(229 129 188 / 0.18);
  }
  .glow-2 {
    width: 460px;
    height: 460px;
    bottom: -200px;
    right: -100px;
    background: rgb(246 181 91 / 0.12);
    animation-delay: -9s;
  }
  @keyframes glow-drift {
    to {
      transform: translate(80px, 40px) scale(1.15);
    }
  }
  .h2 {
    color: #fff;
  }
  .h2 em {
    color: var(--terra-300);
  }
  .section-head > p {
    color: #fff;
  }

  /* ========== Frise ========== */
  .timeline {
    position: relative;
    --p: 0;
  }
  .tl-steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .tl-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Piste + remplissage (positionnés en JS sur le centre des pastilles) */
  .tl-track {
    position: absolute;
    left: var(--tl-x, 10%);
    top: var(--tl-y, 36px);
    width: var(--tl-len, 80%);
    height: 3px;
    translate: 0 -50%;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.1);
  }
  .tl-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--blue-500), var(--blue-300) 45%, var(--terra-400));
    box-shadow: 0 0 16px rgb(246 181 91 / 0.25);
    transform-origin: left center;
    transform: scaleX(var(--p));
  }
  .tl-comet {
    position: absolute;
    top: 50%;
    left: calc(var(--p) * 100%);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    translate: -50% -50%;
    background: #fff;
    box-shadow:
      0 0 0 5px rgb(246 181 91 / 0.35),
      0 0 22px 4px rgb(246 181 91 / 0.4);
    opacity: clamp(0, calc(var(--p) * 30), 1);
  }
  .timeline[data-orientation='vertical'] .tl-track {
    width: 3px;
    height: var(--tl-len, 80%);
    translate: -50% 0;
  }
  .timeline[data-orientation='vertical'] .tl-fill {
    background: linear-gradient(180deg, var(--blue-500), var(--blue-300) 45%, var(--terra-400));
    transform-origin: center top;
    transform: scaleY(var(--p));
  }
  .timeline[data-orientation='vertical'] .tl-comet {
    top: calc(var(--p) * 100%);
    left: 50%;
  }

  /* Pastilles */
  .tl-node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    flex: none;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    color: rgb(255 255 255 / 0.45);
    background: var(--blue-900);
    border: 1.5px solid rgb(255 255 255 / 0.14);
    transition:
      color 0.5s,
      background 0.6s var(--ease-out),
      border-color 0.5s,
      box-shadow 0.6s,
      scale 0.7s var(--ease-spring);
  }
  .tl-node-ring {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 1.5px solid rgb(246 181 91 / 0.6);
    opacity: 0;
    scale: 0.7;
  }
  .tl-num {
    position: absolute;
    top: -6px;
    right: -6px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    font-size: 0.68rem;
    font-weight: 800;
    color: #fff;
    background: var(--blue-800);
    border: 2px solid var(--blue-950);
    transition:
      background 0.5s,
      color 0.5s;
  }
  .tl-step.is-active .tl-node {
    color: var(--blue-700);
    background: #fff;
    border-color: #fff;
    box-shadow:
      0 0 0 6px rgb(255 255 255 / 0.08),
      0 18px 40px -10px rgb(246 181 91 / 0.6);
    scale: 1.06;
  }
  .tl-step.is-active .tl-node-ring {
    animation: ring-pulse 1.4s var(--ease-out) 1;
  }
  .tl-step.is-active .tl-num {
    color: var(--blue-900);
    background: var(--terra-300);
  }
  @keyframes ring-pulse {
    0% {
      opacity: 1;
      scale: 0.8;
    }
    100% {
      opacity: 0;
      scale: 1.5;
    }
  }

  /* Cartes */
  .tl-card {
    position: relative;
    width: 100%;
    margin-top: 1.6rem;
    padding: 1.4rem 1.2rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.08);
    backdrop-filter: blur(8px);
    opacity: 0.35;
    translate: 0 14px;
    transition:
      opacity 0.7s var(--ease-out),
      translate 0.7s var(--ease-out),
      background 0.5s,
      border-color 0.5s,
      transform 0.5s var(--ease-out);
  }
  .tl-step.is-active .tl-card {
    opacity: 1;
    translate: none;
    background: rgb(255 255 255 / 0.07);
    border-color: rgb(255 255 255 / 0.14);
  }
  .tl-step.is-active .tl-card:hover {
    transform: translateY(-4px);
    background: rgb(255 255 255 / 0.1);
    border-color: rgb(246 181 91 / 0.45);
  }
  .tl-kicker {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--terra-400);
  }
  .tl-card h3 {
    margin-top: 0;
    font-size: 1.22rem;
    color: #fff;
  }
  .tl-text {
    margin-top: 0.55rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: #fff;
  }

  .journey-cta {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  /* ========== Navigation au clic ========== */
  .tl-node {
    padding: 0;
    cursor: pointer;
  }
  .tl-node:hover {
    border-color: rgb(255 255 255 / 0.5);
  }
  .tl-node:focus-visible {
    outline: 2px solid var(--blue-300);
    outline-offset: 4px;
  }
  /* La ligne glisse en douceur d'une étape à l'autre */
  .tl-fill {
    transition: transform 1.1s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .tl-comet {
    transition:
      left 1.1s cubic-bezier(0.65, 0, 0.35, 1),
      top 1.1s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.4s;
  }
  /* Lecture / pause */
  .tl-play :global(.i-play),
  .tl-play:global(.is-paused) :global(.i-pause) {
    display: none;
  }
  .tl-play:global(.is-paused) :global(.i-play) {
    display: block;
  }
  /* Barre de temps avant l'étape suivante */
  .tl-timer {
    width: 9rem;
    height: 3px;
    margin: 1rem auto 0;
    border-radius: 3px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.12);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .tl-timer span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: var(--terra-300);
    transform-origin: left center;
    transform: scaleX(0);
  }
  .journey:has(:global(.timeline.is-playing)) .tl-timer {
    opacity: 1;
  }
  .journey:not(:has(:global(.timeline.is-playing))) .tl-timer span {
    animation-play-state: paused !important;
  }
  @keyframes tl-timer {
    to {
      transform: scaleX(1);
    }
  }
  .tl-step:global(.is-current) .tl-card {
    background: rgb(255 255 255 / 0.11);
    border-color: rgb(246 181 91 / 0.55);
    box-shadow: 0 20px 40px -24px rgb(0 0 0 / 0.6);
  }
  .tl-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 5vw, 3.25rem);
  }
  .tl-ctrl {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    color: #fff;
    border: 1.5px solid rgb(255 255 255 / 0.3);
    transition:
      background 0.3s,
      border-color 0.3s,
      opacity 0.3s,
      transform 0.4s var(--ease-out);
  }
  .tl-ctrl:hover:not(:disabled) {
    background: rgb(255 255 255 / 0.12);
    border-color: #fff;
    transform: scale(1.06);
  }
  .tl-ctrl:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .tl-counter {
    min-width: 8.5rem;
    text-align: center;
    font-size: 0.92rem;
    color: #fff;
  }
  .tl-counter strong {
    color: #fff;
  }

  /* ========== Mobile : frise verticale ========== */
  @media (max-width: 900px) {
    .tl-steps {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .tl-step {
      flex-direction: row;
      align-items: flex-start;
      gap: 1.1rem;
      text-align: left;
    }
    .tl-node {
      width: 58px;
      height: 58px;
    }
    .tl-card {
      margin-top: 0;
      translate: 18px 0;
      text-align: center;
    }
  }

  /* ============ Mobile : frise compacte (seule l'étape en cours détaille son texte) ============ */
  @media (max-width: 900px) and (prefers-reduced-motion: no-preference) {
    .tl-steps {
      gap: 0.9rem;
    }
    .tl-card {
      padding: 0.9rem 1.1rem;
    }
    .tl-step:not(:global(.is-current)) .tl-text {
      display: none;
    }
    .tl-step:global(.is-current) .tl-text {
      animation: tl-text-in 0.5s var(--ease-out);
    }
    @keyframes tl-text-in {
      from {
        opacity: 0;
        translate: 0 6px;
      }
    }
  }
</style>
