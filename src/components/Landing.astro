---
/**
 * Gabarit des pages "métiers" et "zones" (pages d'atterrissage pour le référencement).
 * Contenu : src/content/metiers/*.md et src/content/zones/*.md
 */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import ArticleCard from './ArticleCard.astro';
import nadege from '../assets/images/nadege.jpg';
import { cases, site, steps, zone } from '../data/site';
import { getConseils } from '../utils/conseils';
import { getMetiers, getZones, metierUrl, zoneUrl, plainTitle, type Metier, type ZoneEntry } from '../utils/landings';
import { breadcrumbLd, businessEntity, businessId, faqLd } from '../utils/seo';

interface Props {
  entry: Metier | ZoneEntry;
  kind: 'metier' | 'zone';
}
const { entry, kind } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

const isZone = kind === 'zone';
const zoneData = isZone ? (entry as ZoneEntry).data : null;
const url = isZone ? zoneUrl(entry.id) : metierUrl(entry.id);
const parent = isZone
  ? { name: 'Zone d’intervention', url: '/zone-intervention.html' }
  : { name: 'Métiers', url: '/metiers.html' };
const h1Plain = plainTitle(data.title);

const featuredCase = data.caseIndex !== undefined ? cases[data.caseIndex] : undefined;
const allConseils = await getConseils();
const related = data.related
  .map((slug) => allConseils.find((a) => a.id === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

// Maillage interne : une page métier renvoie vers les zones, une page zone vers les métiers
const metiers = await getMetiers();
const zones = await getZones();
const otherZones = zones.filter((z) => z.id !== entry.id);

const dept = zone.departments.find((d) => d.code === zoneData?.department);
const areaServed = isZone
  ? zoneData!.kind === 'ville'
    ? {
        '@type': 'City',
        name: data.name,
        containedInPlace: { '@type': 'AdministrativeArea', name: `${dept?.name} (${dept?.code})` },
      }
    : {
        '@type': 'AdministrativeArea',
        name: `${dept?.name} (${dept?.code})`,
        containsPlace: zoneData!.communes.map((c) => ({ '@type': 'City', name: c })),
      }
  : zone.departments.map((d) => ({ '@type': 'AdministrativeArea', name: `${d.name} (${d.code})` }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    businessEntity(),
    {
      '@type': 'Service',
      '@id': `${site.url}${url}#service`,
      name: h1Plain,
      serviceType: 'Gestion administrative et financière externalisée',
      description: data.description,
      url: `${site.url}${url}`,
      provider: { '@id': businessId },
      areaServed,
      ...(isZone ? {} : { audience: { '@type': 'BusinessAudience', audienceType: data.audience.join(', ') } }),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: data.tasksTitle,
        itemListElement: data.tasks.map((t) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: t.title, description: t.text },
        })),
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${site.url}${url}`,
      url: `${site.url}${url}`,
      name: data.seoTitle,
      description: data.description,
      inLanguage: 'fr-FR',
      isPartOf: { '@id': `${site.url}/#site` },
      about: { '@id': `${site.url}${url}#service` },
      primaryImageOfPage: `${site.url}/images/og-image.jpg`,
    },
    breadcrumbLd([{ name: 'Accueil', url: '/' }, parent, { name: data.name, url }]),
    faqLd(data.faq),
  ],
};

const trust = ['Premier échange offert', 'Sans engagement', 'Sur site ou à distance'];

// Lien de devis : l'activité est présélectionnée dans le formulaire en étapes
const activiteKey: Record<string, string> = {
  'artisans-btp': 'btp',
  'professions-de-sante': 'sante',
  'professions-liberales': 'liberal',
  'commerces-de-proximite': 'commerce',
};
const devisUrl = !isZone && activiteKey[entry.id] ? `/?activite=${activiteKey[entry.id]}#devis` : '/#devis';
---

<BaseLayout title={data.seoTitle} description={data.description} jsonLd={jsonLd}>
  <!-- ============ En-tête ============ -->
  <section class="l-hero">
    <div class="l-hero-bg" aria-hidden="true"><span></span><span></span></div>
    <div class="container l-hero-inner">
      <nav class="crumbs" aria-label="Fil d’Ariane">
        <a href="/">Accueil</a>
        <span aria-hidden="true">/</span>
        <a href={parent.url}>{parent.name}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{data.name}</span>
      </nav>
      <span class="hero-ic"><Icon name={data.icon} size={28} /></span>
      <p class="eyebrow">{data.eyebrow}</p>
      <h1 set:html={data.title} />
      <p class="lead">{data.lead}</p>
      <div class="hero-actions">
        <a href="/#rendez-vous" class="btn">
          Réserver un échange gratuit <Icon name="arrowRight" size={18} class="i-arrow" />
        </a>
        <a href={devisUrl} class="btn btn--ghost">Demander un devis</a>
      </div>
      <ul class="trust">
        {
          trust.map((t) => (
            <li>
              <Icon name="checkCircle" size={17} />
              {t}
            </li>
          ))
        }
      </ul>
      {
        data.audience.length > 0 && (
          <div class="audience">
            <p class="audience-title">{isZone ? 'Communes desservies' : 'Métiers accompagnés'}</p>
            <ul>
              {data.audience.map((a) => (
                <li>{a}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <!-- ============ Enjeux ============ -->
  <section class="section l-pains">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">{isZone ? 'Vos avantages' : 'Vos enjeux'}</p>
        <h2 class="h2">{data.painsTitle}</h2>
      </header>
      <ul class="pains-grid" data-carousel>
        {
          data.pains.map((p, i) => (
            <li class="card pain" data-reveal style={`--d:${i}`}>
              <span class="icon-tile">
                <Icon name={p.icon} />
              </span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ Prestations ============ -->
  <section class="section section--white l-tasks">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">Mes prestations</p>
        <h2 class="h2">{data.tasksTitle}</h2>
      </header>
      <ul class="tasks-grid" data-carousel>
        {
          data.tasks.map((t, i) => (
            <li class="task" data-reveal style={`--d:${i % 3}`}>
              <span class="task-ic">
                <Icon name="check" size={18} strokeWidth={2.4} />
              </span>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="more-link" data-reveal>
        <a href="/#services">Découvrir toutes mes prestations <Icon name="arrowRight" size={16} /></a>
      </p>
    </div>
  </section>

  <!-- ============ Texte de la page + cas client ============ -->
  <section class="section l-story">
    <div class="container story-grid">
      <article class="prose" data-reveal data-readmore="460">
        <Content />
      </article>
      {
        featuredCase && (
          <aside class="case" data-reveal="right">
            <p class="case-kicker">Exemple d’accompagnement</p>
            <span class="tag">
              <Icon name={featuredCase.icon} size={14} strokeWidth={2} />
              {featuredCase.tag}
            </span>
            <h3>{featuredCase.title}</h3>
            <p class="case-label">La situation</p>
            <p class="case-problem">{featuredCase.problem}</p>
            <div class="case-result">
              <span class="result-ic">
                <Icon name="check" size={16} strokeWidth={2.6} />
              </span>
              <p>{featuredCase.result}</p>
            </div>
            <a href="/#cas-clients" class="case-link">
              Voir tous les cas clients <Icon name="arrowRight" size={16} />
            </a>
          </aside>
        )
      }
    </div>
  </section>

  <!-- ============ Méthode ============ -->
  <section class="section section--sand l-steps">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">Méthode</p>
        <h2 class="h2">Un accompagnement <em>simple</em>, étape par étape</h2>
      </header>
      <ol class="steps" data-carousel>
        {
          steps.map((s, i) => (
            <li class="step" data-reveal style={`--d:${i}`}>
              <span class="step-ic">
                <Icon name={s.icon} size={22} />
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ Maillage : zones ou métiers ============ -->
  <section class="section l-cross">
    <div class="container">
      {
        isZone ? (
          <>
            <header class="section-head" data-reveal>
              <p class="eyebrow">Métiers</p>
              <h2 class="h2">
                Les métiers que j’accompagne {zoneData!.kind === 'ville' ? 'à' : 'en'} <em>{data.name.replace(/ \(\d+\)$/, '')}</em>
              </h2>
            </header>
            <ul class="cross-grid" data-carousel>
              {metiers.map((m, i) => (
                <li data-reveal style={`--d:${i}`}>
                  <a href={metierUrl(m.id)} class="cross-card">
                    <span class="icon-tile">
                      <Icon name={m.data.icon} />
                    </span>
                    <span class="cross-name">{m.data.name}</span>
                    <span class="cross-text">{m.data.cardText}</span>
                    <span class="cross-more">
                      Découvrir <Icon name="arrowRight" size={15} />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="zone-links" data-reveal>
              <p>J’interviens aussi :</p>
              <ul>
                {otherZones.map((z) => (
                  <li>
                    <a href={zoneUrl(z.id)}>
                      <Icon name="mapPin" size={15} />
                      {z.data.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </>
        ) : (
          <>
            <header class="section-head" data-reveal>
              <p class="eyebrow">Zone d’intervention</p>
              <h2 class="h2">
                Partout dans l’<em>Eure</em> et la <em>Seine-Maritime</em>
              </h2>
              <p>
                J’accompagne les {data.name.charAt(0).toLowerCase() + data.name.slice(1)} dans toute la Normandie, dans vos locaux ou à distance.
              </p>
            </header>
            <ul class="zone-cards">
              {zones.map((z, i) => (
                <li data-reveal style={`--d:${i % 5}`}>
                  <a href={zoneUrl(z.id)} class="zone-card">
                    <Icon name="mapPin" size={18} />
                    <span>
                      <strong>{z.data.name}</strong>
                      <small>{z.data.kind === 'ville' ? 'et ses environs' : 'tout le département'}</small>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="zone-links" data-reveal>
              <p>Autres métiers accompagnés :</p>
              <ul>
                {metiers
                  .filter((m) => m.id !== entry.id)
                  .map((m) => (
                    <li>
                      <a href={metierUrl(m.id)}>
                        <Icon name={m.data.icon} size={15} />
                        {m.data.name}
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          </>
        )
      }
    </div>
  </section>

  <!-- ============ Questions ============ -->
  <section class="section section--white l-faq">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">Questions fréquentes</p>
        <h2 class="h2">Vos <em>questions</em>, mes réponses</h2>
      </header>
      <div class="faq-list">
        {
          data.faq.map((f, i) => (
            <details class="faq-item" data-reveal style={`--d:${i % 4}`} open={i === 0}>
              <summary>
                <span class="q-text">{f.q}</span>
                <span class="q-toggle" aria-hidden="true">
                  <span />
                  <span />
                </span>
              </summary>
              <div class="answer">
                <p set:html={f.a} />
              </div>
            </details>
          ))
        }
      </div>
      <p class="more-link" data-reveal>
        <a href="/faq.html">Toutes les questions fréquentes <Icon name="arrowRight" size={16} /></a>
      </p>
    </div>
  </section>

  <!-- ============ Articles ============ -->
  {
    related.length > 0 && (
      <section class="section l-related">
        <div class="container">
          <header class="section-head" data-reveal>
            <p class="eyebrow">Conseils</p>
            <h2 class="h2">
              Pour aller <em>plus loin</em>
            </h2>
          </header>
          <div class="related-grid" data-carousel>
            {related.map((a, i) => (
              <ArticleCard entry={a} delay={i} headingLevel="h3" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ============ Appel à l'action ============ -->
  <section class="l-cta">
    <div class="container">
      <div class="cta-card" data-reveal>
        <div class="cta-glow" aria-hidden="true"></div>
        <Image src={nadege} alt={site.owner} width={176} height={176} class="cta-photo" loading="lazy" />
        <p class="eyebrow">{site.owner}</p>
        <h2>Parlons de votre <em>entreprise</em></h2>
        <p class="cta-text">
          Un premier échange gratuit de 30 minutes pour faire le point sur votre situation{isZone ? ` à ${data.name.replace(/ \(\d+\)$/, '')}` : ''}, sans engagement.
        </p>
        <div class="cta-actions">
          <a href="/#rendez-vous" class="btn">
            Réserver un échange gratuit <Icon name="arrowRight" size={18} class="i-arrow" />
          </a>
          <a href={devisUrl} class="btn btn--ghost">
            <Icon name="file" size={18} /> Demander un devis
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============ En-tête ============ */
  .l-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: calc(var(--header-h) + 3.5rem) 0 clamp(3.5rem, 7vw, 5rem);
    text-align: center;
    background: linear-gradient(180deg, var(--cream), var(--sand));
  }
  .l-hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(97 25 58 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(97 25 58 / 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(70% 80% at 50% 20%, #000, transparent 80%);
  }
  .l-hero-bg span {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
  }
  .l-hero-bg span:first-child {
    width: 420px;
    height: 420px;
    top: -160px;
    right: -80px;
    background: rgb(246 181 91 / 0.18);
  }
  .l-hero-bg span:last-child {
    width: 380px;
    height: 380px;
    bottom: -220px;
    left: 5%;
    background: rgb(246 181 91 / 0.14);
  }
  .l-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 900px;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.6rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--muted);
  }
  .crumbs a {
    color: var(--blue-700);
  }
  .crumbs a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hero-ic {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: 1.2rem;
    border-radius: 20px;
    color: #fff;
    background: linear-gradient(135deg, var(--blue-500), var(--blue-800));
    box-shadow: 0 16px 32px -14px rgb(97 25 58 / 0.6);
  }
  h1 {
    margin-top: 1.1rem;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    letter-spacing: -0.02em;
  }
  .lead {
    max-width: 44rem;
    margin-top: 1.2rem;
    font-size: 1.12rem;
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.4rem;
    margin-top: 1.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
  }
  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .trust :global(svg) {
    color: var(--blue-600);
  }
  .audience {
    margin-top: 2.2rem;
  }
  .audience-title {
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .audience ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    max-width: 52rem;
    margin-top: 0.8rem;
  }
  .audience li {
    padding: 0.38rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--blue-700);
    background: rgb(255 255 255 / 0.8);
    border: 1px solid var(--blue-100);
  }

  /* ============ Enjeux ============ */
  .pains-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.1rem;
  }
  .pain {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .pain h3 {
    margin-top: 1rem;
    font-size: 1.2rem;
  }
  .pain p {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--muted);
  }

  /* ============ Prestations ============ */
  .tasks-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .task {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.6rem 1.4rem;
    text-align: center;
    border-radius: var(--radius);
    background: var(--cream);
    border: 1px solid var(--line);
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s,
      border-color 0.45s;
  }
  .task:hover {
    transform: translateY(-4px);
    border-color: var(--blue-200);
    box-shadow: var(--shadow-md);
  }
  .task-ic {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: #fff;
    background: var(--blue-700);
  }
  .task h3 {
    margin-top: 0.9rem;
    font-size: 1.15rem;
  }
  .task p {
    margin-top: 0.45rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .more-link {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .more-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    color: var(--blue-700);
    text-decoration: underline;
    text-decoration-color: var(--blue-200);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.3s;
  }
  .more-link a:hover {
    text-decoration-color: var(--blue-700);
  }

  /* ============ Texte + cas client ============ */
  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .prose {
    text-align: center;
    font-size: 1.06rem;
    line-height: 1.8;
    color: var(--text);
  }
  .prose :global(h2) {
    margin-top: 2.6rem;
    font-size: clamp(1.5rem, 2.6vw, 1.95rem);
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(p) {
    margin-top: 1rem;
  }
  .prose :global(h2 + p) {
    margin-top: 0.8rem;
  }
  .prose :global(ul) {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .prose :global(li::before) {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.6rem;
    vertical-align: 0.15em;
    border-radius: 50%;
    background: var(--blue-600);
  }
  .case {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.8rem 1.5rem;
    text-align: center;
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
  }
  .case-kicker {
    margin-bottom: 0.9rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue-700);
  }
  .case h3 {
    margin-top: 0.9rem;
    font-size: 1.35rem;
  }
  .case-label {
    margin-top: 1rem;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .case-problem {
    margin-top: 0.35rem;
    font-size: 0.95rem;
    color: var(--text);
  }
  .case-result {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    margin-top: 1.2rem;
    padding: 1rem;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, var(--rose-100), #fff);
    border: 1px solid rgb(246 181 91 / 0.35);
  }
  .result-ic {
