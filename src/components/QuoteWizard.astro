---
/**
 * Demande de devis en plusieurs étapes (envoi via Formspree).
 * Sans JavaScript, toutes les étapes s'affichent les unes sous les autres et le formulaire reste utilisable.
 * Pré-sélection possible depuis un lien : /?activite=btp#devis  ou  /?besoin=tresorerie#devis
 */
import Icon from './Icon.astro';
import { site } from '../data/site';

const besoins = [
  { value: 'tresorerie', label: 'Trésorerie & recouvrement', icon: 'wallet' },
  { value: 'administratif', label: 'Gestion administrative', icon: 'file' },
  { value: 'rh', label: 'RH & paie', icon: 'users' },
  { value: 'pilotage', label: 'Pilotage & tableaux de bord', icon: 'chart' },
  { value: 'patrimoine', label: 'Patrimoine du dirigeant', icon: 'shield' },
  { value: 'global', label: 'Je ne sais pas encore', icon: 'help' },
];
const activites = [
  { value: 'btp', label: 'Artisan du BTP', icon: 'hardhat' },
  { value: 'sante', label: 'Profession de santé', icon: 'stethoscope' },
  { value: 'liberal', label: 'Profession libérale', icon: 'briefcase' },
  { value: 'commerce', label: 'Commerce / artisan', icon: 'store' },
  { value: 'tpe', label: 'Autre TPE', icon: 'building' },
];
const effectifs = ['Seul(e)', '2 à 5', '6 à 10', 'Plus de 10'];
const departements = ['Eure (27)', 'Seine-Maritime (76)', 'Autre / à distance'];
const rythmes = [
  { value: 'Mission ponctuelle', label: 'Mission ponctuelle', icon: 'zap', text: 'Un besoin précis' },
  { value: 'Suivi régulier', label: 'Suivi régulier', icon: 'calendar', text: 'Chaque mois' },
  { value: 'Temps partagé', label: 'Temps partagé', icon: 'users', text: 'Déléguer sans recruter' },
  { value: 'À définir ensemble', label: 'À définir', icon: 'message', text: 'On en parle' },
];
const modalites = ['Sur site', 'À distance', 'Les deux'];
const delais = ['Dès que possible', 'Dans le mois', 'Dans les 3 mois', 'Je me renseigne'];

const steps = ['Besoins', 'Entreprise', 'Format', 'Coordonnées', 'Envoi'];
---

<div class="wizard" data-wizard>
  <!-- Progression -->
  <div class="progress" aria-hidden="true">
    <div class="progress-track"><span class="progress-fill" data-progress></span></div>
    <ol class="progress-steps">
      {
        steps.map((s, i) => (
          <li class:list={['p-step', { 'is-current': i === 0 }]} data-p-step>
            <span class="p-dot">
              <span class="p-num">{i + 1}</span>
              <Icon name="check" size={14} strokeWidth={3} class="p-check" />
            </span>
            <span class="p-label">{s}</span>
          </li>
        ))
      }
    </ol>
  </div>
  <p class="sr-only" aria-live="polite" data-step-announce></p>

  <form action={site.formspree} method="POST" class="q-form" novalidate data-quote-form>
    <input type="hidden" name="_subject" value={`Nouvelle demande de devis — ${site.name}`} data-subject />
    <!-- Piège à robots : laissé vide par les humains -->
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />

    <div class="viewport" data-viewport>
      <!-- Étape 1 : besoins -->
      <fieldset class="step is-current" data-step="0">
        <legend class="step-title" tabindex="-1">
          <span class="step-kicker">Étape 1 sur 5</span>
          De quoi avez-vous besoin ?
        </legend>
        <p class="step-sub">Plusieurs choix possibles.</p>
        <div class="opts opts--cards" data-group="besoins" data-min="1">
          {
            besoins.map((b) => (
              <label class="opt">
                <input type="checkbox" name="besoins" value={b.label} data-key={b.value} />
                <span class="opt-box">
                  <span class="opt-ic">
                    <Icon name={b.icon} size={20} />
                  </span>
                  <span class="opt-label">{b.label}</span>
                  <span class="opt-check">
                    <Icon name="check" size={12} strokeWidth={3.2} />
                  </span>
                </span>
              </label>
            ))
          }
        </div>
        <p class="step-error" data-error>Choisissez au moins un besoin pour continuer.</p>
      </fieldset>

      <!-- Étape 2 : entreprise -->
      <fieldset class="step" data-step="1">
        <legend class="step-title" tabindex="-1">
          <span class="step-kicker">Étape 2 sur 5</span>
          Parlez-moi de votre entreprise
        </legend>
        <p class="q-label">Votre activité</p>
        <div class="opts opts--cards opts--five" data-group="activite" data-min="1">
          {
            activites.map((a) => (
              <label class="opt">
                <input type="radio" name="activite" value={a.label} data-key={a.value} />
                <span class="opt-box">
                  <span class="opt-ic">
                    <Icon name={a.icon} size={20} />
                  </span>
                  <span class="opt-label">{a.label}</span>
                  <span class="opt-check">
                    <Icon name="check" size={12} strokeWidth={3.2} />
                  </span>
                </span>
              </label>
            ))
          }
        </div>
        <p class="q-label">Nombre de personnes dans l’entreprise</p>
        <div class="opts opts--pills" data-group="effectif" data-min="1">
          {
            effectifs.map((e) => (
              <label class="pill-opt">
                <input type="radio" name="effectif" value={e} />
                <span>{e}</span>
              </label>
            ))
          }
        </div>
        <p class="q-label">Où êtes-vous installé ?</p>
        <div class="opts opts--pills" data-group="departement" data-min="1">
          {
            departements.map((d) => (
              <label class="pill-opt">
                <input type="radio" name="departement" value={d} />
                <span><Icon name="mapPin" size={14} />{d}</span>
              </label>
            ))
          }
        </div>
        <p class="step-error" data-error>Merci de répondre aux trois questions.</p>
      </fieldset>

      <!-- Étape 3 : format -->
      <fieldset class="step" data-step="2">
        <legend class="step-title" tabindex="-1">
          <span class="step-kicker">Étape 3 sur 5</span>
          Quel accompagnement imaginez-vous ?
        </legend>
        <div class="opts opts--cards" data-group="rythme" data-min="1">
          {
            rythmes.map((r) => (
              <label class="opt">
                <input type="radio" name="rythme" value={r.value} />
                <span class="opt-box">
                  <span class="opt-ic">
                    <Icon name={r.icon} size={20} />
                  </span>
                  <span class="opt-label">{r.label}</span>
                  <span class="opt-text">{r.text}</span>
                  <span class="opt-check">
                    <Icon name="check" size={12} strokeWidth={3.2} />
                  </span>
                </span>
              </label>
            ))
          }
        </div>
        <p class="q-label">Modalité</p>
        <div class="opts opts--pills" data-group="modalite" data-min="1">
          {
            modalites.map((m) => (
              <label class="pill-opt">
                <input type="radio" name="modalite" value={m} />
                <span>{m}</span>
              </label>
            ))
          }
        </div>
        <p class="q-label">Pour quand ?</p>
        <div class="opts opts--pills" data-group="delai" data-min="1">
          {
            delais.map((d) => (
              <label class="pill-opt">
                <input type="radio" name="delai" value={d} />
                <span>{d}</span>
              </label>
            ))
          }
        </div>
        <p class="step-error" data-error>Merci de répondre aux trois questions.</p>
      </fieldset>

      <!-- Étape 4 : coordonnées -->
      <fieldset class="step" data-step="3">
        <legend class="step-title" tabindex="-1">
          <span class="step-kicker">Étape 4 sur 5</span>
          Comment vous recontacter ?
        </legend>
        <div class="fields">
          <div class="field half">
            <input type="text" id="q-nom" name="nom" required autocomplete="name" placeholder=" " />
            <label for="q-nom">Nom complet <span class="req">*</span></label>
            <span class="field-ic"><Icon name="user" size={18} /></span>
          </div>
          <div class="field half">
            <input type="text" id="q-entreprise" name="entreprise" autocomplete="organization" placeholder=" " />
            <label for="q-entreprise">Entreprise</label>
            <span class="field-ic"><Icon name="building" size={18} /></span>
          </div>
          <div class="field half">
            <input type="email" id="q-email" name="email" required autocomplete="email" placeholder=" " />
            <label for="q-email">Adresse e-mail <span class="req">*</span></label>
            <span class="field-ic"><Icon name="mail" size={18} /></span>
          </div>
          <div class="field half">
            <input
              type="tel"
              id="q-tel"
              name="telephone"
              required
              autocomplete="tel"
              inputmode="tel"
              pattern="[0-9+\(\)\.\s\-]{10,}"
              placeholder=" "
            />
            <label for="q-tel">Téléphone <span class="req">*</span></label>
            <span class="field-ic"><Icon name="phone" size={18} /></span>
          </div>
          <div class="field">
            <textarea id="q-message" name="message" rows="3" placeholder=" "></textarea>
            <label for="q-message">Précisez votre situation (facultatif)</label>
            <span class="field-ic top"><Icon name="message" size={18} /></span>
          </div>
        </div>
        <p class="q-label">Je préfère être recontacté par</p>
        <div class="opts opts--pills" data-group="preference">
          <label class="pill-opt">
            <input type="radio" name="preference_contact" value="Téléphone" checked />
            <span><Icon name="phone" size={14} />Téléphone</span>
          </label>
          <label class="pill-opt">
            <input type="radio" name="preference_contact" value="E-mail" />
            <span><Icon name="mail" size={14} />E-mail</span>
          </label>
        </div>
        <label class="consent">
          <input type="checkbox" name="consentement" value="Oui" required />
          <span class="consent-box"><Icon name="check" size={13} strokeWidth={3.2} /></span>
          <span>
            J’accepte que mes informations soient utilisées pour répondre à ma demande, conformément à la
            <a href="/confidentialite.html">politique de confidentialité</a>. <span class="req">*</span>
          </span>
        </label>
        <p class="step-error" data-error>Merci de compléter les champs obligatoires.</p>
      </fieldset>

      <!-- Étape 5 : récapitulatif -->
      <fieldset class="step" data-step="4">
        <legend class="step-title" tabindex="-1">
          <span class="step-kicker">Étape 5 sur 5</span>
          Vérifiez votre demande
        </legend>
        <dl class="recap" data-recap></dl>
        <p class="recap-note">
          <Icon name="lock" size={15} /><span>Vos informations restent confidentielles. Réponse sous 24 h ouvrées.</span>
        </p>
        <p class="step-error send-error" data-send-error>
          L’envoi n’a pas abouti. Merci de réessayer, ou écrivez-moi directement à {site.emailLabel}.
        </p>
      </fieldset>
    </div>

    <!-- Navigation -->
    <div class="q-nav">
      <button type="button" class="q-back" data-back hidden>
        <Icon name="arrowLeft" size={17} /> Retour
      </button>
      <span class="q-time" data-time><Icon name="clock" size={15} /> Environ 2 minutes</span>
      <button type="button" class="btn" data-next>
        <span data-next-label>Continuer</span>
        <Icon name="arrowRight" size={18} class="i-arrow" />
      </button>
      <button type="submit" class="btn q-submit" data-submit>
        <span class="q-spinner" aria-hidden="true"></span>
        <span data-submit-label>Envoyer ma demande</span>
        <Icon name="send" size={17} class="i-arrow" />
      </button>
    </div>
  </form>

  <!-- Confirmation -->
  <div class="success" data-success hidden tabindex="-1">
    <div class="success-mark" aria-hidden="true">
      <svg viewBox="0 0 64 64">
        <circle class="sm-circle" cx="32" cy="32" r="29"></circle>
        <path class="sm-check" d="M19 33.5l9 9 17-19"></path>
      </svg>
      <span class="burst">
        {Array.from({ length: 10 }, (_, i) => <i style={`--a:${i * 36}deg`} />)}
      </span>
    </div>
    <h4 class="success-title">Merci<span data-success-name></span> !</h4>
    <p class="success-text">
      Votre demande de devis est bien envoyée. Je l’étudie et je vous recontacte <strong>sous 24 h ouvrées</strong> avec une proposition adaptée.
    </p>
    <div class="success-actions">
      <a href="#rendez-vous" class="btn">
        Réserver aussi un échange <Icon name="calendar" size={17} />
      </a>
      <button type="button" class="q-back" data-restart>Faire une autre demande</button>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-wizard]');
  if (root) initWizard(root);

  function initWizard(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>('[data-quote-form]')!;
    const viewport = root.querySelector<HTMLElement>('[data-viewport]')!;
    const steps = [...root.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
    const pSteps = [...root.querySelectorAll<HTMLElement>('[data-p-step]')];
    const fill = root.querySelector<HTMLElement>('[data-progress]')!;
    const back = root.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const submit = root.querySelector<HTMLButtonElement>('[data-submit]')!;
    const time = root.querySelector<HTMLElement>('[data-time]')!;
    const announce = root.querySelector<HTMLElement>('[data-step-announce]')!;
    const recap = root.querySelector<HTMLElement>('[data-recap]')!;
    const success = root.querySelector<HTMLElement>('[data-success]')!;
    const sendError = root.querySelector<HTMLElement>('[data-send-error]')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DRAFT_KEY = 'sgc_devis_brouillon';
    const labels = ['Besoins', 'Entreprise', 'Format', 'Coordonnées', 'Envoi'];
    let current = 0;

    root.classList.add('is-enhanced');

    /* ---------- Affichage d'une étape ---------- */
    function show(index: number, focus = true) {
      const prev = current;
      const dir = index >= prev ? 'next' : 'prev';
      const from = viewport.offsetHeight;
      steps.forEach((s, i) => {
        s.classList.toggle('is-current', i === index);
        s.classList.remove('enter-next', 'enter-prev', 'shake');
      });
      current = index;
      const step = steps[index];
      if (!reduceMotion && prev !== index) {
        step.classList.add(`enter-${dir}`);
        // Hauteur animée entre deux étapes
        // + 16 px : marge intérieure du cadre (contours de focus)
        const to = step.offsetHeight + 16;
        viewport.style.height = `${from}px`;
        requestAnimationFrame(() => {
          viewport.style.height = `${to}px`;
        });
        window.setTimeout(() => (viewport.style.height = ''), 480);
      }
      pSteps.forEach((p, i) => {
        p.classList.toggle('is-done', i < index);
        p.classList.toggle('is-current', i === index);
      });
      fill.style.transform = `scaleX(${index / (steps.length - 1)})`;
      back.hidden = index === 0;
      time.hidden = index !== 0;
      const last = index === steps.length - 1;
      next.hidden = last;
      submit.hidden = !last;
      next.querySelector('[data-next-label]')!.textContent = index === steps.length - 2 ? 'Vérifier ma demande' : 'Continuer';
      sendError.classList.remove('is-visible');
      if (last) buildRecap();
      announce.textContent = `Étape ${index + 1} sur ${steps.length} : ${labels[index]}`;
      if (focus && prev !== index) {
        step.querySelector<HTMLElement>('.step-title')?.focus({ preventScroll: true });
        const top = root.getBoundingClientRect().top;
        if (top < 80) root.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      }
    }

    /* ---------- Validation d'une étape ---------- */
    function validate(index: number) {
      const step = steps[index];
      let ok = true;
      step.querySelectorAll<HTMLElement>('[data-group][data-min]').forEach((g) => {
        const checked = g.querySelectorAll('input:checked').length;
        const valid = checked >= Number(g.dataset.min);
        g.classList.toggle('is-invalid', !valid);
        if (!valid) ok = false;
      });
      step.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]').forEach((f) => {
        if (!f.checkValidity()) ok = false;
      });
      step.classList.toggle('was-validated', !ok);
      step.querySelector('[data-error]')?.classList.toggle('is-visible', !ok);
      if (!ok) {
        step.classList.remove('shake');
        void step.offsetWidth;
        if (!reduceMotion) step.classList.add('shake');
        const firstBad = step.querySelector<HTMLElement>('.is-invalid input, input:invalid, textarea:invalid');
        firstBad?.focus();
      }
      return ok;
    }

    next.addEventListener('click', () => {
      if (validate(current)) show(current + 1);
    });
    back.addEventListener('click', () => show(current - 1));

    // Entrée = étape suivante (sauf à la dernière étape et dans le message)
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (current < steps.length - 1) {
        if (validate(current)) show(current + 1);
        return;
      }
      send();
    });

    // Une réponse corrige l'erreur affichée ; un choix unique fait avancer automatiquement l'étape 1 d'un pas
    form.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      const group = input.closest<HTMLElement>('[data-group]');
      if (group?.classList.contains('is-invalid') && group.querySelector('input:checked')) group.classList.remove('is-invalid');
      const step = steps[current];
      if (step.classList.contains('was-validated') && !step.querySelector('.is-invalid, input:invalid')) {
        step.querySelector('[data-error]')?.classList.remove('is-visible');
      }
      // « Je ne sais pas encore » exclut les autres besoins, et inversement
      if (input.name === 'besoins') {
        const all = [...form.querySelectorAll<HTMLInputElement>('input[name="besoins"]')];
        if (input.dataset.key === 'global' && input.checked) all.forEach((b) => b !== input && (b.checked = false));
        if (input.dataset.key !== 'global' && input.checked) all.find((b) => b.dataset.key === 'global')!.checked = false;
      }
      saveDraft();
    });
    form.addEventListener('input', saveDraft);

    /* ---------- Récapitulatif ---------- */
    function buildRecap() {
      const data = new FormData(form);
      const rows: [string, string, number][] = [
        ['Besoins', data.getAll('besoins').join(', '), 0],
        ['Activité', `${data.get('activite') ?? ''} · ${data.get('effectif') ?? ''}`, 1],
        ['Localisation', String(data.get('departement') ?? ''), 1],
        ['Accompagnement', `${data.get('rythme') ?? ''} · ${data.get('modalite') ?? ''} · ${data.get('delai') ?? ''}`, 2],
        ['Contact', [data.get('nom'), data.get('entreprise')].filter(Boolean).join(' — '), 3],
        ['Coordonnées', `${data.get('email')} · ${data.get('telephone')}`, 3],
      ];
      const message = String(data.get('message') ?? '').trim();
      if (message) rows.push(['Message', message, 3]);
      recap.replaceChildren(
        ...rows.map(([label, value, step]) => {
          const row = document.createElement('div');
          row.className = 'recap-row';
          const dt = document.createElement('dt');
          dt.textContent = label;
          const dd = document.createElement('dd');
          dd.textContent = value;
          const edit = document.createElement('button');
          edit.type = 'button';
          edit.className = 'recap-edit';
          edit.textContent = 'Modifier';
          edit.setAttribute('aria-label', `Modifier : ${label}`);
          edit.addEventListener('click', () => show(step));
          row.append(dt, dd, edit);
          return row;
        }),
      );
    }

    /* ---------- Envoi ---------- */
    async function send() {
      submit.disabled = true;
      submit.classList.add('is-loading');
      submit.querySelector('[data-submit-label]')!.textContent = 'Envoi en cours…';
      const data = new FormData(form);
      // Besoins regroupés sur une seule ligne dans l'e-mail reçu
      const besoins = data.getAll('besoins').join(', ');
      data.delete('besoins');
      data.set('besoins', besoins);
      data.set('_subject', `Devis — ${data.get('nom')} — ${data.get('activite')} (${besoins})`);
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error('Envoi refusé');
        const firstName = String(data.get('nom') ?? '').trim().split(/\s+/)[0];
        root.querySelector('[data-success-name]')!.textContent = firstName ? ` ${firstName}` : '';
        clearDraft();
        form.hidden = true;
        root.querySelector('.progress')?.setAttribute('hidden', '');
        success.hidden = false;
        success.focus({ preventScroll: true });
        root.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      } catch {
        sendError.classList.add('is-visible');
      } finally {
        submit.disabled = false;
        submit.classList.remove('is-loading');
        submit.querySelector('[data-submit-label]')!.textContent = 'Envoyer ma demande';
      }
    }

    root.querySelector('[data-restart]')?.addEventListener('click', () => {
      form.reset();
      form.hidden = false;
      success.hidden = true;
      root.querySelector('.progress')?.removeAttribute('hidden');
      steps.forEach((s) => s.classList.remove('was-validated'));
      show(0);
    });

    /* ---------- Brouillon conservé pendant la visite ---------- */
    function saveDraft() {
      try {
        const data: Record<string, string[]> = {};
        new FormData(form).forEach((v, k) => {
          if (k.startsWith('_') || k === 'consentement') return;
          (data[k] ??= []).push(String(v));
        });
        sessionStorage.setItem(DRAFT_KEY, JSON.stringify(data));
      } catch {
        /* stockage indisponible : sans conséquence */
      }
    }
    function clearDraft() {
      try {
        sessionStorage.removeItem(DRAFT_KEY);
      } catch {
        /* rien */
      }
    }
    function restoreDraft() {
      try {
        const data = JSON.parse(sessionStorage.getItem(DRAFT_KEY) ?? '{}') as Record<string, string[]>;
        Object.entries(data).forEach(([name, values]) => {
          form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`).forEach((el) => {
            if (el instanceof HTMLInputElement && (el.type === 'checkbox' || el.type === 'radio')) el.checked = values.includes(el.value);
            else el.value = values[0] ?? '';
          });
        });
      } catch {
        /* rien */
      }
    }

    /* ---------- Pré-sélection depuis l'adresse (?activite=btp, ?besoin=tresorerie) ---------- */
    function preselect() {
      const params = new URLSearchParams(location.search);
      const activite = params.get('activite');
      const besoin = params.get('besoin');
      if (activite) form.querySelector<HTMLInputElement>(`input[name="activite"][data-key="${CSS.escape(activite)}"]`)?.click();
      if (besoin) {
        const input = form.querySelector<HTMLInputElement>(`input[name="besoins"][data-key="${CSS.escape(besoin)}"]`);
        if (input && !input.checked) input.click();
      }
    }

    restoreDraft();
    preselect();
    show(0, false);
  }
</script>

<style>
  .wizard {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
