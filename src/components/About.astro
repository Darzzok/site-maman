---
import Icon from './Icon.astro';
import { about, site } from '../data/site';
---

<section id="a-propos" class="section about">
  <div class="container about-grid">
    <div class="about-media" data-reveal="left">
      <div class="photo">
        <img
          src="/images/nadege.jpg"
          alt={`${site.owner}, fondatrice de ${site.name}`}
          width="800"
          height="640"
          loading="lazy"
          decoding="async"
        />
      </div>
      <span class="corner corner-tr" aria-hidden="true"></span>
      <span class="corner corner-bl" aria-hidden="true"></span>

      <div class="float-badge quote" aria-hidden="true">
        <Icon name="quote" size={26} strokeWidth={1.5} />
      </div>

      <div class="float-card">
        <span class="fc-ic"><Icon name="briefcase" size={20} /></span>
        <span>
          <strong>Direction d’exploitation</strong>
          <small>&amp; gestion d’entreprise</small>
        </span>
      </div>
    </div>

    <div class="about-copy" data-reveal="right">
      <p class="eyebrow">À propos de moi</p>
      <h2 class="h2">{site.owner}</h2>
      <p class="role">{about.role}</p>

      <p class="intro" set:html={about.intro} />
      {about.paragraphs.map((p) => <p class="para" set:html={p} />)}

      <ul class="highlights">
        {
          about.highlights.map((h) => (
            <li>
              <Icon name="checkCircle" size={18} />
              {h}
            </li>
          ))
        }
      </ul>

      <div class="about-actions">
        <a href="#rendez-vous" class="btn">
          Prendre rendez-vous <Icon name="arrowRight" size={18} class="i-arrow" />
        </a>
        <p class="signature">— {site.ownerFirstName}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background:
      radial-gradient(40% 50% at 100% 100%, rgb(226 137 90 / 0.14), transparent 70%),
      var(--sand);
    overflow: hidden;
  }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 6rem);
  }

  /* — Photo — */
  .about-media {
    position: relative;
    max-width: 480px;
    width: 100%;
    margin-inline: auto;
    padding: 1.6rem;
  }
  .photo {
    position: relative;
    overflow: hidden;
    border-radius: 200px 200px 28px 28px;
    aspect-ratio: 4 / 5;
    box-shadow: 0 40px 80px -40px rgb(13 21 48 / 0.5);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 50%;
    scale: 1.08;
    transition: scale 1.6s var(--ease-out);
  }
  .about-media:global(.is-in) .photo img {
    scale: 1;
  }
  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgb(6 15 51 / 0.25));
  }
  /* Lignes d'angle reprises du logo */
  .corner {
    position: absolute;
    width: 42%;
    height: 34%;
    border: 1.5px solid var(--blue-700);
    pointer-events: none;
    opacity: 0;
    transition:
      opacity 0.8s,
      translate 1.2s var(--ease-out);
  }
  .corner-tr {
    top: 0;
    right: 0;
    border-left: 0;
    border-bottom: 0;
    translate: 14px -14px;
  }
  .corner-bl {
    bottom: 0;
    left: 0;
    border-right: 0;
    border-top: 0;
    translate: -14px 14px;
  }
  .about-media:global(.is-in) .corner {
    opacity: 1;
    translate: none;
    transition-delay: 0.4s;
  }

  .float-badge {
    position: absolute;
    top: 18%;
    left: -0.4rem;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(135deg, var(--terra-400), var(--terra-600));
    box-shadow: 0 16px 30px -12px rgb(178 83 31 / 0.7);
    animation: bob 6s ease-in-out infinite;
  }
  .float-card {
    position: absolute;
    right: -1rem;
    bottom: 12%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem 0.85rem 0.85rem;
    border-radius: 18px;
    background: rgb(255 255 255 / 0.92);
    border: 1px solid #fff;
    box-shadow: 0 24px 44px -20px rgb(13 21 48 / 0.4);
    backdrop-filter: blur(12px);
    animation: bob 7s ease-in-out 1s infinite;
  }
  .float-card strong {
    display: block;
    font-size: 0.9rem;
    line-height: 1.25;
  }
  .float-card small {
    display: block;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--muted);
  }
  .fc-ic {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    color: #fff;
    background: linear-gradient(135deg, var(--blue-500), var(--blue-700));
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  /* — Texte — */
  .about-copy {
    text-align: center;
  }
  .role {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--terra-600);
  }
  .intro {
    margin-top: 1.6rem;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--ink);
  }
  .intro :global(strong) {
    color: var(--blue-700);
  }
  .para {
    margin-top: 1.1rem;
    color: var(--muted);
  }
  .highlights {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.8rem;
  }
  .highlights li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.95rem 0.5rem 0.7rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--blue-800);
    background: rgb(255 255 255 / 0.75);
    border: 1px solid rgb(0 44 150 / 0.1);
    transition:
      transform 0.4s var(--ease-out),
      background 0.3s,
      color 0.3s;
  }
  .highlights li :global(svg) {
    color: var(--success);
  }
  .highlights li:hover {
    transform: translateY(-2px);
    background: #fff;
  }
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem 2rem;
    margin-top: 2.2rem;
  }
  .signature {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.7rem;
    color: var(--blue-700);
  }

  @media (max-width: 960px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-copy {
      text-align: center;
    }
    .highlights,
    .about-actions {
      justify-content: center;
    }
    .about-media {
      max-width: 400px;
    }
  }
  @media (max-width: 480px) {
    .float-card {
      right: -0.25rem;
    }
    .float-badge {
      width: 54px;
      height: 54px;
      left: 0;
    }
  }
</style>
