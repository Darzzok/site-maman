---
import Icon from './Icon.astro';
import { hero, site } from '../data/site';

// Le titre est découpé mot par mot pour l'animation d'entrée
const segments = [
  { t: 'Votre partenaire privilégiée pour la' },
  { t: 'gestion', em: true },
  { t: 'et le' },
  { t: 'suivi', em: true },
  { t: 'de votre entreprise.' },
];
let n = 0;
const words = segments.flatMap((s) => s.t.split(' ').map((w) => ({ w, em: !!s.em, i: n++ })));
const bars = [38, 52, 44, 63, 58, 76, 88];
---

<section id="accueil" class="hero" data-parallax-root>
  <div class="hero-bg" aria-hidden="true">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="grid-lines"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow enter" style="--i:0">{hero.eyebrow}</p>

      <h1 class="hero-title">
        {
          words.map(({ w, em, i }) => (
            <Fragment>
              <span class="word" style={`--i:${i}`}>
                {em ? <em>{w}</em> : w}
              </span>{' '}
            </Fragment>
          ))
        }
      </h1>

      <p class="hero-lead enter" style="--i:7" set:html={hero.lead} />

      <div class="hero-actions enter" style="--i:9">
        <a href="#rendez-vous" class="btn">
          Prendre rendez-vous <Icon name="arrowRight" size={18} class="i-arrow" />
        </a>
        <a href="#devis" class="btn btn--ghost">Demander un devis</a>
      </div>

      <ul class="hero-trust enter" style="--i:11">
        {
          hero.trust.map((t) => (
            <li>
              <span class="trust-ic">
                <Icon name="check" size={13} strokeWidth={3} />
              </span>
              {t}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="halo"></div>

      <div class="panel" style="--depth:14">
        <div class="panel-head">
          <img src="/images/nadege.jpg" alt="" width="800" height="640" class="avatar" />
          <div>
            <p class="panel-kicker">Votre interlocutrice unique</p>
            <p class="panel-name">{site.ownerFirstName}</p>
          </div>
          <img src="/images/logo-mark.png" alt="" width="262" height="204" class="panel-mark" />
        </div>

        <div class="panel-chart">
          <div class="chart-top">
            <p class="panel-label">Trésorerie</p>
            <span class="trend"><Icon name="chart" size={14} strokeWidth={2.2} /> Maîtrisée</span>
          </div>
          <div class="bars">
            {bars.map((h, i) => <span style={`--h:${h}%;--b:${i}`} />)}
          </div>
          <svg class="curve" viewBox="0 0 280 90" preserveAspectRatio="none">
            <path d="M4 70 C 40 66, 60 52, 92 56 S 150 44, 180 36 S 240 18, 276 10" pathLength="1"></path>
          </svg>
        </div>

        <ul class="panel-list">
          <li style="--r:0">
            <span class="li-ic"><Icon name="file" size={16} /></span>
            Factures &amp; relances
            <span class="pill ok"><Icon name="check" size={12} strokeWidth={3} />À jour</span>
          </li>
          <li style="--r:1">
            <span class="li-ic"><Icon name="users" size={16} /></span>
            Dossiers RH
            <span class="pill ok"><Icon name="check" size={12} strokeWidth={3} />Sécurisés</span>
          </li>
          <li style="--r:2">
            <span class="li-ic"><Icon name="chart" size={16} /></span>
            Tableau de bord
            <span class="pill">Suivi régulier</span>
          </li>
        </ul>
      </div>

      <div class="chip chip-a" style="--depth:30">
        <span class="chip-ic terra"><Icon name="calendar" size={18} /></span>
        <span><strong>Échange offert</strong><small>30 min, sans engagement</small></span>
      </div>

      <div class="chip chip-b" style="--depth:24">
        <span class="chip-ic blue"><Icon name="clock" size={18} /></span>
        <span><strong>Réponse sous 24h</strong><small>Devis personnalisé</small></span>
      </div>
    </div>
  </div>

  <a href="#services" class="scroll-hint" aria-label="Défiler vers la suite">
    <span class="mouse"><span class="wheel"></span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding: calc(var(--header-h) + 3rem) 0 5.5rem;
  }

  /* — Fond animé — */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, var(--cream), var(--sand) 120%);
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.75;
    animation: drift 22s ease-in-out infinite alternate;
  }
  .orb-1 {
    width: 46vw;
    height: 46vw;
    top: -16vw;
    right: -10vw;
    background: radial-gradient(circle, rgb(226 137 90 / 0.45), transparent 65%);
  }
  .orb-2 {
    width: 40vw;
    height: 40vw;
    bottom: -18vw;
    left: -12vw;
    background: radial-gradient(circle, rgb(58 98 211 / 0.3), transparent 65%);
    animation-duration: 26s;
    animation-delay: -6s;
  }
  .orb-3 {
    width: 28vw;
    height: 28vw;
    top: 30%;
    left: 38%;
    background: radial-gradient(circle, rgb(157 177 236 / 0.35), transparent 65%);
    animation-duration: 30s;
    animation-delay: -12s;
  }
  @keyframes drift {
    0% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(4vw, 3vw) scale(1.08);
    }
    100% {
      transform: translate(-3vw, -2vw) scale(0.95);
    }
  }
  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(0 44 150 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(0 44 150 / 0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(70% 60% at 60% 40%, #000 20%, transparent 75%);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
  .hero-copy {
    text-align: center;
  }

  /* — Texte — */
  @keyframes enter {
    from {
      opacity: 0;
      translate: 0 22px;
      filter: blur(6px);
    }
    to {
      opacity: 1;
      translate: none;
      filter: none;
    }
  }
  .enter {
    animation: enter 1s var(--ease-out) both;
    animation-delay: calc(0.1s + var(--i) * 0.08s);
  }
  .hero-title {
    margin-top: 1.5rem;
    font-size: clamp(2.6rem, 5.6vw, 4.6rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    font-weight: 450;
  }
  .word {
    display: inline-block;
    animation: word-in 1.1s var(--ease-out) both;
    animation-delay: calc(0.2s + var(--i) * 0.055s);
  }
  @keyframes word-in {
    from {
      opacity: 0;
      translate: 0 0.45em;
      filter: blur(10px);
    }
    to {
      opacity: 1;
      translate: none;
      filter: none;
    }
  }
  .hero-title em {
    position: relative;
    padding-right: 0.06em;
  }
  .hero-title em::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.06em;
    bottom: 0.04em;
    height: 0.09em;
    border-radius: 1em;
    background: linear-gradient(90deg, var(--blue-300), var(--blue-200));
    opacity: 0.7;
    transform-origin: left;
    scale: 0 1;
    animation: underline 1s var(--ease-out) forwards;
    animation-delay: 1.3s;
  }
  @keyframes underline {
    to {
      scale: 1 1;
    }
  }
  .hero-lead {
    margin-top: 1.6rem;
    max-width: 38rem;
    margin-inline: auto;
    font-size: clamp(1.02rem, 1.3vw, 1.14rem);
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2.2rem;
  }
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.4rem;
    margin-top: 2rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }
  .hero-trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .trust-ic {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    color: #fff;
    background: var(--success);
  }

  /* — Illustration — */
  .hero-visual {
    position: relative;
    width: min(100%, 460px);
    justify-self: center;
    padding: 2.5rem 0;
  }
  .halo {
    position: absolute;
    inset: 8% -6%;
    border-radius: 40px;
    background: linear-gradient(140deg, rgb(0 44 150 / 0.14), rgb(203 106 51 / 0.16));
    filter: blur(30px);
    animation: enter 1.4s var(--ease-out) 0.4s both;
  }
  .panel,
  .chip {
    translate: calc(var(--px, 0) * var(--depth) * 1px) calc(var(--py, 0) * var(--depth) * 1px);
    transition: translate 0.8s var(--ease-out);
  }
  .panel {
    position: relative;
    padding: 1.4rem;
    border-radius: 28px;
    background: rgb(255 255 255 / 0.82);
    border: 1px solid rgb(255 255 255 / 0.9);
    box-shadow:
      0 40px 80px -40px rgb(0 44 150 / 0.45),
      0 10px 30px -15px rgb(13 21 48 / 0.15),
      inset 0 1px 0 #fff;
    backdrop-filter: blur(16px);
    animation:
      panel-in 1.2s var(--ease-out) 0.35s both,
      float 9s ease-in-out 1.6s infinite;
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: perspective(1200px) rotateX(14deg) rotateY(-10deg) translateY(40px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  .panel-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 51% 28%;
    border: 2px solid #fff;
    box-shadow: 0 0 0 2px var(--terra-200);
  }
  .panel-kicker {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted);
  }
  .panel-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink);
    line-height: 1.2;
  }
  .panel-mark {
    width: auto;
    height: 24px;
    margin-left: auto;
    opacity: 0.9;
  }
  .panel-chart {
    position: relative;
    margin-top: 1.1rem;
    padding: 1rem 1rem 0.8rem;
    border-radius: 18px;
    background: linear-gradient(180deg, var(--blue-50), #fff);
    border: 1px solid var(--blue-100);
  }
  .chart-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .panel-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink);
  }
  .trend {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--success);
    background: var(--success-bg);
  }
  .bars {
    display: flex;
    align-items: flex-end;
    gap: 7px;
    height: 92px;
    margin-top: 0.8rem;
  }
  .bars span {
    flex: 1;
    height: var(--h);
    border-radius: 6px 6px 3px 3px;
    background: linear-gradient(180deg, var(--blue-500), var(--blue-700));
    transform-origin: bottom;
    animation: bar-grow 1s var(--ease-out) both;
    animation-delay: calc(0.9s + var(--b) * 0.08s);
  }
  .bars span:last-child {
    background: linear-gradient(180deg, var(--terra-400), var(--terra-600));
  }
  @keyframes bar-grow {
    from {
      scale: 1 0;
    }
  }
  .curve {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.8rem;
    width: calc(100% - 2rem);
    height: 92px;
    overflow: visible;
  }
  .curve path {
    fill: none;
    stroke: var(--terra-500);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    filter: drop-shadow(0 4px 6px rgb(203 106 51 / 0.4));
    animation: draw 1.6s var(--ease-in-out) 1.5s forwards;
    vector-effect: non-scaling-stroke;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .panel-list {
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
  }
  .panel-list li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.7rem;
    border-radius: 14px;
    background: #fff;
    border: 1px solid var(--line-soft);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--ink);
    animation: enter 0.8s var(--ease-out) both;
    animation-delay: calc(1.2s + var(--r) * 0.15s);
  }
  .li-ic {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 10px;
    color: var(--blue-700);
    background: var(--blue-50);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--blue-700);
    background: var(--blue-100);
  }
  .pill.ok {
    color: var(--success);
    background: var(--success-bg);
  }

  .chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 1rem 0.7rem 0.7rem;
    border-radius: 18px;
    background: rgb(255 255 255 / 0.9);
    border: 1px solid #fff;
    box-shadow: 0 24px 40px -20px rgb(13 21 48 / 0.35);
    backdrop-filter: blur(12px);
    white-space: nowrap;
    animation:
      chip-in 0.9s var(--ease-spring) both,
      float 7s ease-in-out infinite;
  }
  .chip strong {
    display: block;
    font-size: 0.86rem;
    line-height: 1.2;
  }
  .chip small {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted);
  }
  .chip-a {
    top: 0;
    right: -2.2rem;
    animation-delay: 1.5s, 2.4s;
  }
  .chip-b {
    bottom: 0.4rem;
    left: -2.6rem;
    animation-delay: 1.75s, 3.2s;
  }
  @keyframes chip-in {
    from {
      opacity: 0;
      scale: 0.6;
    }
  }
  .chip-ic {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    color: #fff;
  }
  .chip-ic.terra {
    background: linear-gradient(135deg, var(--terra-400), var(--terra-600));
  }
  .chip-ic.blue {
    background: linear-gradient(135deg, var(--blue-500), var(--blue-700));
  }

  /* — Indicateur de défilement — */
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    translate: -50% 0;
    color: var(--blue-700);
    opacity: 0.6;
    transition: opacity 0.3s;
    animation: enter 1s var(--ease-out) 1.8s both;
  }
  .scroll-hint:hover {
    opacity: 1;
  }
  .mouse {
    display: flex;
    justify-content: center;
    width: 24px;
    height: 38px;
    padding-top: 7px;
    border: 2px solid currentColor;
    border-radius: 14px;
  }
  .wheel {
    width: 3px;
    height: 7px;
    border-radius: 3px;
    background: currentColor;
    animation: wheel 1.8s var(--ease-in-out) infinite;
  }
  @keyframes wheel {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    80% {
      transform: translateY(11px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 0;
    }
  }

  @media (max-width: 1023px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-copy {
      text-align: center;
    }
    .hero-lead {
      margin-inline: auto;
    }
    .hero-actions,
    .hero-trust {
      justify-content: center;
    }
    .hero-visual {
      width: min(100% - 3rem, 420px);
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: calc(var(--header-h) + 1.5rem);
    }
    .hero-actions .btn {
      width: 100%;
    }
    .chip-a {
      right: -1.2rem;
    }
    .chip-b {
      left: -1.2rem;
    }
    .scroll-hint {
      display: none;
    }
  }
</style>
