---
import Icon from './Icon.astro';
import { hero } from '../data/site';

// Le titre est découpé mot par mot pour l'animation d'entrée
const segments = [
  { t: 'Votre partenaire privilégiée pour la' },
  { t: 'gestion', em: true },
  { t: 'et le' },
  { t: 'suivi', em: true },
  { t: 'de votre entreprise.' },
];
let n = 0;
const words = segments.flatMap((s) => s.t.split(' ').map((w) => ({ w, em: !!s.em, i: n++ })));
---

<section id="accueil" class="hero" data-parallax-root>
  <div class="hero-bg" aria-hidden="true">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="grid-lines"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow enter" style="--i:0">{hero.eyebrow}</p>

      <h1 class="hero-title">
        {
          words.map(({ w, em, i }) => (
            <Fragment>
              <span class="word" style={`--i:${i}`}>
                {em ? <em>{w}</em> : w}
              </span>{' '}
            </Fragment>
          ))
        }
      </h1>

      <p class="hero-lead enter" style="--i:7" set:html={hero.lead} />

      <div class="hero-actions enter" style="--i:9">
        <a href="#rendez-vous" class="btn">
          Prendre rendez-vous <Icon name="arrowRight" size={18} class="i-arrow" />
        </a>
        <a href="#devis" class="btn btn--ghost">Demander un devis</a>
      </div>

      <ul class="hero-trust enter" style="--i:11">
        {
          hero.trust.map((t) => (
            <li>
              <span class="trust-ic">
                <Icon name="check" size={13} strokeWidth={3} />
              </span>
              {t}
            </li>
          ))
        }
      </ul>
    </div>

  </div>

  <a href="#services" class="scroll-hint" aria-label="Défiler vers la suite">
    <span class="mouse"><span class="wheel"></span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding: calc(var(--header-h) + 3rem) 0 5.5rem;
  }

  /* — Fond animé — */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, var(--cream), var(--sand) 120%);
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.75;
    animation: drift 22s ease-in-out infinite alternate;
  }
  .orb-1 {
    width: 46vw;
    height: 46vw;
    top: -16vw;
    right: -10vw;
    background: radial-gradient(circle, rgb(246 181 91 / 0.22), transparent 65%);
  }
  .orb-2 {
    width: 40vw;
    height: 40vw;
    bottom: -18vw;
    left: -12vw;
    background: radial-gradient(circle, rgb(246 181 91 / 0.16), transparent 65%);
    animation-duration: 26s;
    animation-delay: -6s;
  }
  .orb-3 {
    width: 28vw;
    height: 28vw;
    top: 30%;
    left: 38%;
    background: radial-gradient(circle, rgb(246 181 91 / 0.12), transparent 65%);
    animation-duration: 30s;
    animation-delay: -12s;
  }
  @keyframes drift {
    0% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(4vw, 3vw) scale(1.08);
    }
    100% {
      transform: translate(-3vw, -2vw) scale(0.95);
    }
  }
  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(97 25 58 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(97 25 58 / 0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(70% 60% at 60% 40%, #000 20%, transparent 75%);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
  .hero-copy {
    text-align: center;
  }

  /* — Texte — */
  @keyframes enter {
    from {
      opacity: 0;
      translate: 0 22px;
      filter: blur(6px);
    }
    to {
      opacity: 1;
      translate: none;
      filter: none;
    }
  }
  .enter {
    animation: enter 1s var(--ease-out) both;
    animation-delay: calc(0.1s + var(--i) * 0.08s);
  }
  .hero-title {
    margin-top: 1.5rem;
    font-size: clamp(2.6rem, 5.6vw, 4.6rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    font-weight: 450;
  }
  .word {
    display: inline-block;
    animation: word-in 1.1s var(--ease-out) both;
    animation-delay: calc(0.2s + var(--i) * 0.055s);
  }
  @keyframes word-in {
    from {
      opacity: 0;
      translate: 0 0.45em;
      filter: blur(10px);
    }
    to {
      opacity: 1;
      translate: none;
      filter: none;
    }
  }
  .hero-title em {
    position: relative;
    padding-right: 0.06em;
  }
  .hero-title em::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.06em;
    bottom: 0.04em;
    height: 0.09em;
    border-radius: 1em;
    background: linear-gradient(90deg, var(--terra-300), var(--terra-200));
    opacity: 0.7;
    transform-origin: left;
    scale: 0 1;
    animation: underline 1s var(--ease-out) forwards;
    animation-delay: 1.3s;
  }
  @keyframes underline {
    to {
      scale: 1 1;
    }
  }
  .hero-lead {
    margin-top: 1.6rem;
    max-width: 38rem;
    margin-inline: auto;
    font-size: clamp(1.02rem, 1.3vw, 1.14rem);
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2.2rem;
  }
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.4rem;
    margin-top: 2rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }
  .hero-trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .trust-ic {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    color: #fff;
    background: var(--success);
  }

  /* — Indicateur de défilement — */
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    translate: -50% 0;
    color: var(--blue-700);
    opacity: 0.6;
    transition: opacity 0.3s;
    animation: enter 1s var(--ease-out) 1.8s both;
  }
  .scroll-hint:hover {
    opacity: 1;
  }
  .mouse {
    display: flex;
    justify-content: center;
    width: 24px;
    height: 38px;
    padding-top: 7px;
    border: 2px solid currentColor;
    border-radius: 14px;
  }
  .wheel {
    width: 3px;
    height: 7px;
    border-radius: 3px;
    background: currentColor;
    animation: wheel 1.8s var(--ease-in-out) infinite;
  }
  @keyframes wheel {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    80% {
      transform: translateY(11px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 0;
    }
  }

  @media (max-width: 1023px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-copy {
      text-align: center;
    }
    .hero-lead {
      margin-inline: auto;
    }
    .hero-actions,
    .hero-trust {
      justify-content: center;
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: calc(var(--header-h) + 1.5rem);
    }
    .hero-actions .btn {
      width: 100%;
    }
    .scroll-hint {
      display: none;
    }
  }

  /* ============ Mobile : en-tête compact ============ */
  @media (max-width: 640px) {
    .hero {
      padding-bottom: 2.5rem;
      min-height: 0;
    }
    .hero-lead {
      font-size: 1rem;
    }
    .hero-actions {
      gap: 0.6rem;
      margin-top: 1.6rem;
    }
    .hero-trust {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.45rem;
      margin-top: 1.4rem;
      font-size: 0.8rem;
    }
    .hero-trust li {
      justify-content: center;
      padding: 0.5rem 0.6rem;
      border-radius: 14px;
      text-align: center;
      background: rgb(255 255 255 / 0.7);
      border: 1px solid var(--line);
    }
  }

  /* ============ Texte d'accueil en pleine largeur ============ */
  .hero-inner {
    grid-template-columns: minmax(0, 1fr);
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-title {
    max-width: 22ch;
  }
  .hero-lead {
    max-width: 52rem;
  }
  @media (min-width: 1024px) {
    .hero-title {
      max-width: none;
      font-size: clamp(3.4rem, 5.6vw, 5.4rem);
    }
  }
</style>
