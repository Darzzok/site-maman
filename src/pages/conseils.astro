---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { articleUrl, categories, getConseils, lengthFormat, lengthFormats, readingTime, type Category } from '../utils/conseils';

const articles = await getConseils();
const featured = articles.find((a) => a.data.featured) ?? articles[0];

// Thèmes, dans l'ordre des services, avec le nombre d'articles
const themeText: Record<Category, string> = {
  Trésorerie: 'Relances, impayés, prévisionnel : sécuriser votre cash.',
  'Gestion administrative': 'Devis, factures, chantiers : un administratif qui tourne.',
  'Ressources humaines': 'Embauche, paie, formalités : gérer votre équipe sereinement.',
  Pilotage: 'Indicateurs, charges, rentabilité : décider en connaissance de cause.',
};
const themes = (Object.keys(categories) as Category[])
  .map((name) => ({ name, ...categories[name], text: themeText[name], count: articles.filter((a) => a.data.category === name).length }))
  .filter((t) => t.count > 0);

const minutes = articles.map((a) => readingTime(a.body));
const formats = lengthFormats
  .map((f) => ({ ...f, count: articles.filter((a) => lengthFormat(readingTime(a.body)).key === f.key).length }))
  .filter((f) => f.count > 0);
const readRange = `${Math.min(...minutes)} à ${Math.max(...minutes)} min`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: `Conseils de gestion pour TPE et artisans — ${site.name}`,
      url: `${site.url}/conseils.html`,
      inLanguage: 'fr-FR',
      hasPart: articles.map((a) => ({
        '@type': 'BlogPosting',
        headline: a.data.title,
        url: `${site.url}${articleUrl(a)}`,
        datePublished: a.data.date.toISOString(),
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Conseils', item: `${site.url}/conseils.html` },
      ],
    },
  ],
};
---

<BaseLayout
  title="Conseils de gestion pour TPE, artisans et libéraux | SGC"
  description="Trésorerie, factures, facturation électronique, embauche, paie : des conseils pratiques pour gérer votre TPE, par une consultante en Normandie."
  jsonLd={jsonLd}
>
  <!-- ============ En-tête + recherche ============ -->
  <section class="c-hero">
    <div class="c-hero-bg" aria-hidden="true"><span></span><span></span></div>
    <div class="container c-hero-inner">
      <nav class="crumbs" aria-label="Fil d’Ariane">
        <a href="/"><Icon name="arrowLeft" size={15} strokeWidth={2} /> Accueil</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Conseils</span>
      </nav>
      <p class="eyebrow">Conseils</p>
      <h1>Des conseils concrets pour mieux <em>gérer</em> votre entreprise</h1>
      <p class="c-intro">
        Trésorerie, administratif, ressources humaines, pilotage : des repères pratiques, issus du terrain, pour les
        dirigeants de TPE, artisans et professions libérales.
      </p>

      <form class="search" role="search" data-search-form onsubmit="return false">
        <label for="search-input" class="sr-only">Rechercher un conseil</label>
        <Icon name="search" size={20} class="search-ic" />
        <input
          id="search-input"
          type="search"
          placeholder="Rechercher : facture, trésorerie, embauche…"
          autocomplete="off"
          data-search-input
        />
        <kbd class="search-kbd" aria-hidden="true">/</kbd>
        <button type="button" class="search-clear" aria-label="Effacer la recherche" data-search-clear hidden>
          <Icon name="x" size={18} />
        </button>
      </form>

      <ul class="c-stats">
        <li><strong>{articles.length}</strong> articles</li>
        <li><strong>{themes.length}</strong> thèmes</li>
        <li><Icon name="clock" size={15} /> {readRange} de lecture</li>
      </ul>
    </div>
  </section>

  <section class="section c-main">
    <div class="container">
      <!-- ============ À la une ============ -->
      {
        featured && (
          <div class="featured" data-featured-block>
            <ArticleCard entry={featured} featured eager />
          </div>
        )
      }

      <!-- ============ Filtres ============ -->
      <!-- La barre de filtres reste visible uniquement le long de la liste d’articles -->
      <div class="listing">
      <div class="toolbar" data-toolbar>
        <div class="filters" role="group" aria-label="Filtrer par thème">
          <button type="button" class="filter is-active" data-filter="all" aria-pressed="true">
            Tous <span class="count">{articles.length}</span>
          </button>
          {
            themes.map((t) => (
              <button type="button" class="filter" data-filter={t.name} data-slug={t.slug} aria-pressed="false">
                <Icon name={t.icon} size={15} />
                {t.name}
                <span class="count">{t.count}</span>
              </button>
            ))
          }
        </div>
      </div>
      <div class="formats" role="group" aria-label="Filtrer par durée de lecture">
        <span class="formats-label"><Icon name="clock" size={15} /> Durée</span>
        <button type="button" class="fmt is-active" data-format-filter="all" aria-pressed="true">Toutes</button>
        {
          formats.map((f) => (
            <button type="button" class="fmt" data-format-filter={f.key} aria-pressed="false" title={f.hint}>
              {f.label} <small>{f.hint}</small>
            </button>
          ))
        }
      </div>
      <p class="results" aria-live="polite" data-results></p>

      <!-- ============ Articles ============ -->
      <div class="a-grid" data-articles>
        {articles.map((a, i) => <ArticleCard entry={a} delay={i % 3} />)}
      </div>

      <div class="empty" data-empty hidden>
        <span class="empty-ic"><Icon name="search" size={28} /></span>
        <p class="empty-title">Aucun conseil ne correspond à votre recherche</p>
        <p>Essayez un autre mot-clé, ou posez-moi directement votre question.</p>
        <div class="empty-actions">
          <button type="button" class="btn btn--ghost btn--sm" data-reset>Voir tous les conseils</button>
          <a href="/#contact" class="btn btn--sm">Poser ma question</a>
        </div>
      </div>

      </div>

      <!-- ============ Explorer par thème ============ -->
      <div class="themes">
        <h2 class="themes-title" data-reveal>Explorer par thème</h2>
        <div class="t-grid" data-carousel>
          {
            themes.map((t, i) => (
              <button type="button" class:list={['card', 'theme', `tone-${t.tone}`]} data-theme={t.name} data-reveal style={`--d:${i}`}>
                <span class="theme-ic">
                  <Icon name={t.icon} size={24} />
                </span>
                <span class="theme-name">{t.name}</span>
                <span class="theme-text">{t.text}</span>
                <span class="theme-count">
                  {t.count} article{t.count > 1 ? 's' : ''} <Icon name="arrowRight" size={15} />
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <!-- ============ Appel à l'action ============ -->
      <aside class="cta" data-reveal>
        <div class="cta-photo" aria-hidden="true">
          <img src="/images/logo-mark.png" alt="" width="600" height="205" loading="lazy" />
        </div>
        <div class="cta-text">
          <h2>Besoin d’un regard sur votre situation ?</h2>
          <p>
            Chaque entreprise est différente. Parlons de la vôtre lors d’un <strong>échange gratuit de 30 minutes</strong>,
            sans engagement.
          </p>
        </div>
        <div class="cta-actions">
          <a href="/#rendez-vous" class="btn">Réserver un échange <Icon name="arrowRight" size={18} class="i-arrow" /></a>
          <a href="/#devis" class="cta-link">ou demander un devis</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  /* Recherche instantanée + filtres par thème, avec l'état conservé dans l'adresse */
  const input = document.querySelector<HTMLInputElement>('[data-search-input]')!;
  const clear = document.querySelector<HTMLButtonElement>('[data-search-clear]')!;
  const grid = document.querySelector<HTMLElement>('[data-articles]')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('[data-category]')];
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const formatBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-format-filter]')];
  const featuredBlock = document.querySelector<HTMLElement>('[data-featured-block]');
  const results = document.querySelector<HTMLElement>('[data-results]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const toolbar = document.querySelector<HTMLElement>('[data-toolbar]')!;

  const normalize = (s: string) =>
    s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();

  let theme = 'all';
  let format = 'all';

  function apply(updateUrl = true) {
    const q = normalize(input.value);
    // Recherche tolérante : "factures" ou "facture" trouvent aussi "facturation"
    const words = q
      .split(/\s+/)
      .filter(Boolean)
      .map((w) => (w.length > 4 ? w.replace(/(es|e|s)$/, '') : w));
    const filtering = theme !== 'all' || format !== 'all' || words.length > 0;
    let visible = 0;

    cards.forEach((card) => {
      const matchTheme = theme === 'all' || card.dataset.category === theme;
      const matchText = words.every((w) => (card.dataset.search ?? '').includes(w));
      const matchFormat = format === 'all' || card.dataset.format === format;
      // Sans filtre, l'article "à la une" est déjà affiché au-dessus
      const show = matchTheme && matchText && matchFormat && (filtering || card.dataset.featured !== 'true');
      card.hidden = !show;
      if (show) {
        visible++;
        card.classList.add('is-in');
      }
    });

    if (featuredBlock) featuredBlock.hidden = filtering;
    const total = visible + (filtering || !featuredBlock ? 0 : 1);
    results.textContent = filtering ? `${total} article${total > 1 ? 's' : ''} trouvé${total > 1 ? 's' : ''}` : '';
    empty.hidden = total > 0;
    clear.hidden = input.value.length === 0;

    filters.forEach((f) => {
      const active = f.dataset.filter === theme;
      f.classList.toggle('is-active', active);
      f.setAttribute('aria-pressed', String(active));
    });
    formatBtns.forEach((b) => {
      const active = b.dataset.formatFilter === format;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-pressed', String(active));
    });

    if (updateUrl) {
      const url = new URL(location.href);
      const slug = filters.find((f) => f.dataset.filter === theme)?.dataset.slug;
      slug ? url.searchParams.set('theme', slug) : url.searchParams.delete('theme');
      input.value ? url.searchParams.set('q', input.value) : url.searchParams.delete('q');
      format !== 'all' ? url.searchParams.set('duree', format) : url.searchParams.delete('duree');
      history.replaceState(null, '', url);
    }
  }

  function setTheme(name: string, scroll = false) {
    theme = name;
    apply();
    if (scroll) toolbar.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  filters.forEach((f) => f.addEventListener('click', () => setTheme(f.dataset.filter ?? 'all')));
  formatBtns.forEach((b) =>
    b.addEventListener('click', () => {
      format = b.dataset.formatFilter ?? 'all';
      apply();
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('[data-theme]').forEach((b) =>
    b.addEventListener('click', () => setTheme(b.dataset.theme ?? 'all', true)),
  );
  input.addEventListener('input', () => apply());
  clear.addEventListener('click', () => {
    input.value = '';
    apply();
    input.focus();
  });
  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    input.value = '';
    format = 'all';
    setTheme('all');
  });

  // Raccourci clavier "/" pour rechercher
  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(target.tagName)) {
      e.preventDefault();
      input.focus();
    }
    if (e.key === 'Escape' && target === input && input.value) {
      input.value = '';
      apply();
    }
  });

  // État initial depuis l'adresse (?theme=…&q=…)
  const params = new URLSearchParams(location.search);
  const fromSlug = filters.find((f) => f.dataset.slug === params.get('theme'))?.dataset.filter;
  if (fromSlug) theme = fromSlug;
  input.value = params.get('q') ?? '';
  const fromFormat = params.get('duree');
  if (formatBtns.some((b) => b.dataset.formatFilter === fromFormat)) format = fromFormat as string;
  grid.classList.add('is-enhanced');
  apply(false);
</script>

<style>
  /* ============ En-tête ============ */
  .c-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: calc(var(--header-h) + 3.5rem) 0 clamp(3rem, 6vw, 4.5rem);
    text-align: center;
    background: linear-gradient(180deg, var(--cream), var(--sand));
  }
  .c-hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(97 25 58 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(97 25 58 / 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(70% 80% at 50% 20%, #000, transparent 80%);
  }
  .c-hero-bg span {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    animation: drift 20s ease-in-out infinite alternate;
  }
  .c-hero-bg span:first-child {
    width: 420px;
    height: 420px;
    top: -160px;
    right: -80px;
    background: rgb(246 181 91 / 0.18);
  }
  .c-hero-bg span:last-child {
    width: 380px;
    height: 380px;
    bottom: -220px;
    left: 5%;
    background: rgb(229 129 188 / 0.14);
    animation-delay: -8s;
  }
  @keyframes drift {
    to {
      transform: translate(60px, 40px) scale(1.12);
    }
  }
  .c-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 880px;
    animation: rise 0.9s var(--ease-out) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 20px;
    }
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.4rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--muted);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--blue-700);
  }
  h1 {
    margin-top: 1.1rem;
    font-size: clamp(2.3rem, 5.2vw, 3.8rem);
    letter-spacing: -0.03em;
  }
  .c-intro {
    max-width: 40rem;
    margin-top: 1.1rem;
    font-size: 1.1rem;
    color: var(--muted);
  }

  /* — Recherche — */
  .search {
    position: relative;
    width: min(100%, 620px);
    margin-top: 2rem;
  }
  .search :global(.search-ic) {
    position: absolute;
    left: 1.25rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--muted);
    pointer-events: none;
  }
  .search input {
    width: 100%;
    padding: 1.1rem 3.5rem 1.1rem 3.3rem;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: #fff;
    font-size: 1.02rem;
    color: var(--ink);
    box-shadow: 0 18px 40px -24px rgb(42 9 22 / 0.35);
    outline: none;
    transition:
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .search input::-webkit-search-cancel-button {
    display: none;
  }
  .search input::placeholder {
    color: #6b6b6b;
  }
  .search input:focus {
    border-color: var(--blue-600);
    box-shadow:
      0 0 0 4px rgb(123 37 80 / 0.12),
      0 18px 40px -24px rgb(42 9 22 / 0.35);
  }
  .search-kbd {
    position: absolute;
    right: 1.2rem;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted);
    background: var(--cream);
    border: 1px solid var(--line);
    pointer-events: none;
  }
  .search input:focus ~ .search-kbd,
  .search-clear:not([hidden]) ~ .search-kbd {
    display: none;
  }
  .search:has(.search-clear:not([hidden])) .search-kbd {
    display: none;
  }
  .search-clear {
    position: absolute;
    right: 0.6rem;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--muted);
    transition:
      background 0.2s,
      color 0.2s;
  }
  .search-clear:hover {
    color: var(--ink);
    background: var(--cream);
  }
  .search-clear[hidden] {
    display: none;
  }
  .c-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.6rem;
    margin-top: 1.4rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .c-stats li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  /* ============ Contenu ============ */
  .c-main {
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    background: var(--white);
  }
  .featured {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .featured[hidden] {
    display: none;
  }

  /* — Barre de filtres (reste visible au défilement) — */
  .toolbar {
    position: sticky;
    top: 5.6rem;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin: 0 auto 0.75rem;
    scroll-margin-top: 7rem;
  }
  .filters {
    display: flex;
    gap: 0.4rem;
    max-width: 100%;
    padding: 0.4rem;
    overflow-x: auto;
    scrollbar-width: none;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.88);
    border: 1px solid var(--line);
    box-shadow: 0 14px 34px -22px rgb(42 9 22 / 0.4);
    backdrop-filter: blur(14px);
  }
  .filters::-webkit-scrollbar {
    display: none;
  }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
    padding: 0.55rem 0.95rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--text);
    transition:
      background 0.3s,
      color 0.3s;
  }
  .filter:hover {
    color: var(--blue-700);
    background: var(--blue-50);
  }
  .filter.is-active {
    color: #fff;
    background: var(--blue-700);
  }
  .count {
    min-width: 1.4rem;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--blue-700);
    background: var(--blue-100);
  }
  .filter.is-active .count {
    color: var(--blue-700);
    background: #fff;
  }
  .formats {
    width: fit-content;
    margin: 0 auto 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.88);
    border: 1px solid var(--line);
    backdrop-filter: blur(14px);
  }
  .formats-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0 0.6rem 0 0.5rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .fmt {
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text);
    transition:
      background 0.3s,
      color 0.3s;
  }
  .fmt small {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted);
  }
  .fmt:hover {
    color: var(--blue-700);
    background: var(--blue-50);
  }
  .fmt.is-active {
    color: #fff;
    background: var(--blue-600);
  }
  .fmt.is-active small {
    color: #fff;
  }
  .results {
    min-height: 1.2em;
    margin-bottom: 1.5rem;
    text-align: center;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--muted);
  }

  /* — Grille — */
  .a-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  /* Sans JavaScript, l'article à la une n'est pas répété dans la grille */
  .a-grid:not(:global(.is-enhanced)) :global([data-featured]) {
    display: none;
  }
  .a-grid :global([hidden]) {
    display: none !important;
  }

  /* — Aucun résultat — */
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    max-width: 30rem;
    margin: 1rem auto 0;
    padding: 2.5rem 1.5rem;
    text-align: center;
    border-radius: var(--radius-lg);
    border: 1.5px dashed var(--sand-300);
    background: var(--cream);
    animation: rise 0.5s var(--ease-out);
  }
  .empty[hidden] {
    display: none;
  }
  .empty-ic {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 18px;
    color: var(--blue-700);
    background: #fff;
    box-shadow: var(--shadow-md);
  }
  .empty-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--ink);
  }
  .empty p:not(.empty-title) {
    color: var(--muted);
  }
  .empty-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.6rem;
  }

  /* — Explorer par thème — */
  .themes {
    margin-top: clamp(4rem, 8vw, 5.5rem);
  }
  .themes-title {
    margin-bottom: 1.75rem;
    text-align: center;
    font-size: clamp(1.7rem, 3vw, 2.2rem);
