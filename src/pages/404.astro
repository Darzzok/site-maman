---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { getMetiers, metierUrl } from '../utils/landings';

const metiers = await getMetiers();
const links = [
  { label: 'Accueil', href: '/', icon: 'home' },
  { label: 'Conseils', href: '/conseils.html', icon: 'book' },
  { label: 'Questions fréquentes', href: '/faq.html', icon: 'help' },
  { label: 'Zone d’intervention', href: '/zone-intervention.html', icon: 'mapPin' },
];
---

<BaseLayout title={`Page introuvable | ${site.name}`} description="Cette page n’existe pas ou a été déplacée." noindex>
  <section class="nf">
    <div class="container nf-inner">
      <span class="nf-ic"><Icon name="search" size={30} /></span>
      <p class="eyebrow">Erreur 404</p>
      <h1>Cette page est <em>introuvable</em></h1>
      <p class="nf-text">
        Le lien est peut-être ancien ou la page a été déplacée. Voici quelques pistes pour retrouver votre chemin.
      </p>
      <ul class="nf-links">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>
                <Icon name={l.icon} size={17} />
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="nf-sub">Accompagnement par métier :</p>
      <ul class="nf-links nf-links--soft">
        {
          metiers.map((m) => (
            <li>
              <a href={metierUrl(m.id)}>
                <Icon name={m.data.icon} size={16} />
                {m.data.name}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/#rendez-vous" class="btn">
        Réserver un échange gratuit <Icon name="arrowRight" size={18} class="i-arrow" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding: calc(var(--header-h) + 4rem) 0 clamp(4rem, 9vw, 7rem);
    background: linear-gradient(180deg, var(--cream), var(--sand));
  }
  .nf-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 760px;
    text-align: center;
  }
  .nf-ic {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    margin-bottom: 1.3rem;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(135deg, var(--blue-500), var(--blue-800));
  }
  h1 {
    margin-top: 1rem;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
  }
  .nf-text {
    margin-top: 1rem;
    font-size: 1.08rem;
    color: var(--muted);
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 2rem;
  }
  .nf-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 1.15rem;
    border-radius: 999px;
    font-weight: 600;
    color: var(--blue-700);
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }
  .nf-links a:hover {
    border-color: var(--blue-200);
  }
  .nf-sub {
    margin-top: 2rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--muted);
  }
  .nf-links--soft {
    margin: 0.8rem 0 2.2rem;
  }
  .nf-links--soft a {
    padding: 0.5rem 0.95rem;
    font-size: 0.9rem;
    background: var(--blue-50);
    border-color: var(--blue-100);
    box-shadow: none;
  }
</style>
