---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import nadege from '../../assets/images/nadege.jpg';
import { site, zone } from '../../data/site';
import { articleUrl, categoryIcon, formatDate, getConseils, readingTime, type Conseil } from '../../utils/conseils';

export async function getStaticPaths() {
  const articles = await getConseils();
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry, articles } }));
}

interface Props {
  entry: Conseil;
  articles: Conseil[];
}
const { entry, articles } = Astro.props;
const { Content } = await render(entry);
const { title, description, category, date, updated } = entry.data;
const minutes = readingTime(entry.body);
const url = `${site.url}${articleUrl(entry)}`;

// Articles associés : même thème d'abord, puis les plus récents
const related = articles
  .filter((a) => a.id !== entry.id)
  .sort((a, b) => Number(b.data.category === category) - Number(a.data.category === category))
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title,
      description,
      url,
      mainEntityOfPage: url,
      datePublished: date.toISOString(),
      dateModified: (updated ?? date).toISOString(),
      inLanguage: 'fr-FR',
      articleSection: category,
      image: `${site.url}/images/og-image.jpg`,
      author: { '@type': 'Person', name: site.owner, jobTitle: site.role },
      publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: `${site.url}/images/logo.png` } },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Conseils', item: `${site.url}/conseils.html` },
        { '@type': 'ListItem', position: 3, name: title, item: url },
      ],
    },
  ],
};
---

<BaseLayout title={`${title} | ${site.name}`} description={description} jsonLd={jsonLd}>
  <header class="a-hero">
    <div class="container a-hero-inner">
      <nav class="crumbs" aria-label="Fil d’Ariane">
        <a href="/">Accueil</a>
        <span aria-hidden="true">/</span>
        <a href="/conseils.html">Conseils</a>
      </nav>
      <span class="tag">
        <Icon name={categoryIcon[category] ?? 'book'} size={14} strokeWidth={2} />
        {category}
      </span>
      <h1>{title}</h1>
      <p class="a-lead">{description}</p>
      <div class="a-meta">
        <Image src={nadege} alt="" width={88} height={88} class="a-avatar" loading="eager" />
        <span>
          Par <strong>{site.owner}</strong><br />
          <time datetime={date.toISOString()}>{formatDate(date)}</time> · {minutes} min de lecture
        </span>
      </div>
    </div>
  </header>

  <section class="section a-body">
    <div class="container a-grid">
      <article class="prose" data-reveal>
        <Content />
      </article>

      <aside class="a-aside">
        <div class="author" data-reveal>
          <Image src={nadege} alt={site.owner} width={160} height={160} class="author-photo" loading="lazy" />
          <p class="author-name">{site.owner}</p>
          <p class="author-role">{site.role} en gestion administrative et financière</p>
          <p class="author-zone"><Icon name="mapPin" size={15} />{zone.short}</p>
          <a href="/#rendez-vous" class="btn btn--sm">
            Échange gratuit de 30 min <Icon name="arrowRight" size={16} class="i-arrow" />
          </a>
        </div>
      </aside>
    </div>

    <div class="container">
      <div class="a-cta" data-reveal>
        <h2>Vous souhaitez déléguer ce sujet ?</h2>
        <p>
          Je prends en charge votre gestion de façon <strong>opérationnelle</strong>, en présentiel dans l’Eure et en
          Seine-Maritime, ou à distance.
        </p>
        <div class="a-cta-actions">
          <a href="/#rendez-vous" class="btn">Prendre rendez-vous <Icon name="arrowRight" size={18} class="i-arrow" /></a>
          <a href="/#devis" class="btn btn--ghost">Demander un devis</a>
        </div>
      </div>

      {
        related.length > 0 && (
          <div class="related">
            <h2 class="related-title" data-reveal>À lire aussi</h2>
            <div class="related-grid">
              {related.map((a, i) => (
                <ArticleCard entry={a} delay={i} headingLevel="h3" />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* — En-tête de l'article — */
  .a-hero {
    padding: calc(var(--header-h) + 3.5rem) 0 clamp(2.5rem, 5vw, 3.5rem);
    background:
      radial-gradient(50% 60% at 100% 0%, rgb(226 137 90 / 0.18), transparent 70%),
      linear-gradient(180deg, var(--cream), var(--sand));
  }
  .a-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 860px;
    text-align: center;
    animation: rise 0.9s var(--ease-out) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 20px;
    }
  }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.4rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--muted);
  }
  .crumbs a {
    color: var(--blue-700);
  }
  .crumbs a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  h1 {
    margin-top: 1.1rem;
    font-size: clamp(2.1rem, 4.6vw, 3.3rem);
    letter-spacing: -0.025em;
  }
  .a-lead {
    max-width: 44rem;
    margin-top: 1.1rem;
    font-size: 1.12rem;
    color: var(--muted);
  }
  .a-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.8rem;
    font-size: 0.88rem;
    line-height: 1.5;
    text-align: left;
    color: var(--muted);
  }
  .a-meta :global(.a-avatar) {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 51% 28%;
    border: 2px solid #fff;
    box-shadow: 0 0 0 2px var(--blue-100);
  }

  /* — Corps — */
  .a-body {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    background: var(--white);
  }
  .a-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: clamp(2rem, 5vw, 4rem);
    max-width: 1080px;
    align-items: start;
  }
  .prose {
    max-width: 44rem;
    font-size: 1.08rem;
    line-height: 1.8;
    color: var(--text);
  }
  .prose :global(p) {
    margin-top: 1.1rem;
  }
  .prose :global(h2) {
    margin-top: 2.6rem;
    padding-top: 0.2rem;
    font-size: clamp(1.45rem, 2.4vw, 1.8rem);
  }
  .prose :global(h3) {
    margin-top: 1.8rem;
    font-size: 1.25rem;
  }
  .prose :global(h2 + p),
  .prose :global(h3 + p) {
    margin-top: 0.7rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.1rem;
    padding-left: 0.2rem;
  }
  .prose :global(li) {
    position: relative;
    padding-left: 1.6rem;
  }
  .prose :global(ul li::before) {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.75em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--blue-600);
    box-shadow: 0 0 0 3px var(--blue-100);
  }
  .prose :global(a) {
    font-weight: 600;
    color: var(--blue-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose > :global(p:first-child) {
    margin-top: 0;
    font-size: 1.18rem;
    color: var(--ink);
  }

  .a-aside {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  .author {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 1.6rem;
    text-align: center;
    border-radius: var(--radius-lg);
    background: var(--cream);
    border: 1px solid var(--line);
  }
  .author :global(.author-photo) {
    width: 80px;
    height: 80px;
    margin-bottom: 0.5rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: 51% 28%;
  }
  .author-name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--ink);
  }
  .author-role {
    font-size: 0.86rem;
    color: var(--muted);
  }
  .author-zone {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.3rem 0 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--blue-700);
  }

  .a-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    max-width: 52rem;
    margin: clamp(3rem, 6vw, 4.5rem) auto 0;
    padding: clamp(1.8rem, 4vw, 2.6rem);
    text-align: center;
    border-radius: var(--radius-lg);
    color: rgb(255 255 255 / 0.78);
    background:
      radial-gradient(80% 90% at 100% 0%, rgb(203 106 51 / 0.35), transparent 60%),
      linear-gradient(140deg, var(--blue-700), var(--blue-900));
  }
  .a-cta h2 {
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    color: #fff;
  }
  .a-cta :global(strong) {
    color: #fff;
  }
  .a-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .related {
    margin-top: clamp(3.5rem, 7vw, 5rem);
  }
  .related-title {
    margin-bottom: 2rem;
    text-align: center;
    font-size: clamp(1.7rem, 3vw, 2.2rem);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 960px) {
    .a-grid {
      grid-template-columns: 1fr;
    }
    .a-aside {
      position: static;
    }
    .prose {
      margin-inline: auto;
    }
    .related-grid {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin-inline: auto;
    }
  }
</style>
