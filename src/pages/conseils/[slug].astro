---
import { render } from 'astro:content';
import { Image, Picture, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ArticleCover from '../../components/ArticleCover.astro';
import Icon from '../../components/Icon.astro';
import ShareBar from '../../components/ShareBar.astro';
import nadege from '../../assets/images/nadege.jpg';
import { site, zone } from '../../data/site';
import { articleUrl, categories, formatDate, getConseils, lengthFormat, readingTime, type Conseil } from '../../utils/conseils';

export async function getStaticPaths() {
  const articles = await getConseils();
  // Navigation précédent / suivant dans l'ordre chronologique de publication
  const chrono = [...articles].sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return chrono.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, articles, prev: chrono[i - 1], next: chrono[i + 1] },
  }));
}

interface Props {
  entry: Conseil;
  articles: Conseil[];
  prev?: Conseil;
  next?: Conseil;
}
const { entry, articles, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, category, date, updated, keyPoints } = entry.data;
const minutes = readingTime(entry.body);
const url = `${site.url}${articleUrl(entry)}`;
const toc = headings.filter((h) => h.depth === 2);
const theme = categories[category];
const format = lengthFormat(minutes);
const { cover, coverAlt, coverCredit } = entry.data;

// Image de partage propre à l'article (1200×630, recadrée)
const shareImage = cover
  ? (await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src
  : undefined;
const shareImageUrl = new URL(shareImage ?? '/images/og-image.jpg', site.url).href;

// Articles associés : même thème d'abord, puis les autres
const related = articles
  .filter((a) => a.id !== entry.id)
  .sort((a, b) => Number(b.data.category === category) - Number(a.data.category === category))
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title,
      description,
      url,
      mainEntityOfPage: url,
      datePublished: date.toISOString(),
      dateModified: (updated ?? date).toISOString(),
      inLanguage: 'fr-FR',
      articleSection: category,
      wordCount: entry.body?.trim().split(/\s+/).length,
      image: shareImageUrl,
      author: { '@type': 'Person', name: site.owner, jobTitle: site.role },
      publisher: {
        '@type': 'Organization',
        name: site.name,
        logo: { '@type': 'ImageObject', url: `${site.url}/images/logo.png` },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Conseils', item: `${site.url}/conseils.html` },
        { '@type': 'ListItem', position: 3, name: title, item: url },
      ],
    },
  ],
};
---

<BaseLayout title={`${title} | ${site.name}`} description={description} jsonLd={jsonLd} image={shareImageUrl} ogType="article">
  <div class="read-progress" aria-hidden="true"><span data-read-progress></span></div>

  <!-- ============ En-tête ============ -->
  <header class="a-hero">
    <div class="container a-hero-inner">
      <nav class="crumbs" aria-label="Fil d’Ariane">
        <a href="/">Accueil</a>
        <span aria-hidden="true">/</span>
        <a href="/conseils.html">Conseils</a>
        <span aria-hidden="true">/</span>
        <a href={`/conseils.html?theme=${theme.slug}`}>{category}</a>
      </nav>
      <h1>{title}</h1>
      <p class="a-lead">{description}</p>
      <div class="a-meta">
        <Image src={nadege} alt="" width={88} height={88} class="a-avatar" loading="eager" />
        <span class="a-meta-text">
          <strong>{site.owner}</strong>
          <span>
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
            <span aria-hidden="true">·</span>
            <span class="a-time"><Icon name="clock" size={14} />{minutes} min de lecture</span>
            <span aria-hidden="true">·</span>
            <span class:list={['a-format', `len-${format.key}`]}>{format.label}</span>
          </span>
        </span>
      </div>
      <ShareBar url={url} title={title} text={description} class="hero-share" />
    </div>
    <div class="container a-cover-wrap">
      {
        cover ? (
          <figure class="a-figure">
            <Picture
              src={cover}
              alt={coverAlt}
              formats={['avif', 'webp']}
              widths={[640, 1000, 1600]}
              sizes="(max-width: 1060px) 100vw, 1000px"
              loading="eager"
              fetchpriority="high"
              class="a-photo"
            />
            {coverCredit && (
              <figcaption>
                Photo : <a href={coverCredit.url} target="_blank" rel="noopener">{coverCredit.name}</a> / Unsplash
              </figcaption>
            )}
          </figure>
        ) : (
          <ArticleCover category={category} size="lg" class="a-cover" />
        )
      }
    </div>
  </header>

  <!-- ============ Article ============ -->
  <section class="a-body">
    <div class="container a-layout">
      <aside class="a-aside">
        {
          toc.length > 1 && (
            <details class="toc" open data-toc>
              <summary>
                <Icon name="list" size={17} /> Sommaire
                <Icon name="chevronDown" size={16} class="toc-chevron" />
              </summary>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} data-toc-link={h.slug}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }
        <div class="aside-share">
          <p class="share-title">Partager l’article</p>
          <ShareBar url={url} title={title} text={description} print />
        </div>
      </aside>

      <div class="a-content">
        {
          keyPoints.length > 0 && (
            <div class="keypoints">
              <p class="kp-title">
                <Icon name="checkCircle" size={20} /> L’essentiel en 30 secondes
              </p>
              <ul>
                {keyPoints.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          )
        }

        <article class="prose" data-prose>
          <Content />
        </article>

        <!-- Fin d'article : partage + autrice -->
        <div class="a-end">
          <div class="end-share" id="partager">
            <p class="end-share-title">Cet article vous a été utile ?</p>
            <p class="end-share-text">Partagez-le avec un dirigeant, un associé ou un collègue à qui il pourrait servir.</p>
            <ShareBar url={url} title={title} text={description} variant="full" print />
          </div>
          <div class="author">
            <Image src={nadege} alt={site.owner} width={192} height={192} class="author-photo" loading="lazy" />
            <div>
              <p class="author-kicker">À propos de l’autrice</p>
              <p class="author-name">{site.owner}</p>
              <p class="author-text">
                {site.role} en gestion administrative et financière, j’accompagne les TPE, artisans et professions
                libérales en {zone.region} ({zone.departments.map((d) => d.code).join(' et ')}), sur site ou à distance.
              </p>
              <a href="/#a-propos" class="author-link">En savoir plus <Icon name="arrowRight" size={15} /></a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <!-- Appel à l'action -->
      <div class="a-cta">
        <h2>Vous souhaitez déléguer ce sujet ?</h2>
        <p>
          Je prends en charge votre gestion de façon <strong>opérationnelle</strong>, en présentiel dans l’Eure et en
          Seine-Maritime, ou à distance. Premier échange gratuit et sans engagement.
        </p>
        <div class="a-cta-actions">
          <a href="/#rendez-vous" class="btn">Réserver un échange gratuit <Icon name="arrowRight" size={18} class="i-arrow" /></a>
          <a href="/#devis" class="btn btn--ghost">Demander un devis</a>
        </div>
      </div>

      <!-- Article précédent / suivant -->
      <nav class="pager" aria-label="Autres articles">
        {
          prev ? (
            <a href={articleUrl(prev)} class="pager-link">
              <span class="pager-dir"><Icon name="arrowLeft" size={16} /> Article précédent</span>
              <span class="pager-title">{prev.data.title}</span>
            </a>
          ) : <span />
        }
        {
          next ? (
            <a href={articleUrl(next)} class="pager-link pager-link--next">
              <span class="pager-dir">Article suivant <Icon name="arrowRight" size={16} /></span>
              <span class="pager-title">{next.data.title}</span>
            </a>
          ) : <span />
        }
      </nav>

      {
        related.length > 0 && (
          <div class="related">
            <h2 class="related-title" data-reveal>À lire aussi</h2>
            <div class="related-grid">
              {related.map((a, i) => (
                <ArticleCard entry={a} delay={i} headingLevel="h3" />
              ))}
            </div>
            <div class="related-all">
              <a href="/conseils.html" class="btn btn--ghost">
                Tous les conseils <Icon name="arrowRight" size={18} class="i-arrow" />
              </a>
            </div>
          </div>
        )
      }
    </div>
  </section>
  <button type="button" class="fab-share" data-fab-share aria-label="Partager l’article">
    <Icon name="share" size={20} />
  </button>
</BaseLayout>

<script>
  /* Barre de progression de lecture */
  const bar = document.querySelector<HTMLElement>('[data-read-progress]');
  const prose = document.querySelector<HTMLElement>('[data-prose]');
  function updateProgress() {
    if (!bar || !prose) return;
    const r = prose.getBoundingClientRect();
    const total = r.height - window.innerHeight * 0.6;
    const p = Math.min(1, Math.max(0, (window.innerHeight * 0.25 - r.top) / Math.max(1, total)));
    bar.style.transform = `scaleX(${p})`;
  }
  window.addEventListener('scroll', () => requestAnimationFrame(updateProgress), { passive: true });
  updateProgress();

  /* Sommaire : section en cours mise en évidence */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const targets = links.map((l) => document.getElementById(l.dataset.tocLink ?? '')).filter(Boolean) as HTMLElement[];
  if (targets.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((l) => l.classList.toggle('is-active', l.dataset.tocLink === e.target.id));
        });
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    targets.forEach((t) => observer.observe(t));
  }

  /* Sommaire replié par défaut sur mobile */
  const toc = document.querySelector<HTMLDetailsElement>('[data-toc]');
  if (toc && window.matchMedia('(max-width: 1023px)').matches) toc.open = false;
  links.forEach((l) =>
    l.addEventListener('click', () => {
      if (toc && window.matchMedia('(max-width: 1023px)').matches) toc.open = false;
    }),
  );

  /* Bouton flottant de partage (mobile) : menu natif du téléphone, sinon bloc de partage */
  const fab = document.querySelector<HTMLButtonElement>('[data-fab-share]');
  fab?.addEventListener('click', async () => {
    if (typeof navigator.share === 'function') {
      try {
        await navigator.share({ title: document.title, url: location.href });
      } catch {
        /* partage annulé */
      }
      return;
    }
    document.getElementById('partager')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
</script>

<style>
  /* ============ Progression de lecture ============ */
  .read-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 80;
    height: 3px;
    pointer-events: none;
  }
  .read-progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--blue-600), var(--terra-500));
    transform: scaleX(0);
    transform-origin: left;
  }

  /* ============ En-tête ============ */
  .a-hero {
    padding-top: calc(var(--header-h) + 3.25rem);
    background:
      radial-gradient(50% 60% at 100% 0%, rgb(226 137 90 / 0.16), transparent 70%),
      linear-gradient(180deg, var(--cream), var(--sand) 75%, var(--white) 75%);
  }
  .a-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 860px;
    text-align: center;
    animation: rise 0.9s var(--ease-out) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 20px;
    }
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--muted);
  }
  .crumbs a {
    color: var(--blue-700);
  }
  .crumbs a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  h1 {
    font-size: clamp(2.1rem, 4.8vw, 3.4rem);
    letter-spacing: -0.025em;
  }
  .a-lead {
    max-width: 42rem;
    margin-top: 1rem;
    font-size: 1.12rem;
    color: var(--muted);
  }
  .a-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.6rem;
    text-align: left;
  }
  .a-meta :global(.a-avatar) {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 51% 28%;
    border: 2px solid #fff;
    box-shadow: 0 0 0 2px var(--blue-100);
  }
  .a-meta-text {
    display: flex;
    flex-direction: column;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .a-meta-text > span {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .a-time {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .a-cover-wrap {
    max-width: 1000px;
    margin-top: 2.25rem;
    animation: rise 1s var(--ease-out) 0.15s both;
  }
  .a-format {
    font-weight: 700;
  }
  .len-express {
    color: var(--success);
  }
  .len-dossier {
    color: var(--terra-700);
  }
  .a-figure :global(picture) {
    display: block;
  }
  .a-figure :global(img) {
    width: 100%;
    height: clamp(220px, 38vw, 460px);
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 60px -34px rgb(13 21 48 / 0.55);
  }
  .a-figure figcaption {
    margin-top: 0.6rem;
    text-align: center;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .a-figure figcaption a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .a-cover-wrap :global(.a-cover) {
    height: clamp(170px, 26vw, 280px);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 60px -34px rgb(13 21 48 / 0.55);
  }

  /* ============ Mise en page ============ */
  .a-body {
    padding: clamp(2.5rem, 5vw, 3.5rem) 0 clamp(4rem, 8vw, 6rem);
    background: var(--white);
  }
  .a-layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 46rem);
    justify-content: center;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .a-aside {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: grid;
    gap: 1.25rem;
  }

  /* — Sommaire — */
  .toc {
    padding: 1.1rem 1.1rem 1.2rem;
    border-radius: var(--radius);
    background: var(--cream);
    border: 1px solid var(--line);
  }
  .toc summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  .toc summary::-webkit-details-marker {
    display: none;
  }
  .toc summary :global(.toc-chevron) {
    margin-left: auto;
    transition: transform 0.3s var(--ease-out);
  }
  .toc[open] summary :global(.toc-chevron) {
    transform: rotate(180deg);
  }
  .toc ol {
    display: grid;
    gap: 0.1rem;
    margin-top: 0.8rem;
    border-left: 2px solid var(--line);
  }
  .toc a {
    position: relative;
    display: block;
    padding: 0.4rem 0 0.4rem 0.9rem;
    font-size: 0.86rem;
    line-height: 1.4;
    color: var(--muted);
    transition: color 0.25s;
  }
  .toc a::before {
    content: '';
    position: absolute;
    left: -2px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--blue-700);
    transform: scaleY(0);
    transition: transform 0.3s var(--ease-out);
  }
  .toc a:hover {
    color: var(--ink);
  }
  .toc a:global(.is-active) {
    font-weight: 700;
    color: var(--blue-700);
  }
  .toc a:global(.is-active)::before {
    transform: scaleY(1);
  }

  /* — Partage — */
  .aside-share {
    padding: 1.1rem 0.9rem 1.6rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: #fff;
  }
  .share-title {
    margin-bottom: 0.8rem;
    text-align: center;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .a-hero-inner :global(.hero-share) {
    margin-top: 1.5rem;
  }
  .end-share {
    margin-bottom: 2rem;
    padding: 1.75rem 1.5rem 2.4rem;
    text-align: center;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--blue-50), #fff);
    border: 1px solid var(--blue-100);
  }
  .end-share-title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    color: var(--ink);
  }
  .end-share-text {
    margin: 0.4rem auto 1.25rem;
    max-width: 30rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .fab-share {
    position: fixed;
    left: 1.25rem;
    bottom: 1.25rem;
    z-index: 40;
    display: none;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(135deg, var(--terra-500), var(--terra-700));
    box-shadow: 0 14px 30px -12px rgb(178 83 31 / 0.7);
  }

  /* ============ L'essentiel ============ */
  .keypoints {
    margin-bottom: 2.25rem;
    padding: 1.4rem 1.5rem;
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--blue-50), #fff);
    border: 1px solid var(--blue-100);
  }
  .kp-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--blue-800);
  }
  .kp-title :global(svg) {
    color: var(--success);
  }
  .keypoints ul {
    display: grid;
    gap: 0.55rem;
  }
  .keypoints li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .keypoints li::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 0.7em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--blue-600);
  }

  /* ============ Texte de l'article ============ */
  .prose {
    font-size: 1.08rem;
    line-height: 1.8;
    color: var(--text);
  }
  .prose :global(p) {
    margin-top: 1.1rem;
  }
  .prose > :global(p:first-child) {
    margin-top: 0;
    font-size: 1.18rem;
    color: var(--ink);
  }
  .prose :global(h2) {
    margin-top: 2.8rem;
    font-size: clamp(1.45rem, 2.4vw, 1.85rem);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
  .prose :global(h3) {
    margin-top: 1.8rem;
    font-size: 1.25rem;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
  .prose :global(h2 + p),
  .prose :global(h3 + p) {
    margin-top: 0.7rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.1rem;
  }
  .prose :global(li) {
    position: relative;
    padding-left: 1.7rem;
  }
  .prose :global(ul > li::before) {
    content: '';
    position: absolute;
    left: 0.3rem;
    top: 0.75em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--blue-600);
    box-shadow: 0 0 0 3px var(--blue-100);
  }
  .prose :global(ol) {
    counter-reset: step;
  }
  .prose :global(ol > li) {
    counter-increment: step;
    padding-left: 2.4rem;
  }
  .prose :global(ol > li::before) {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.15em;
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    font-size: 0.82rem;
    font-weight: 800;
    color: #fff;
    background: var(--blue-700);
  }
  .prose :global(a) {
    font-weight: 600;
    color: var(--blue-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* Encadré "Bon à savoir" (citation Markdown) */
  .prose :global(blockquote) {
    position: relative;
    margin-top: 1.6rem;
    padding: 1.1rem 1.25rem 1.1rem 3.6rem;
    border-radius: var(--radius-sm);
    background: var(--terra-100);
    border: 1px solid rgb(178 83 31 / 0.15);
  }
  .prose :global(blockquote::before) {
    content: '';
    position: absolute;
    left: 1.15rem;
    top: 1.2rem;
    width: 1.5rem;
    height: 1.5rem;
    background: var(--terra-600);
