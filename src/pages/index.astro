---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Formulas from '../components/Formulas.astro';
import DiagnosticTeaser from '../components/DiagnosticTeaser.astro';
import About from '../components/About.astro';
import Reasons from '../components/Reasons.astro';
import Journey from '../components/Journey.astro';
import Cases from '../components/Cases.astro';
import Zone from '../components/Zone.astro';
import Network from '../components/Network.astro';
import PromiseBand from '../components/PromiseBand.astro';
import ConseilsTeaser from '../components/ConseilsTeaser.astro';
import Contact from '../components/Contact.astro';
import SideRail from '../components/SideRail.astro';
import { site } from '../data/site';
import { businessEntity, businessId } from '../utils/seo';

// Données structurées : entreprise locale + site (référencement local)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    businessEntity(),
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#site`,
      url: `${site.url}/`,
      name: site.name,
      inLanguage: 'fr-FR',
      publisher: { '@id': businessId },
    },
    {
      '@type': 'WebPage',
      '@id': `${site.url}/#accueil`,
      url: `${site.url}/`,
      name: `${site.name} — gestion administrative en Normandie`,
      inLanguage: 'fr-FR',
      isPartOf: { '@id': `${site.url}/#site` },
      about: { '@id': businessId },
    },
  ],
};
---

<BaseLayout
  home
  title="Gestion administrative externalisée en Normandie (27, 76) | SGC"
  description="Consultante en gestion administrative dans l’Eure et la Seine-Maritime : facturation, relances, trésorerie, RH et paie pour TPE, artisans et libéraux."
  ogTitle={`${site.name} — ${site.promise}`}
  ogDescription="Gestion administrative, trésorerie, RH, suivi de chantiers : un accompagnement opérationnel pour les TPE, artisans et professions libérales de l’Eure et de Seine-Maritime."
  jsonLd={jsonLd}
>
  <SideRail />
  <Hero />
  <Services />
  <DiagnosticTeaser />
  <Formulas />
  <About />
  <Reasons />
  <Journey />
  <Cases />
  <Zone />
  <Network />
  <ConseilsTeaser />
  <PromiseBand />
  <Contact />
</BaseLayout>
