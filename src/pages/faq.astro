---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { faqs, site } from '../data/site';

const stripTags = (html: string) => html.replace(/<[^>]+>/g, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) },
  })),
};
---

<BaseLayout
  title={`Questions fréquentes (FAQ) — ${site.name}`}
  description={`Tarifs, zone d’intervention, confidentialité, engagement… Les réponses aux questions les plus fréquentes sur l’accompagnement en gestion administrative de ${site.name}.`}
  jsonLd={jsonLd}
>
  <PageHero eyebrow="Questions fréquentes" title="Vous avez des <em>questions</em> ?" crumb="FAQ">
    <p class="page-intro">
      Voici les réponses aux questions les plus fréquemment posées avant de démarrer un accompagnement. Si la vôtre n’y
      figure pas, n’hésitez pas à me la poser directement.
    </p>
  </PageHero>

  <section class="section faq">
    <div class="container faq-grid">
      <div class="faq-list">
        {
          faqs.map((f, i) => (
            <details class="faq-item" data-reveal style={`--d:${i % 4}`} name="faq" open={i === 0}>
              <summary>
                <span class="q-text">{f.q}</span>
                <span class="q-toggle" aria-hidden="true">
                  <span />
                  <span />
                </span>
              </summary>
              <div class="answer">
                <p set:html={f.a} />
              </div>
            </details>
          ))
        }
      </div>

      <aside class="faq-aside" data-reveal="right">
        <div class="aside-card">
          <span class="aside-ic"><Icon name="message" size={26} /></span>
          <p class="aside-kicker">Une autre question ?</p>
          <h2>Parlons-en directement</h2>
          <p>N’hésitez pas à me contacter directement, je vous répondrai rapidement.</p>
          <a href="/#contact" class="btn btn--soft">
            Me poser une question <Icon name="arrowRight" size={18} class="i-arrow" />
          </a>
          <ul class="aside-links">
            <li>
              <a href={`mailto:${site.email}`}><Icon name="mail" size={17} />{site.emailLabel}</a>
            </li>
            <li>
              <a href={`tel:${site.phone}`}><Icon name="phone" size={17} />{site.phoneLabel}</a>
            </li>
            <li>
              <a href="/#rendez-vous"><Icon name="calendar" size={17} />Échange gratuit de 30 min</a>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .faq {
    padding-top: clamp(3rem, 6vw, 4.5rem);
    background: var(--white);
  }
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  .faq-list {
    display: grid;
    gap: 0.9rem;
  }
  .faq-item {
    border-radius: var(--radius);
    background: var(--cream);
    border: 1px solid var(--line);
    transition:
      background 0.4s,
      border-color 0.4s,
      box-shadow 0.4s;
  }
  .faq-item:hover {
    border-color: var(--sand-300);
  }
  .faq-item[open] {
    background: #fff;
    border-color: rgb(97 25 58 / 0.18);
    box-shadow: var(--shadow-md);
  }
  /* Ouverture fluide (navigateurs récents) */
  .faq-item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.5s var(--ease-out),
      content-visibility 0.5s allow-discrete;
  }
  .faq-item[open]::details-content {
    block-size: auto;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.3rem 1.4rem;
    cursor: pointer;
    list-style: none;
    border-radius: inherit;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .q-text {
    flex: 1;
    font-family: var(--font-display);
    font-size: clamp(1.08rem, 1.6vw, 1.25rem);
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink);
    transition: color 0.3s;
  }
  summary:hover .q-text {
    color: var(--blue-700);
  }
  .q-toggle {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--line);
    transition:
      background 0.4s,
      border-color 0.4s,
      rotate 0.5s var(--ease-out);
  }
  .q-toggle span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    border-radius: 2px;
    background: var(--blue-700);
    translate: -50% -50%;
    transition:
      rotate 0.5s var(--ease-out),
      background 0.3s;
  }
  .q-toggle span:last-child {
    rotate: 90deg;
  }
  .faq-item[open] .q-toggle {
    background: var(--blue-700);
    border-color: var(--blue-700);
    rotate: 180deg;
  }
  .faq-item[open] .q-toggle span {
    background: #fff;
  }
  .faq-item[open] .q-toggle span:last-child {
    rotate: 0deg;
  }
  .answer {
    padding: 0 1.4rem 1.4rem;
  }
  .answer p {
    font-size: 0.98rem;
    color: var(--text);
  }
  .answer :global(a) {
    font-weight: 700;
    color: var(--blue-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .faq-item[open] .answer p {
    animation: reveal-up 0.6s var(--ease-out);
  }

  .faq-aside {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  .aside-card {
    position: relative;
    overflow: hidden;
    padding: 2rem;
    border-radius: var(--radius-lg);
    color: #fff;
    background:
      radial-gradient(80% 60% at 100% 0%, rgb(229 129 188 / 0.2), transparent 60%),
      linear-gradient(150deg, var(--blue-700), var(--blue-900));
    box-shadow: var(--shadow-lg);
  }
  .aside-ic {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    color: #fff;
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(255 255 255 / 0.2);
  }
  .aside-kicker {
    margin-top: 1.4rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--terra-400);
  }
  .aside-card h2 {
    margin: 0.4rem 0 0.7rem;
    font-size: 1.7rem;
    color: #fff;
  }
  .aside-card > p {
    font-size: 0.96rem;
  }
  .aside-card .btn {
    width: 100%;
    margin-top: 1.5rem;
  }
  .aside-links {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }
  .aside-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #fff;
    transition: color 0.3s;
  }
  .aside-links a:hover {
    color: var(--terra-400);
  }

  @media (max-width: 960px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
    .faq-aside {
      position: static;
    }
  }
  @media (max-width: 520px) {
    .answer {
      padding-left: 1.4rem;
    }
    summary {
      padding: 1.1rem 1.1rem;
      gap: 0.75rem;
    }
  }

  /* ============ Centrage des textes ============ */
  /* Un espace symétrique au bouton +/- garde la question parfaitement centrée */
  summary::before {
    content: '';
    flex: none;
    width: 36px;
  }
  .q-text,
  .answer {
    text-align: center;
  }
  .aside-card {
    text-align: center;
  }
  .aside-ic {
    margin-inline: auto;
  }
  .aside-kicker {
    color: #fff;
  }
  .aside-links {
    justify-items: center;
  }
</style>
