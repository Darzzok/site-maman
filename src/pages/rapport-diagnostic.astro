---
/**
 * Rapport du diagnostic de gestion, à remettre au client lors du bilan.
 * Ouvert depuis le lien reçu par e-mail (/rapport-diagnostic.html#<code>) : le contenu est recalculé à partir
 * du code (réponses uniquement). Nadège complète les zones en pointillés (client, tarif, notes…) puis
 * enregistre la page en PDF (4 pages A4). Page non indexée.
 */
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { formulas, services, site } from '../data/site';
import { domains } from '../data/diagnostic';

const formulaList = formulas.items.map((f) => ({ ...f, text: f.text.replace(/<[^>]+>/g, '') }));
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Rapport de diagnostic de gestion | {site.name}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="rp-body">
    <!-- Barre d'outils (écran uniquement) -->
    <header class="rp-toolbar">
      <img src="/images/logo-mark.png" alt="" class="rp-tb-logo" width="34" height="34" />
      <div class="rp-tb-text">
        <strong>Rapport de diagnostic</strong>
        <span>Complétez les zones en pointillés (nom du client, tarif, notes…), puis enregistrez en PDF.</span>
      </div>
      <button type="button" class="rp-tb-reset" data-reset>Effacer mes saisies</button>
      <button type="button" class="btn btn--sm" data-print><Icon name="printer" size={16} /> Enregistrer en PDF</button>
    </header>

    <p class="rp-error" data-error hidden>
      Ce lien de rapport est incomplet ou invalide. Ouvrez le lien tel qu’il figure dans l’e-mail du diagnostic.
    </p>

    <main class="rp" data-report hidden>
      <!-- ============ 1. Couverture ============ -->
      <section class="sheet cover">
        <div class="cover-glow" aria-hidden="true"></div>
        <img src="/images/logo-full.png" alt={site.name} class="cover-logo" />
        <p class="kicker">Diagnostic de gestion</p>
        <h1>Votre diagnostic de <em>gestion</em></h1>
        <div class="cover-for">
          <span class="cover-label">Préparé pour</span>
          <span class="fill fill--xl" contenteditable="plaintext-only" data-field="client" data-ph="Nom du client"></span>
          <span class="fill fill--lg" contenteditable="plaintext-only" data-field="entreprise" data-ph="Entreprise"></span>
        </div>
        <ul class="cover-chips" data-profile></ul>

        <div class="cover-score">
          <div class="ring">
            <svg viewBox="0 0 200 200" aria-hidden="true">
              <defs>
                <linearGradient id="rp-grad" gradientUnits="userSpaceOnUse" x1="16" y1="0" x2="184" y2="0" gradientTransform="rotate(-135 100 100)">
                  <stop offset="0" stop-color="#e97e0d"></stop>
                  <stop offset="0.5" stop-color="#f6b55b"></stop>
                  <stop offset="1" stop-color="#61193a"></stop>
                </linearGradient>
              </defs>
              <circle class="ring-track" cx="100" cy="100" r="84" pathLength="100"></circle>
              <circle class="ring-value" cx="100" cy="100" r="84" pathLength="100" stroke="url(#rp-grad)" data-ring></circle>
            </svg>
            <div class="ring-center">
              <span class="ring-num"><span data-score></span><small>/100</small></span>
              <span class="ring-cap">Score global</span>
            </div>
          </div>
          <div class="cover-level">
            <p class="level-badge" data-level></p>
            <p class="level-text" data-level-text></p>
            <ul class="mini-bars" data-mini-bars></ul>
          </div>
        </div>

        <footer class="cover-foot">
          <img src="/images/nadege.jpg" alt="" class="cover-photo" />
          <div>
            <p class="cover-by">Présenté par <strong>{site.owner}</strong></p>
            <p>{site.name} · Gestion administrative et financière · Eure (27) et Seine-Maritime (76)</p>
            <p>{site.emailLabel}{site.phoneIsSet && ` · ${site.phoneLabel}`}</p>
          </div>
        </footer>
      </section>

      <!-- ============ 2. Synthèse ============ -->
      <section class="sheet">
        <header class="sheet-head">
          <p class="kicker">1 · Synthèse</p>
          <h2>Ce que révèle votre <em>diagnostic</em></h2>
        </header>
        <div class="doms" data-doms></div>

        <div class="stakes" data-stakes>
          <p class="stakes-kicker">Ce que votre gestion vous coûte aujourd’hui</p>
          <div class="stakes-grid" data-stakes-grid></div>
          <p class="stakes-note">
            Estimations établies à partir des réponses : milieu de la tranche de chiffre d’affaires, délais de facturation et
            de paiement comparés à une facture envoyée tout de suite et payée à 30 jours, journées de 7 heures.
          </p>
        </div>

        <div class="strengths" data-strengths-wrap>
          <p class="block-title">Vos points forts</p>
          <ul data-strengths></ul>
        </div>
        <p class="sheet-num">2</p>
      </section>

      <!-- ============ 3. Plan d'action ============ -->
      <section class="sheet">
        <header class="sheet-head">
          <p class="kicker">2 · Plan d’action</p>
          <h2>Votre plan sur <em>90 jours</em></h2>
          <p class="sheet-intro">Les trois chantiers prioritaires, un par mois, puis les points à consolider.</p>
        </header>
        <ol class="months" data-months></ol>
        <div class="later" data-later-wrap>
          <p class="block-title">Ensuite, à consolider</p>
          <table class="later-table">
            <thead><tr><th>Action</th><th>Domaine</th><th>Prestation</th></tr></thead>
            <tbody data-later></tbody>
          </table>
        </div>
        <div class="notes">
          <p class="block-title">Notes de l’entretien</p>
          <div class="fill fill--area" contenteditable="plaintext-only" data-field="notes" data-ph="Points abordés, précisions du client, décisions…"></div>
        </div>
        <p class="sheet-num">3</p>
      </section>

      <!-- ============ 4. Proposition ============ -->
      <section class="sheet">
        <header class="sheet-head">
          <p class="kicker">3 · Proposition d’accompagnement</p>
          <h2>Ce que je vous <em>propose</em></h2>
        </header>

        <div class="formulas" data-formulas>
          {
            formulaList.map((f) => (
              <div class="formula" data-formula={f.title}>
                <span class="formula-badge">Recommandée pour vous</span>
                <span class="formula-ic">
                  <Icon name={f.icon} size={20} />
                </span>
                <p class="formula-title">{f.title}</p>
                <p class="formula-for">{f.for}</p>
                <p class="formula-text">{f.text}</p>
              </div>
            ))
          }
        </div>
        <p class="formula-reason" data-formula-reason></p>

        <div class="offer">
          <div class="offer-services">
            <p class="block-title">Prestations concernées</p>
            <ul data-services></ul>
          </div>
          <div class="offer-price">
            <p class="block-title">Votre investissement</p>
            <dl class="price-list">
              <div><dt>Formule</dt><dd class="fill" contenteditable="plaintext-only" data-field="formule" data-ph="Formule retenue"></dd></div>
              <div><dt>Volume</dt><dd class="fill" contenteditable="plaintext-only" data-field="volume" data-ph="ex. 8 h par mois"></dd></div>
              <div><dt>Tarif</dt><dd class="fill" contenteditable="plaintext-only" data-field="tarif" data-ph="ex. … € HT par mois"></dd></div>
              <div><dt>Démarrage</dt><dd class="fill" contenteditable="plaintext-only" data-field="demarrage" data-ph="ex. 1er novembre"></dd></div>
            </dl>
            <p class="price-gain" data-gain></p>
          </div>
        </div>

        <div class="next-steps">
          <p class="block-title">Prochaines étapes</p>
          <ol>
            <li><span>1</span>Validation de la proposition</li>
            <li><span>2</span>Réunion de lancement et accès aux documents</li>
            <li><span>3</span>Premiers résultats dès le 1er mois</li>
          </ol>
        </div>

        <div class="agree">
          <div class="agree-text">
            <p class="block-title">Bon pour accord</p>
            <p>Sans engagement de durée · Présentiel, distanciel ou les deux · Devis détaillé sur demande</p>
          </div>
          <div class="agree-sign">
            <p>Date : <span class="fill fill--line" contenteditable="plaintext-only" data-field="date" data-ph=" "></span></p>
            <p>Signature du client :</p>
            <div class="sign-box"></div>
          </div>
        </div>
        <footer class="sheet-foot">
          {site.owner} · {site.name} · {site.emailLabel}
        </footer>
        <p class="sheet-num">4</p>
      </section>
    </main>

    <!-- Icônes reprises par le script -->
    <div hidden data-icon-bank>
      {
        domains.map((d) => (
          <span data-icon={d.id}>
            <Icon name={d.icon} size={18} />
          </span>
        ))
      }
      <span data-icon="check"><Icon name="check" size={12} strokeWidth={3.2} /></span>
      <span data-icon="wallet"><Icon name="wallet" size={20} /></span>
      <span data-icon="clock"><Icon name="clock" size={20} /></span>
      <span data-icon="help"><Icon name="lightbulb" size={15} /></span>
    </div>

    <script is:inline type="application/json" id="rp-services" set:html={JSON.stringify(services.map((s) => ({ title: s.title, points: s.points ?? [] })))} />

    <script>
      import { activites, chiffresAffaires, domains, serviceByQuestion } from '../data/diagnostic';
      import { computeDiagnostic, decodeDiagnostic, levelLabel, levelOf, money, recommendFormula } from '../utils/diagnostic';
      import { site } from '../data/site';

      const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
      const icon = (name: string) => document.querySelector(`[data-icon-bank] [data-icon="${name}"]`)?.innerHTML ?? '';
      const el = (tag: string, cls: string, text?: string) => {
        const e = document.createElement(tag);
        if (cls) e.className = cls;
        if (text !== undefined) e.textContent = text;
        return e;
      };

      const code = decodeURIComponent(location.hash.slice(1));
      const decoded = decodeDiagnostic(code);
      if (!decoded) $('[data-error]').hidden = false;
      else render(decoded.input, decoded.date);

      function render(input: Parameters<typeof computeDiagnostic>[0], date: Date) {
        const r = computeDiagnostic(input);
        $('[data-report]').hidden = false;

        /* ---------- Couverture ---------- */
        const act = activites.find((a) => a.value === input.activite);
        const chips = [
          act?.label,
          input.effectif ? `${input.effectif === 'Seul(e)' ? 'Dirigeant seul' : `${input.effectif} personnes`}` : '',
          input.ca === undefined || chiffresAffaires[input.ca].value === null ? '' : `CA ${chiffresAffaires[input.ca].label}`,
          `Diagnostic du ${date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}`,
        ].filter(Boolean) as string[];
        $('[data-profile]').replaceChildren(...chips.map((c) => el('li', '', c)));
        $('[data-score]').textContent = String(r.global);
        $<SVGCircleElement>('[data-ring]').style.strokeDasharray = `${(r.global * 0.75).toFixed(2)} 100`;
        $('[data-level]').textContent = r.level.label;
        $('[data-level]').dataset.level = levelOf(r.global);
        $('[data-level-text]').textContent = r.level.text;
        $('[data-mini-bars]').replaceChildren(
          ...r.dom.map((x) => {
            const li = el('li', 'mini');
            li.dataset.level = x.level;
            li.style.setProperty('--pct', `${x.pct}%`);
            li.append(el('span', 'mini-label', x.d.short), el('span', 'mini-bar'), el('span', 'mini-pct', `${x.pct} %`));
            li.querySelector('.mini-bar')!.append(el('span', ''));
            return li;
          }),
        );

        /* ---------- Synthèse ---------- */
        $('[data-doms]').replaceChildren(
          ...r.dom.map((x) => {
            const card = el('div', 'dom');
            card.dataset.level = x.level;
            card.style.setProperty('--pct', `${x.pct}%`);
            card.innerHTML = `<span class="dom-ic">${icon(x.d.id)}</span>`;
            const body = el('div', 'dom-body');
            const head = el('div', 'dom-head');
            head.append(el('p', 'dom-title', x.d.label), el('span', 'dom-badge', levelLabel[x.level]), el('span', 'dom-pct', `${x.pct} %`));
            const bar = el('span', 'dom-bar');
            bar.append(el('span', ''));
            body.append(head, bar, el('p', 'dom-text', x.d.comments[x.level]));
            card.append(body);
            return card;
          }),
        );

        const stakes: HTMLElement[] = [];
        const stake = (ic: string, num: string, label: string, sub: string) => {
          const s = el('div', 'stake');
          s.innerHTML = `<span class="stake-ic">${icon(ic)}</span>`;
          s.append(el('span', 'stake-num', num), el('span', 'stake-label', label), el('span', 'stake-sub', sub));
          return s;
        };
        if (r.cash)
          stakes.push(
            stake('wallet', `≈ ${money(r.cash)}`, 'de trésorerie qui dort chez vos clients', `Environ ${r.totalDays} jours entre la fin de la prestation et le paiement.`),
          );
        else
          stakes.push(
            stake('wallet', `${r.totalDays} jours`, 'entre la fin de la prestation et le paiement', r.cash === 0 ? 'Des délais déjà courts : un vrai atout.' : 'Montant non estimé (chiffre d’affaires non communiqué).'),
          );
        if (r.daysYear !== null)
          stakes.push(stake('clock', `≈ ${r.daysYear} jours`, 'de travail par an consacrés à l’administratif', `Soit environ ${r.hours} heures par mois.`));
        $('[data-stakes-grid]').replaceChildren(...stakes);

        $('[data-strengths-wrap]').hidden = !r.strengths.length;
        $('[data-strengths]').replaceChildren(
          ...r.strengths.map((x) => {
            const li = el('li', '');
            li.innerHTML = `<span class="sf-ic">${icon('check')}</span>`;
            li.append(x.q.strength);
            return li;
          }),
        );

        /* ---------- Plan sur 90 jours ---------- */
        const top = r.todo.slice(0, 3);
        const months = ['Mois 1', 'Mois 2', 'Mois 3'];
        $('[data-months]').replaceChildren(
          ...(top.length
            ? top.map((x, k) => {
                const d = domains.find((dd) => dd.id === x.q.domain)!;
                const li = el('li', 'month');
                li.dataset.level = x.score! <= 1 ? 'low' : 'mid';
                li.append(el('span', 'month-num', months[k]));
                const head = el('div', 'month-head');
                head.innerHTML = `<span class="month-ic">${icon(d.id)}</span>`;
                const titles = el('div', '');
                titles.append(el('p', 'month-domain', d.label), el('p', 'month-title', x.q.reco.title));
                head.append(titles);
                li.append(
                  head,
                  el('p', 'month-answer', `Constat : « ${x.answer} »`),
                  el('p', 'month-text', x.q.reco.text),
                );
                const help = el('p', 'month-help');
                help.innerHTML = `<span class="mh-ic">${icon('help')}</span>`;
                help.append(el('span', '', x.q.reco.help));
                li.append(help, el('p', 'month-service', serviceByQuestion[x.q.id] ?? ''));
                return li;
              })
            : [el('li', 'month month--great', 'Aucun point faible majeur : l’accompagnement porte sur le gain de temps et la délégation.')]),
        );
        const later = r.todo.slice(3);
        $('[data-later-wrap]').hidden = !later.length;
        $('[data-later]').replaceChildren(
          ...later.map((x) => {
            const tr = document.createElement('tr');
            const d = domains.find((dd) => dd.id === x.q.domain)!;
            [x.q.reco.title, d.short, serviceByQuestion[x.q.id] ?? ''].forEach((t) => tr.append(el('td', '', t)));
            return tr;
          }),
        );

        /* ---------- Proposition ---------- */
        const rec = recommendFormula(r, input);
        document.querySelectorAll<HTMLElement>('[data-formula]').forEach((f) => f.classList.toggle('is-reco', f.dataset.formula === rec.title));
        $('[data-formula-reason]').textContent = rec.reason;

        const all = JSON.parse($('#rp-services').textContent ?? '[]') as { title: string; points: string[] }[];
        const wanted = [...new Set((top.length ? r.todo : r.items).map((x) => serviceByQuestion[x.q.id]).filter(Boolean))].slice(0, 4);
        $('[data-services]').replaceChildren(
          ...wanted.map((title) => {
            const li = el('li', 'svc');
            li.append(el('p', 'svc-title', title));
            const pts = all.find((s) => s.title === title)?.points ?? [];
            if (pts.length) li.append(el('p', 'svc-points', pts.slice(0, 4).join(' · ')));
            return li;
          }),
        );
        const gains = [
          r.cash ? `≈ ${money(r.cash)} de trésorerie à récupérer` : '',
          r.daysYear ? `jusqu’à ${r.daysYear} jours par an de temps libéré` : '',
        ].filter(Boolean);
        $('[data-gain]').textContent = gains.length ? `À mettre en regard de vos enjeux : ${gains.join(' et ')}.` : '';

        /* ---------- Zones à compléter : mémorisées sur cet appareil ---------- */
        const KEY = `sgc_rapport_${code}`;
        let saved: Record<string, string> = {};
        try {
          saved = JSON.parse(localStorage.getItem(KEY) ?? '{}');
        } catch {
          saved = {};
        }
        if (!saved.formule) saved.formule = rec.title;
        document.querySelectorAll<HTMLElement>('[data-field]').forEach((f) => {
          const k = f.dataset.field!;
          if (saved[k]) f.textContent = saved[k];
          f.addEventListener('input', () => {
            saved[k] = f.textContent?.trim() ?? '';
            if (!saved[k]) f.textContent = ''; // réaffiche l'indication quand la zone est vidée
            try {
              localStorage.setItem(KEY, JSON.stringify(saved));
            } catch {
              /* stockage indisponible : sans conséquence */
            }
          });
        });
        $('[data-reset]').addEventListener('click', () => {
          try {
            localStorage.removeItem(KEY);
          } catch {
            /* rien */
          }
          location.reload();
        });

        // Nom du fichier PDF proposé à l'enregistrement
        const client = () => saved.entreprise || saved.client;
        const baseTitle = document.title;
        window.addEventListener('beforeprint', () => {
          document.title = `Diagnostic de gestion${client() ? ` - ${client()}` : ''} - ${site.name}`;
        });
        window.addEventListener('afterprint', () => (document.title = baseTitle));
      }

      $('[data-print]').addEventListener('click', () => window.print());
    </script>

    <style is:global>
      /* ================= Écran ================= */
      .rp-body {
        background: #e9e4df;
        color: var(--text);
        font-size: 13px;
      }
      .rp-toolbar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.7rem 1.4rem;
        background: rgb(255 255 255 / 0.94);
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(10px);
      }
      .rp-tb-logo {
        width: 34px;
        height: 34px;
      }
      .rp-tb-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        font-size: 0.86rem;
        line-height: 1.35;
        color: var(--muted);
      }
      .rp-tb-text strong {
        font-size: 0.95rem;
        color: var(--blue-700);
      }
      .rp-tb-reset {
        font-size: 0.84rem;
        font-weight: 700;
        color: var(--blue-700);
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .rp-error {
        max-width: 36rem;
        margin: 4rem auto;
        padding: 1.5rem;
        border-radius: 18px;
        text-align: center;
        font-weight: 700;
        background: #fff;
      }
      .rp-error[hidden],
      .rp[hidden],
      [data-later-wrap][hidden],
      [data-strengths-wrap][hidden] {
        display: none;
      }
      .rp {
        padding: 1.6rem 0 3rem;
      }

      /* ================= Feuille A4 ================= */
      .sheet {
        position: relative;
        display: flex;
        flex-direction: column;
        width: 210mm;
        min-height: 297mm;
        margin: 0 auto 1.6rem;
        padding: 15mm 15mm 13mm;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 20px 50px -24px rgb(42 9 22 / 0.35);
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .sheet .kicker {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--terra-700);
      }
      .sheet h1,
      .sheet h2 {
        text-align: center;
        color: var(--blue-700);
      }
      .sheet h2 {
        margin-top: 4px;
        font-size: 28px;
      }
      .sheet-head {
        text-align: center;
        margin-bottom: 6mm;
      }
      .sheet-intro {
        margin-top: 4px;
        color: var(--muted);
      }
      .sheet-num {
        position: absolute;
        right: 15mm;
        bottom: 7mm;
        font-size: 10px;
        color: var(--blue-300);
      }
      .sheet-foot {
        margin-top: auto;
        padding-top: 5mm;
        font-size: 10px;
        text-align: center;
        color: var(--muted);
      }
      .block-title {
        margin-bottom: 3mm;
        font-size: 10.5px;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--blue-700);
      }

      /* Zones à compléter */
      .fill {
        display: inline-block;
        min-width: 40mm;
        padding: 1px 4px;
        border-bottom: 1.5px dashed var(--terra-400);
        border-radius: 3px;
        outline: none;
        background: rgb(246 181 91 / 0.12);
        cursor: text;
      }
      .fill:empty::before {
        content: attr(data-ph);
        color: var(--terra-600);
        font-style: italic;
        opacity: 0.8;
      }
      .fill:focus {
        background: rgb(246 181 91 / 0.25);
      }
      .fill--xl {
        min-width: 110mm;
        font-family: var(--font-display);
        font-size: 26px;
        color: var(--blue-700);
      }
      .fill--lg {
        min-width: 80mm;
        font-size: 16px;
        font-weight: 700;
      }
      .fill--area {
        display: block;
        width: 100%;
        min-height: 16mm;
        padding: 3mm;
        border: 1.5px dashed var(--terra-400);
        border-radius: 8px;
        white-space: pre-wrap;
        background-image: repeating-linear-gradient(transparent 0 7mm, var(--line) 7mm 7.2mm);
      }
      .fill--line {
        min-width: 50mm;
      }

      /* ================= 1. Couverture ================= */
      .cover {
        align-items: center;
        text-align: center;
        background:
          radial-gradient(60% 30% at 100% 0%, rgb(246 181 91 / 0.22), transparent 70%),
          radial-gradient(50% 30% at 0% 100%, rgb(97 25 58 / 0.08), transparent 70%),
          #fff;
      }
      .cover-logo {
        width: 62mm;
        margin-bottom: 12mm;
      }
      .cover h1 {
        margin-top: 3mm;
        font-size: 40px;
        line-height: 1.05;
      }
      .cover-for {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3mm;
        margin-top: 9mm;
      }
      .cover-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .cover-chips {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2mm;
        margin-top: 7mm;
      }
      .cover-chips li {
        padding: 1.5mm 4mm;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        color: var(--blue-700);
        background: var(--blue-50);
        border: 1px solid var(--blue-100);
      }
      .cover-score {
        display: flex;
        align-items: center;
        gap: 10mm;
        margin-top: 12mm;
        padding: 8mm 10mm;
        border-radius: 22px;
        text-align: left;
        background: #fff;
        border: 1px solid var(--line);
        box-shadow: 0 16px 40px -24px rgb(97 25 58 / 0.4);
      }
      .ring {
        position: relative;
        flex: none;
        width: 52mm;
        aspect-ratio: 1;
      }
      .ring svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }
      .ring-track,
      .ring-value {
        fill: none;
        stroke-width: 14;
        stroke-linecap: round;
        transform: rotate(135deg);
        transform-origin: 100px 100px;
      }
      .ring-track {
        stroke: var(--blue-100);
        stroke-dasharray: 75 100;
      }
      .ring-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }
      .ring-num {
        font-family: var(--font-display);
        font-size: 46px;
        line-height: 1;
        color: var(--blue-700);
      }
      .ring-num small {
        font-family: var(--font-body);
        font-size: 13px;
        font-weight: 700;
        color: var(--muted);
      }
      .ring-cap {
        margin-top: 2px;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .cover-level {
        width: 82mm;
      }
      .level-badge {
        display: inline-block;
        padding: 1.5mm 4mm;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
        color: #fff;
        background: var(--blue-700);
      }
      .level-badge[data-level='mid'] {
        color: var(--ink);
        background: var(--apricot);
      }
      .level-badge[data-level='low'] {
        color: var(--terra-700);
        background: var(--terra-100);
        border: 1.5px solid var(--terra-500);
      }
      .level-text {
        margin-top: 3mm;
        font-size: 12px;
        line-height: 1.5;
      }
      .mini-bars {
        display: grid;
        gap: 2mm;
        margin-top: 4mm;
      }
      .mini {
        display: grid;
        grid-template-columns: 24mm 1fr 11mm;
        align-items: center;
        gap: 2mm;
        font-size: 11px;
        font-weight: 700;
      }
      .mini-bar {
        position: relative;
        height: 2.2mm;
        border-radius: 3mm;
        overflow: hidden;
        background: var(--blue-50);
      }
      .mini-bar span {
        position: absolute;
        inset: 0 auto 0 0;
        width: var(--pct);
        border-radius: inherit;
        background: var(--blue-700);
      }
      .mini[data-level='mid'] .mini-bar span,
      .dom[data-level='mid'] .dom-bar span {
        background: var(--apricot);
      }
      .mini[data-level='low'] .mini-bar span,
      .dom[data-level='low'] .dom-bar span {
        background: var(--terra-500);
      }
      .mini-pct {
        text-align: right;
        color: var(--blue-700);
      }
      .cover-foot {
        display: flex;
        align-items: center;
        gap: 5mm;
        margin-top: auto;
        padding-top: 6mm;
        border-top: 1px solid var(--line);
        width: 100%;
        text-align: left;
        font-size: 10.5px;
        color: var(--muted);
      }
      .cover-photo {
        width: 16mm;
        height: 16mm;
        border-radius: 50%;
        object-fit: cover;
        object-position: 51% 28%;
        border: 2px solid var(--apricot);
      }
      .cover-by {
        font-size: 12px;
        color: var(--text);
      }
      .cover-by strong {
        color: var(--blue-700);
      }

      /* ================= 2. Synthèse ================= */
      .doms {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4mm;
      }
      .dom {
        display: flex;
        gap: 3mm;
        padding: 4mm;
        border-radius: 14px;
        border: 1px solid var(--line);
        background: var(--cream);
      }
      .dom-ic {
        flex: none;
        display: grid;
        place-items: center;
        width: 9mm;
        height: 9mm;
        border-radius: 8px;
        color: #fff;
        background: var(--blue-700);
      }
      .dom-body {
        flex: 1;
        min-width: 0;
      }
      .dom-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5mm 2mm;
      }
      .dom-title {
        font-family: var(--font-display);
        font-size: 15px;
        color: var(--blue-700);
      }
      .dom-badge {
        padding: 0.5mm 2mm;
        border-radius: 999px;
        font-size: 8.5px;
        font-weight: 800;
        text-transform: uppercase;
        color: #fff;
        background: var(--blue-700);
      }
      .dom[data-level='mid'] .dom-badge {
        color: var(--ink);
        background: var(--apricot);
      }
      .dom[data-level='low'] .dom-badge {
        color: var(--terra-700);
        background: var(--terra-100);
      }
      .dom-pct {
        margin-left: auto;
        font-family: var(--font-display);
        font-size: 16px;
        color: var(--blue-700);
      }
      .dom-bar {
        position: relative;
        display: block;
        height: 2.2mm;
        margin-top: 2mm;
        border-radius: 3mm;
        overflow: hidden;
        background: var(--blue-100);
      }
      .dom-bar span {
        position: absolute;
        inset: 0 auto 0 0;
        width: var(--pct);
        border-radius: inherit;
        background: var(--blue-700);
      }
      .dom-text {
        margin-top: 2mm;
        font-size: 11px;
        line-height: 1.45;
        color: var(--muted);
      }
      .stakes {
        margin-top: 7mm;
        padding: 6mm;
        border-radius: 18px;
        text-align: center;
        color: #fff;
        background: linear-gradient(135deg, var(--blue-700), var(--blue-950));
      }
      .stakes-kicker {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--apricot);
      }
      .stakes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
        gap: 4mm;
        margin-top: 4mm;
      }
      .stake {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 4mm;
        border-radius: 14px;
        background: rgb(255 255 255 / 0.08);
        border: 1px solid rgb(255 255 255 / 0.15);
      }
      .stake-ic {
        display: grid;
        place-items: center;
        width: 10mm;
        height: 10mm;
        border-radius: 10px;
        color: var(--ink);
        background: var(--apricot);
      }
      .stake-num {
        margin-top: 2mm;
        font-family: var(--font-display);
        font-size: 30px;
        line-height: 1.1;
      }
      .stake-label {
        font-weight: 700;
      }
      .stake-sub {
        margin-top: 1mm;
        font-size: 10.5px;
        color: rgb(255 255 255 / 0.82);
      }
      .stakes-note {
        margin-top: 3mm;
        font-size: 8.5px;
        line-height: 1.45;
        color: rgb(255 255 255 / 0.65);
      }
      .strengths {
        margin-top: 7mm;
        text-align: center;
      }
      .strengths ul {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2mm;
      }
      .strengths li {
        display: inline-flex;
        align-items: center;
        gap: 1.5mm;
        padding: 1.2mm 3.5mm 1.2mm 1.2mm;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        color: var(--blue-700);
        border: 1px solid var(--line);
      }
      .sf-ic {
        display: grid;
        place-items: center;
        width: 5mm;
        height: 5mm;
        border-radius: 50%;
        color: #fff;
        background: var(--blue-700);
      }

      /* ================= 3. Plan sur 90 jours ================= */
      .months {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 4mm;
      }
      .month {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 4mm;
        border-radius: 14px;
        background: var(--cream);
        border: 1px solid var(--line);
      }
      .month--great {
        grid-column: 1 / -1;
        text-align: center;
        font-weight: 700;
      }
      .month-num {
        align-self: flex-start;
        margin-bottom: 3mm;
        padding: 0.8mm 3mm;
        border-radius: 999px;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #fff;
        background: var(--blue-700);
      }
      .month-head {
        display: flex;
        align-items: center;
        gap: 2mm;
      }
      .month-ic {
        flex: none;
        display: grid;
        place-items: center;
        width: 8.5mm;
        height: 8.5mm;
        border-radius: 8px;
        color: var(--blue-700);
        background: #fff;
        border: 1px solid var(--blue-100);
      }
      .month[data-level='low'] .month-ic {
        color: #fff;
        background: var(--terra-500);
        border-color: var(--terra-500);
      }
      .month-domain {
        font-size: 8.5px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--terra-700);
      }
      .month-title {
        font-family: var(--font-display);
        font-size: 14px;
        line-height: 1.2;
        color: var(--blue-700);
      }
      .month-answer {
        margin-top: 3mm;
        font-size: 10px;
        font-style: italic;
        color: var(--muted);
      }
      .month-text {
        margin-top: 2mm;
        font-size: 10px;
        line-height: 1.5;
      }
      .month-help {
        display: flex;
        gap: 1.5mm;
        margin-top: auto;
        padding-top: 3mm;
        font-size: 10.5px;
        font-weight: 700;
        color: var(--blue-700);
      }
      .mh-ic {
        flex: none;
        display: grid;
        place-items: center;
        width: 5.5mm;
        height: 5.5mm;
        border-radius: 50%;
        color: var(--ink);
        background: var(--apricot);
      }
      .month-service {
        margin-top: 2mm;
        padding-top: 2mm;
        border-top: 1px dashed var(--line);
        font-size: 9.5px;
        font-weight: 800;
        color: var(--terra-700);
      }
      .month-service::before {
        content: 'Prestation : ';
        font-weight: 600;
        color: var(--muted);
      }
      .later {
        margin-top: 5mm;
      }
      .later-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
      }
      .later-table th {
        padding: 2mm;
        text-align: left;
        font-size: 9.5px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #fff;
        background: var(--blue-700);
      }
      .later-table th:first-child {
        border-radius: 8px 0 0 0;
      }
      .later-table th:last-child {
        border-radius: 0 8px 0 0;
      }
      .later-table td {
        padding: 1.3mm 2mm;
        border-bottom: 1px solid var(--line);
      }
      .later-table td:first-child {
        font-weight: 700;
        color: var(--blue-700);
      }
      .notes {
        flex: 1;
        display: flex;
        flex-direction: column;
        margin-top: 5mm;
        margin-bottom: 4mm;
      }
      .notes .fill--area {
        flex: 1;
      }

      /* ================= 4. Proposition ================= */
      .formulas {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 3mm;
      }
      .formula {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 5mm 3mm 3.5mm;
        border-radius: 14px;
        text-align: center;
        border: 1px solid var(--line);
        background: var(--cream);
        opacity: 0.75;
      }
      .formula.is-reco {
        opacity: 1;
        color: #fff;
        background: linear-gradient(140deg, var(--blue-700), var(--blue-950));
        border-color: var(--blue-700);
        box-shadow: 0 14px 30px -18px rgb(97 25 58 / 0.8);
      }
      .formula-badge {
        position: absolute;
        top: -3mm;
        display: none;
        padding: 0.8mm 3mm;
        border-radius: 999px;
        font-size: 9px;
        font-weight: 800;
        color: var(--ink);
        background: var(--apricot);
      }
      .formula.is-reco .formula-badge {
        display: block;
      }
      .formula-ic {
        display: grid;
        place-items: center;
        width: 10mm;
        height: 10mm;
        border-radius: 10px;
        color: var(--blue-700);
        background: #fff;
      }
      .formula-title {
        margin-top: 2mm;
        font-family: var(--font-display);
        font-size: 16px;
        color: var(--blue-700);
      }
      .formula.is-reco .formula-title {
        color: #fff;
      }
      .formula-for {
        font-size: 10px;
        font-weight: 700;
        color: var(--terra-700);
      }
      .formula.is-reco .formula-for {
        color: var(--apricot);
      }
      .formula-text {
        margin-top: 2mm;
        font-size: 10px;
        line-height: 1.45;
      }
      .formula-reason {
        max-width: 150mm;
        margin: 4mm auto 0;
        text-align: center;
        font-size: 11.5px;
        font-style: italic;
        line-height: 1.5;
        color: var(--blue-700);
      }
      .offer {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5mm;
        margin-top: 5mm;
      }
      .offer-services,
      .offer-price {
        padding: 5mm;
        border-radius: 14px;
        border: 1px solid var(--line);
      }
      .offer-price {
        background: var(--rose-100);
        border-color: var(--rose-200);
      }
      .svc + .svc {
        margin-top: 3mm;
      }
      .svc-title {
        font-weight: 800;
        color: var(--blue-700);
      }
      .svc-title::before {
        content: '✓ ';
        color: var(--terra-500);
      }
      .svc-points {
        margin-top: 0.5mm;
        font-size: 10px;
        color: var(--muted);
      }
      .price-list {
        display: grid;
        gap: 2.5mm;
      }
      .price-list div {
        display: grid;
        grid-template-columns: 22mm 1fr;
        align-items: baseline;
      }
      .price-list dt {
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--muted);
      }
      .price-list dd {
        min-width: 0;
        font-weight: 700;
        color: var(--blue-700);
      }
      .price-gain {
        margin-top: 4mm;
        font-size: 10.5px;
        font-weight: 700;
        line-height: 1.45;
        color: var(--terra-700);
      }
      .next-steps {
        margin-top: 5mm;
      }
      .next-steps ol {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 3mm;
      }
      .next-steps li {
        display: flex;
        align-items: center;
        gap: 2mm;
        padding: 3mm;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 700;
        background: var(--cream);
        border: 1px solid var(--line);
      }
      .next-steps li span {
        flex: none;
        display: grid;
        place-items: center;
        width: 6mm;
        height: 6mm;
        border-radius: 50%;
        font-size: 10px;
        color: #fff;
        background: var(--blue-700);
      }
      .agree {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5mm;
        margin-top: 5mm;
        padding: 5mm;
        border-radius: 14px;
        border: 1.5px solid var(--blue-700);
      }
      .agree-text p:last-child {
        font-size: 10.5px;
        line-height: 1.5;
        color: var(--muted);
      }
      .agree-sign {
        font-size: 11px;
        font-weight: 700;
      }
      .agree-sign p + p {
        margin-top: 2mm;
      }
      .sign-box {
        height: 15mm;
        margin-top: 1.5mm;
        border-radius: 8px;
        border: 1px dashed var(--blue-300);
      }

      /* ================= Impression ================= */
      @page {
        size: A4;
        margin: 0;
      }
      @media print {
        .rp-body {
          background: #fff;
        }
        .rp-toolbar {
          display: none;
        }
        .rp {
          padding: 0;
        }
        .sheet {
          margin: 0;
          box-shadow: none;
          break-after: page;
        }
        .sheet:last-child {
          break-after: auto;
        }
        /* Zones vides : simple ligne à compléter à la main */
        .fill {
          background: none;
        }
        .fill:empty::before {
          content: '\00a0';
        }
        .fill--area {
          border-style: solid;
          border-color: var(--line);
        }
      }

      /* Petits écrans : la feuille A4 est réduite pour rester lisible */
      @media (max-width: 820px) {
        .rp-toolbar {
          flex-wrap: wrap;
        }
        .rp-tb-text span {
          display: none;
        }
        .sheet {
          zoom: 0.45;
        }
      }
    </style>
  </body>
</html>
